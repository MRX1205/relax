.order-list { display: grid; gap: 16rpx; }
.order-card { padding: 24rpx; }
.order-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.order-no { font-size: 24rpx; color: var(--color-text-secondary); }
.order-status { font-size: 24rpx; font-weight: 600; }
.order-status--PENDING_PAYMENT { color: var(--color-warning); }
.order-status--PAID, .order-status--ACCEPTED { color: var(--color-success); }
.order-status--CANCELLED, .order-status--EXPIRED { color: var(--color-muted); }
.order-date { font-size: 28rpx; font-weight: 600; }
.order-footer { display: flex; justify-content: space-between; margin-top: 8rpx; }
.order-time { font-size: 22rpx; color: var(--color-muted); }
.order-note { font-size: 22rpx; color: var(--color-text-secondary); }
.empty-wrap { padding-top: 80rpx; }
.overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 100; display: flex; justify-content: flex-end; }
.detail-panel { width: 85%; height: 100%; background: var(--color-surface); display: flex; flex-direction: column; }
.detail-header { display: flex; justify-content: space-between; align-items: center; padding: 24rpx; border-bottom: 1rpx solid var(--color-border); }
.detail-title { font-size: 30rpx; font-weight: 700; }
.detail-close { font-size: 36rpx; color: var(--color-muted); padding: 8rpx; }
.detail-body { flex: 1; padding: 24rpx; }
.detail-status { font-size: 32rpx; font-weight: 700; margin-bottom: 24rpx; }
.status-PENDING_PAYMENT { color: var(--color-warning); }
.status-PAID, .status-ACCEPTED { color: var(--color-success); }
.detail-section { margin-bottom: 24rpx; padding-bottom: 16rpx; border-bottom: 1rpx solid var(--color-border); }
.detail-row { display: flex; justify-content: space-between; padding: 8rpx 0; font-size: 26rpx; }
.detail-label { font-size: 26rpx; color: var(--color-text-secondary); margin-bottom: 8rpx; }
.note-input { width: 100%; height: 120rpx; font-size: 26rpx; padding: 12rpx; border: 1rpx solid var(--color-border); border-radius: var(--radius-sm); box-sizing: border-box; }
.note-save { margin-top: 12rpx; padding: 12rpx; background: var(--color-primary); color: #FFFFFF; border-radius: var(--radius-sm); text-align: center; font-size: 26rpx; font-weight: 600; }
.cancel-btn { padding: 16rpx; background: #FFF5F5; color: var(--color-danger); border: 1rpx solid #FFCDD2; border-radius: var(--radius-sm); text-align: center; font-size: 26rpx; font-weight: 600; }
.reassign-btn { padding: 16rpx; background: #E3F2FD; color: #1565C0; border: 1rpx solid #90CAF9; border-radius: var(--radius-sm); text-align: center; font-size: 26rpx; font-weight: 600; margin-bottom: 16rpx; }
