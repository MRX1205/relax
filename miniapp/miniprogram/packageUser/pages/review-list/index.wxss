.review-page {
  min-height: 100vh;
  background: #F6F7F9;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
}

/* 顶部评分卡片 */
.score-hero-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.score-main-col {
  display: flex;
  flex-direction: column;
}

.score-large-wrap {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.score-large-num {
  font-size: 54rpx;
  font-weight: 900;
  color: #1C1C1E;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display";
}

.score-total {
  font-size: 24rpx;
  color: #8E8E93;
  font-weight: 600;
}

.score-stars-row {
  display: flex;
  gap: 4rpx;
  margin: 6rpx 0 8rpx;
}

.hero-star {
  font-size: 28rpx;
  color: #FF9500;
}

.score-subtitle {
  font-size: 20rpx;
  color: #8E8E93;
}

.score-stat-right {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  border-left: 1rpx solid #EFEFEF;
  padding-left: 32rpx;
}

.stat-pill-item {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.stat-pill-val {
  font-size: 32rpx;
  font-weight: 800;
  color: #FF382E;
}

.stat-pill-lbl {
  font-size: 20rpx;
  color: #8E8E93;
}

/* 技师作用域条 */
.tech-scope-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(0, 122, 255, 0.08);
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.scope-tag {
  font-size: 20rpx;
  font-weight: 700;
  color: #007AFF;
  background: #FFFFFF;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.scope-name {
  font-size: 24rpx;
  font-weight: 800;
  color: #1C1C1E;
}

.scope-desc {
  font-size: 22rpx;
  color: #8E8E93;
}

/* 评价卡片列表 */
.review-items-wrap {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.review-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}

.review-card-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.user-avatar-circle {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #F0F0F2;
  color: #636366;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.user-meta-col {
  flex: 1;
}

.user-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.user-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #1C1C1E;
}

.verified-tag {
  font-size: 18rpx;
  color: #34C759;
  background: rgba(52, 199, 89, 0.1);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-weight: 600;
}

.review-stars-row {
  display: flex;
  gap: 2rpx;
}

.star-symbol {
  font-size: 22rpx;
}

.star-gold { color: #FF9500; }
.star-muted { color: #D1D1D6; }

.review-date {
  font-size: 20rpx;
  color: #8E8E93;
  align-self: flex-start;
}

.review-content {
  padding-left: 88rpx;
}

.content-text {
  font-size: 26rpx;
  color: #3A3A3C;
  line-height: 1.6;
}

/* 加载与空状态 */
.loading-state,
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  text-align: center;
}

.loading-text {
  font-size: 26rpx;
  color: #8E8E93;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1C1C1E;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #8E8E93;
}
