.menu-list {
  margin-top: 32rpx;
  display: grid;
  gap: 20rpx;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  gap: 24rpx;
}
.menu-icon {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.menu-icon--categories {
  background: #FFF1ED;
  color: var(--color-primary);
}
.menu-icon--projects {
  background: #EDF8F3;
  color: var(--color-accent);
}
.menu-icon--technicians {
  background: #EEF2F6;
  color: #334E68;
}
.menu-content {
  flex: 1;
  min-width: 0;
}
.menu-name {
  font-size: 30rpx;
  font-weight: 600;
}
.menu-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}
.menu-arrow {
  color: var(--color-muted);
  font-size: 40rpx;
  line-height: 1;
}
