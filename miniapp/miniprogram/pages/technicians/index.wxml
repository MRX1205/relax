<view class="page">
  <!-- Sort bar -->
  <view class="sort-bar">
    <view
      wx:for="{{sortOptions}}"
      wx:key="key"
      class="sort-item {{sortBy === item.key ? 'sort-item--active' : ''}}"
      data-sort="{{item.key}}"
      bindtap="switchSort"
    >{{item.text}}</view>
  </view>

  <ui-state wx:if="{{loading}}" title="加载中" kind="loading" />

  <block wx:elif="{{technicians.length === 0}}">
    <view class="empty-state">
      <view class="empty-state__icon">👤</view>
      <view class="empty-state__title">暂无可约技师</view>
    </view>
  </block>

  <block wx:else>
    <view class="tech-list">
      <view
        wx:for="{{technicians}}"
        wx:key="id"
        class="tech-card surface"
        data-id="{{item.id}}"
        bindtap="goToDetail"
      >
        <view class="tech-card__avatar">
          <image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill" class="tech-card__img" />
          <view wx:else class="tech-card__placeholder">{{item.serviceName[0]}}</view>
          <view wx:if="{{item.onlineStatus === 'ONLINE'}}" class="tech-card__online"></view>
        </view>
        <view class="tech-card__info">
          <view class="tech-card__name">{{item.serviceName}}</view>
          <view class="tech-card__intro">{{item.intro}}</view>
          <view class="tech-card__meta">
            <text class="tech-card__exp">{{item.experienceYears}}年经验</text>
            <view class="tech-card__price" wx:if="{{item.startPrice}}">
              <text>¥{{item.startPrice}}起</text>
            </view>
          </view>
        </view>
        <view class="tech-card__status {{item.onlineStatus === 'ONLINE' ? 'tech-card__status--online' : 'tech-card__status--offline'}}">
          {{item.onlineStatus === 'ONLINE' ? '可约' : '休息'}}
        </view>
      </view>
    </view>
  </block>
</view>

<custom-tabbar />
