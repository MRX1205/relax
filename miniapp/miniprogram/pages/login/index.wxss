.login-page {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  position: relative;
  overflow: hidden;
}

/* 背景装饰 */
.login-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
}

.bg-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.bg-circle--1 {
  width: 400rpx;
  height: 400rpx;
  top: -100rpx;
  right: -100rpx;
}

.bg-circle--2 {
  width: 300rpx;
  height: 300rpx;
  bottom: 200rpx;
  left: -80rpx;
}

.bg-circle--3 {
  width: 200rpx;
  height: 200rpx;
  top: 40%;
  right: 10%;
}

/* 主要内容 */
.login-content {
  position: relative;
  z-index: 1;
  padding: 0 48rpx;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

/* Logo区域 */
.login-hero {
  text-align: center;
  margin-bottom: 80rpx;
}

.logo-wrapper {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 32rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(20px);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

.logo-icon {
  font-size: 80rpx;
}

.login-title {
  font-size: 56rpx;
  font-weight: 800;
  color: #FFFFFF;
  margin-bottom: 16rpx;
  text-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.2);
}

.login-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  letter-spacing: 4rpx;
}

/* 登录卡片 */
.login-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
}

/* 错误提示 */
.error-toast {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  background: #FFF5F5;
  border: 2rpx solid #FFCDD2;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
}

.error-icon {
  font-size: 28rpx;
}

.error-text {
  font-size: 24rpx;
  color: #E74C3C;
}

/* 特性列表 */
.features-list {
  display: flex;
  justify-content: space-around;
  margin-bottom: 48rpx;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #F0F0F0;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.feature-icon {
  font-size: 36rpx;
}

.feature-text {
  font-size: 22rpx;
  color: #636E72;
  font-weight: 500;
}

/* 登录按钮 */
.login-btn {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #07C160, #06AD56);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 50rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.4);
  transition: all 0.3s ease;
}

.login-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
}

.login-btn--loading {
  background: linear-gradient(135deg, #95D5B2, #74C69D);
  box-shadow: 0 4rpx 12rpx rgba(116, 198, 157, 0.3);
}

.btn-content {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.wechat-icon {
  width: 40rpx;
  height: 40rpx;
}

.btn-loading {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #FFFFFF;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 登录提示 */
.login-hint {
  margin-top: 32rpx;
  text-align: center;
  font-size: 22rpx;
  color: #B2BEC3;
  line-height: 1.8;
}

.link {
  display: inline;
  color: #667eea;
  font-weight: 500;
}
