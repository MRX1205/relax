<view class="page">
  <ui-state wx:if="{{loading}}" title="加载中" kind="loading" />
  <block wx:else>
    <view wx:if="{{orders.length === 0}}" class="empty-wrap">
      <ui-state title="暂无订单" description="等待用户下单" />
    </view>
    <view class="order-list">
      <view wx:for="{{orders}}" wx:key="orderNo" class="surface order-card" data-no="{{item.orderNo}}" bindtap="handleTap">
        <view class="order-header">
          <text class="order-no">{{item.orderNo}}</text>
          <text class="order-status order-status--{{item.status}}">{{statusLabel(item.status)}}</text>
        </view>
        <view class="order-date">{{item.serviceDate}} {{item.startTime}}-{{item.endTime}}</view>
        <view class="order-footer">
          <text class="order-time">{{item.createdAt}}</text>
          <text class="order-link">查看详情 ›</text>
        </view>
      </view>
    </view>
  </block>
</view>
