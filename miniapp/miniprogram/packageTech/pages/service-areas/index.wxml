<view class="page">
  <view class="page-title">东莞服务区域</view>
  <view class="page-subtitle">以下为平台当前已开通的上门服务区域。</view>

  <ui-state wx:if="{{loading}}" title="加载中" kind="loading" />

  <view wx:else class="area-list">
    <view wx:for="{{areas}}" wx:key="id" class="surface area-item">
      <view class="area-name">{{item.name}}</view>
      <view class="area-status area-status--{{item.status}}">{{item.status === 'ENABLED' ? '已开通' : '暂停'}}</view>
    </view>
  </view>
</view>
