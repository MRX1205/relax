<view class="page">
  <view class="summary surface">
    <view class="summary-label">待结算收入</view>
    <view class="summary-amount">¥{{totalPending}}</view>
  </view>

  <view class="tabs">
    <view class="tab {{tab === 'income' ? 'tab--active' : ''}}" data-tab="income" bindtap="switchTab">收入明细</view>
    <view class="tab {{tab === 'settlements' ? 'tab--active' : ''}}" data-tab="settlements" bindtap="switchTab">结算记录</view>
  </view>

  <ui-state wx:if="{{loading}}" title="加载中" kind="loading" />

  <block wx:elif="{{tab === 'income'}}">
    <view wx:if="{{incomes.length === 0}}" class="empty-tip">暂无收入</view>
    <view class="list">
      <view wx:for="{{incomes}}" wx:key="id" class="surface item">
        <view class="item-header">
          <text class="item-amount">¥{{item.payableAmount}}</text>
          <text class="item-status item-status--{{item.status}}">{{statusLabel(item.status)}}</text>
        </view>
        <view class="item-meta">项目收入 ¥{{item.grossAmount}} · 平台费 ¥{{item.platformFee}}</view>
        <view class="item-time">{{item.createdAt}}</view>
      </view>
    </view>
  </block>

  <block wx:elif="{{tab === 'settlements'}}">
    <view wx:if="{{settlements.length === 0}}" class="empty-tip">暂无结算记录</view>
    <view class="list">
      <view wx:for="{{settlements}}" wx:key="id" class="surface item">
        <view class="item-header">
          <text class="item-amount">¥{{item.totalAmount}}</text>
          <text class="item-status item-status--{{item.status}}">{{statusLabel(item.status)}}</text>
        </view>
        <view class="item-meta">{{item.settlementNo}}</view>
        <view wx:if="{{item.referenceNo}}" class="item-meta">凭证号：{{item.referenceNo}}</view>
        <view class="item-time">{{item.createdAt}}</view>
      </view>
    </view>
  </block>
</view>
