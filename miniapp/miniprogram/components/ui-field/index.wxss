.field__label {
  margin-bottom: 12rpx;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 600;
}

.field__required,
.field__error {
  color: var(--color-danger);
}

.field__required {
  margin-right: 4rpx;
}

.field__input {
  min-height: 88rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
}

.field__input--error {
  border-color: var(--color-danger);
}

.field__error {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

