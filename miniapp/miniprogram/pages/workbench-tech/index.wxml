<view class="page">
  <!-- Profile header -->
  <view class="tech-header">
    <view class="tech-header__info">
      <view class="tech-header__name">{{profile.serviceName || account.nickname}}</view>
      <view class="tech-header__meta" wx:if="{{profile}}">{{profile.realName}} · {{profile.phone}}</view>
    </view>
    <view
      class="online-btn {{profile.onlineStatus === 'ONLINE' ? 'online-btn--on' : 'online-btn--off'}}"
      bindtap="toggleOnline"
      wx:if="{{profile}}"
    >
      {{profile.onlineStatus === 'ONLINE' ? '● 在线' : '○ 离线'}}
    </view>
  </view>

  <ui-state wx:if="{{loading}}" title="加载中" kind="loading" />

  <!-- Not a technician yet -->
  <block wx:elif="{{!profile && !hasApplication}}">
    <view class="empty-state">
      <view class="empty-state__icon">🔧</view>
      <view class="empty-state__title">成为技师</view>
      <view class="empty-state__desc">提交入驻申请，审核通过后即可开始接单赚钱</view>
      <view class="apply-btn" bindtap="goToAccess">申请入驻</view>
    </view>
  </block>

  <!-- Application pending -->
  <block wx:elif="{{hasApplication && !profile}}">
    <view class="empty-state">
      <view class="empty-state__icon">⏳</view>
      <view class="empty-state__title">入驻申请{{applicationStatus === 'PENDING' ? '审核中' : applicationStatus === 'APPROVED' ? '已通过' : '已拒绝'}}</view>
      <view class="empty-state__desc" wx:if="{{applicationStatus === 'PENDING'}}">请耐心等待管理员审核</view>
      <view class="apply-btn" wx:if="{{applicationStatus === 'REJECTED'}}" bindtap="goToAccess">重新申请</view>
    </view>
  </block>

  <!-- Main workbench -->
  <block wx:elif="{{profile}}">
    <!-- Stats cards -->
    <view class="stats-row">
      <view class="stat-card">
        <view class="stat-card__num">{{stats.pendingCount}}</view>
        <view class="stat-card__label">待处理</view>
      </view>
      <view class="stat-card">
        <view class="stat-card__num">{{stats.todayOrders}}</view>
        <view class="stat-card__label">今日订单</view>
      </view>
      <view class="stat-card">
        <view class="stat-card__num">{{stats.todayIncome}}</view>
        <view class="stat-card__label">今日收入</view>
      </view>
    </view>

    <!-- Quick actions -->
    <view class="section-title">快捷操作</view>
    <view class="action-grid">
      <view class="action-item" bindtap="goToOrders">
        <view class="action-item__icon">📋</view>
        <view class="action-item__text">我的订单</view>
      </view>
      <view class="action-item" bindtap="goToSchedules">
        <view class="action-item__icon">📅</view>
        <view class="action-item__text">排班管理</view>
      </view>
      <view class="action-item" bindtap="goToIncome">
        <view class="action-item__icon">💰</view>
        <view class="action-item__text">收入明细</view>
      </view>
    </view>

    <!-- Pending orders -->
    <view class="section-title" wx:if="{{pendingOrders.length > 0}}">待处理订单</view>
    <view class="order-list" wx:if="{{pendingOrders.length > 0}}">
      <view
        wx:for="{{pendingOrders}}"
        wx:key="id"
        class="order-card surface"
        data-id="{{item.id}}"
        bindtap="goToOrderDetail"
      >
        <view class="order-card__header">
          <text class="order-card__no">{{item.orderNo}}</text>
          <text class="order-card__status order-card__status--{{item.status}}">{{item.status === 'PAID' ? '待确认' : '待服务'}}</text>
        </view>
        <view class="order-card__body">
          <text class="order-card__project">{{item.projectName}}</text>
          <text class="order-card__time">{{item.serviceDate}} {{item.startTime}}-{{item.endTime}}</text>
        </view>
      </view>
    </view>

    <!-- Today orders -->
    <view class="section-title" wx:if="{{todayOrders.length > 0}}">今日订单</view>
    <view class="order-list" wx:if="{{todayOrders.length > 0}}">
      <view
        wx:for="{{todayOrders}}"
        wx:key="id"
        class="order-card surface"
        data-id="{{item.id}}"
        bindtap="goToOrderDetail"
      >
        <view class="order-card__header">
          <text class="order-card__no">{{item.orderNo}}</text>
          <text class="order-card__status order-card__status--{{item.status}}">{{item.status}}</text>
        </view>
        <view class="order-card__body">
          <text class="order-card__project">{{item.projectName}}</text>
          <text class="order-card__time">{{item.startTime}}-{{item.endTime}}</text>
        </view>
      </view>
    </view>

    <view class="empty-today" wx:if="{{pendingOrders.length === 0 && todayOrders.length === 0}}">
      <view class="empty-today__text">今日暂无订单</view>
    </view>
  </block>
</view>

<custom-tabbar />
