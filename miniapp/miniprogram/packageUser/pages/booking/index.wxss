/* ==========================================================================
   Booking Page — Apple HIG Modern Luxury Aesthetics
   ========================================================================== */

.booking-page {
  min-height: 100vh;
  background: #F5F5F7;
  padding: 24rpx 28rpx 160rpx;
  box-sizing: border-box;
}

/* ── 通用卡片头部 ── */
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.card-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1C1C1E;
  letter-spacing: -0.4rpx;
}

.icon-bubble {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-bubble--blue { background: rgba(0, 122, 255, 0.1); }
.icon-bubble--coral { background: rgba(255, 56, 46, 0.1); }
.icon-bubble--green { background: rgba(52, 199, 89, 0.1); }
.icon-bubble--amber { background: rgba(255, 149, 0, 0.12); }

.hairline-divider {
  height: 1rpx;
  background: rgba(0, 0, 0, 0.05);
  margin: 20rpx 0;
}

.chevron-cell {
  display: flex;
  align-items: center;
  margin-left: 12rpx;
}

/* ── 1. 服务地址卡片 ── */
.address-card {
  display: flex;
  align-items: center;
  padding: 28rpx;
}

.address-main {
  flex: 1;
  margin-left: 20rpx;
}

.address-tag-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.address-title {
  font-size: 24rpx;
  color: #8E8E93;
  font-weight: 500;
}

.address-badge {
  font-size: 20rpx;
  color: #007AFF;
  background: rgba(0, 122, 255, 0.1);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-weight: 600;
}

.address-detail {
  font-size: 28rpx;
  line-height: 1.45;
  white-space: pre-wrap;
}

.address-detail--selected {
  color: #1C1C1E;
  font-weight: 600;
}

.address-detail--placeholder {
  color: #FF382E;
  font-weight: 600;
}

/* ── 2. 服务项目卡片 ── */
.project-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.project-info-col {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.project-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1C1C1E;
  letter-spacing: -0.4rpx;
}

.project-meta-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #8E8E93;
}

/* Apple Stepper */
.quantity-stepper {
  display: flex;
  align-items: center;
  background: #F2F2F7;
  border-radius: 40rpx;
  padding: 4rpx;
}

.stepper-btn {
  width: 60rpx;
  height: 60rpx;
  background: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #1C1C1E;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.stepper-btn--disabled {
  color: #C7C7CC;
  box-shadow: none;
  background: transparent;
}

.stepper-val {
  padding: 0 24rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #1C1C1E;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display";
}

/* 技师信息行 */
.tech-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tech-info-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.tech-avatar-mini {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #F2F2F7;
  flex-shrink: 0;
}

.tech-avatar-img {
  width: 100%;
  height: 100%;
}

.tech-avatar-ph {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #007AFF 0%, #5856D6 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tech-names {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.tech-label {
  font-size: 20rpx;
  color: #8E8E93;
}

.tech-val {
  font-size: 26rpx;
  font-weight: 700;
  color: #1C1C1E;
}

.tech-badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #34C759;
  background: rgba(52, 199, 89, 0.12);
  padding: 6rpx 16rpx;
  border-radius: 30rpx;
  font-weight: 600;
}

/* ── 3. 服务时间选择 ── */
.selected-time-tag {
  font-size: 24rpx;
  color: #FF382E;
  font-weight: 600;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display";
}

.date-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.date-list {
  display: inline-flex;
  gap: 14rpx;
  padding: 4rpx 0;
}

.date-pill-btn {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 116rpx;
  height: 124rpx;
  background: #F2F2F7;
  border-radius: 24rpx;
  flex-shrink: 0;
  border: 1rpx solid transparent;
  transition: all 0.2s cubic-bezier(0.25, 0.1, 0.25, 1);
}

.date-weekday {
  font-size: 22rpx;
  color: #8E8E93;
  margin-bottom: 6rpx;
}

.date-day {
  font-size: 26rpx;
  font-weight: 700;
  color: #1C1C1E;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display";
}

.date-pill-btn--active {
  background: #1C1C1E;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.18);
}

.date-pill-btn--active .date-weekday,
.date-pill-btn--active .date-day {
  color: #FFFFFF;
}

/* 时间段网格 */
.slots-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
  gap: 12rpx;
}

.loading-spinner-sm {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #FF382E;
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-txt {
  font-size: 24rpx;
  color: #8E8E93;
}

.slots-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.slot-item {
  height: 76rpx;
  background: #F9F9FB;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

.slot-time {
  font-size: 26rpx;
  font-weight: 600;
  color: #1C1C1E;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display";
}

.slot-item--selected {
  background: #FFF1EE;
  border-color: #FF382E;
}

.slot-item--selected .slot-time {
  color: #FF382E;
  font-weight: 800;
}

.slot-item--disabled {
  background: #F2F2F7;
  opacity: 0.45;
}

.slot-item--disabled .slot-time {
  color: #8E8E93;
}

.slot-status {
  position: absolute;
  top: 4rpx;
  right: 8rpx;
  font-size: 16rpx;
  color: #8E8E93;
}

.slot-status--selected {
  color: #FF382E;
  font-weight: 800;
}

.slot-status--free {
  color: #34C759;
}

/* ── 4. 出行方式 ── */
.travel-modes {
  display: flex;
  gap: 16rpx;
}

.travel-mode-btn {
  flex: 1;
  display: flex;
  align-items: center;
  background: #F9F9FB;
  border-radius: 24rpx;
  padding: 24rpx 20rpx;
  border: 1.5rpx solid transparent;
  gap: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.travel-mode-btn--active {
  background: #FFF1EE;
  border-color: rgba(255, 56, 46, 0.35);
  box-shadow: 0 4rpx 14rpx rgba(255, 56, 46, 0.12);
}

.travel-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
}

.travel-text-col {
  display: flex;
  flex-direction: column;
}

.travel-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1C1C1E;
}

.travel-mode-btn--active .travel-title {
  color: #FF382E;
}

.travel-desc {
  font-size: 20rpx;
  color: #8E8E93;
  margin-top: 4rpx;
}

/* ── 5. 选项组卡片 ── */
.cell-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
}

.cell-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1C1E;
}

.cell-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.coupon-val {
  font-size: 26rpx;
  color: #8E8E93;
}

.coupon-val--active {
  color: #FF382E;
  font-weight: 600;
}

.note-cell {
  align-items: center;
}

.note-input {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: #1C1C1E;
  padding-left: 20rpx;
}

.privacy-cell {
  align-items: center;
}

.privacy-label-col {
  display: flex;
  flex-direction: column;
  flex: 1;
  padding-right: 20rpx;
}

.privacy-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.privacy-tag {
  font-size: 20rpx;
  color: #34C759;
  background: rgba(52, 199, 89, 0.12);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-weight: 600;
}

.privacy-hint {
  font-size: 22rpx;
  color: #8E8E93;
  margin-top: 6rpx;
}

/* Apple Switch Toggle */
.ios-switch {
  width: 90rpx;
  height: 52rpx;
  background: #E5E5EA;
  border-radius: 30rpx;
  position: relative;
  transition: all 0.25s cubic-bezier(0.25, 0.1, 0.25, 1);
  flex-shrink: 0;
}

.ios-switch-knob {
  width: 44rpx;
  height: 44rpx;
  background: #FFFFFF;
  border-radius: 50%;
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.18);
  transition: all 0.25s cubic-bezier(0.25, 0.1, 0.25, 1);
}

.ios-switch--on {
  background: #34C759;
}

.ios-switch--on .ios-switch-knob {
  transform: translateX(38rpx);
}

/* ── 6. 费用明细卡片 ── */
.price-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.calc-btn {
  font-size: 24rpx;
  color: #FF382E;
  background: #FFF1EE;
  border-radius: 30rpx;
  padding: 8rpx 22rpx;
  line-height: 1.4;
  margin: 0;
  border: none;
  font-weight: 600;
}

.calc-btn--loading {
  opacity: 0.6;
}

.preview-breakdown {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.price-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
}

.price-label {
  color: #636366;
}

.price-val {
  color: #1C1C1E;
  font-weight: 600;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display";
}

.discount-line .price-label,
.discount-line .price-val {
  color: #FF382E;
}

.total-line {
  margin-top: 6rpx;
}

.total-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #1C1C1E;
}

.total-val-box {
  display: flex;
  align-items: baseline;
  color: #FF382E;
}

.total-sym {
  font-size: 26rpx;
  font-weight: 700;
}

.total-val {
  font-size: 44rpx;
  font-weight: 800;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display";
}

.preview-empty {
  padding: 24rpx 0 10rpx;
  text-align: center;
}

.preview-empty-hint {
  font-size: 24rpx;
  color: #8E8E93;
}

/* 错误提示 */
.error-banner {
  background: #FFF1EE;
  border: 1rpx solid rgba(255, 56, 46, 0.2);
  border-radius: 20rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.error-txt {
  font-size: 24rpx;
  color: #FF382E;
}

/* ── 7. 支付方式 ── */
.payment-method-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
}

.pay-method-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.pay-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pay-text-col {
  display: flex;
  flex-direction: column;
}

.pay-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1C1C1E;
}

.pay-sub {
  font-size: 20rpx;
  color: #8E8E93;
  margin-top: 4rpx;
}

.pay-check-circle {
  width: 44rpx;
  height: 44rpx;
  background: #34C759;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bottom-spacer {
  height: 40rpx;
}

/* ── 8. 吸底磨砂毛玻璃结算栏 ── */
.fixed-footer-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 124rpx;
  background: rgba(255, 255, 255, 0.88);
  -webkit-backdrop-filter: blur(30px);
  backdrop-filter: blur(30px);
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  padding: 14rpx 32rpx calc(14rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 100;
  box-sizing: border-box;
}

.footer-left {
  display: flex;
  align-items: baseline;
}

.footer-total-label {
  font-size: 26rpx;
  color: #8E8E93;
}

.footer-total-sym {
  font-size: 30rpx;
  font-weight: 800;
  color: #FF382E;
}

.footer-total-num {
  font-size: 52rpx;
  font-weight: 800;
  color: #FF382E;
  margin-right: 12rpx;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display";
}

.footer-saved-pill {
  font-size: 20rpx;
  color: #FF382E;
  background: #FFF1EE;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.footer-submit-btn {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 54rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #FF5A36 0%, #FF382E 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 20rpx rgba(255, 56, 46, 0.35);
  border: none;
  margin: 0;
}

.btn--disabled {
  opacity: 0.55;
}

.bubble-icon-img {
  width: 28rpx;
  height: 28rpx;
}

.meta-icon-img {
  width: 24rpx;
  height: 24rpx;
  margin-right: 6rpx;
}

.badge-check-img {
  width: 22rpx;
  height: 22rpx;
  margin-right: 6rpx;
}

.chevron-arrow {
  font-size: 32rpx;
  color: #C7C7CC;
  font-weight: 300;
  line-height: 1;
}

.travel-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.error-icon-img {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.pay-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.pay-check-img {
  width: 24rpx;
  height: 24rpx;
}

.calc-status-tag {
  font-size: 22rpx;
  color: #8E8E93;
}

.tag--calc {
  color: #007AFF;
}

.mode-tag-offline {
  font-size: 20rpx;
  background: rgba(52, 199, 89, 0.15);
  color: #248A3D;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-left: 8rpx;
  font-weight: 600;
}

.preview-empty-row {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-bottom: 8rpx;
}

.preview-base-hint {
  font-size: 26rpx;
  color: #636366;
}

.preview-base-val {
  font-size: 36rpx;
  font-weight: 800;
  color: #FF382E;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display";
}

.pay-mode-emoji {
  font-size: 40rpx;
}

.pay-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.pay-pill-tag {
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.tag-offline {
  background: rgba(52, 199, 89, 0.15);
  color: #248A3D;
}

.tag-mock {
  background: rgba(0, 122, 255, 0.12);
  color: #007AFF;
}

.footer-offline-pill {
  font-size: 20rpx;
  color: #248A3D;
  background: rgba(52, 199, 89, 0.15);
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-weight: 600;
}
