.page {
  padding-bottom: 140rpx;
}

.cat-scroll {
  white-space: nowrap;
  margin: 0 -32rpx 24rpx;
  padding: 0 32rpx;
}

.cat-list {
  display: inline-flex;
  gap: 16rpx;
}

.cat-chip {
  display: inline-flex;
  padding: 12rpx 28rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 32rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  white-space: nowrap;
}

.cat-chip--active {
  background: var(--color-primary);
  color: #FFFFFF;
  border-color: var(--color-primary);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 32rpx;
}

.empty-state__icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-state__title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-muted);
}

.project-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.project-card {
  overflow: hidden;
}

.project-card__cover {
  position: relative;
  height: 240rpx;
  background: linear-gradient(135deg, #FFF1ED, #FFE8E0);
  display: flex;
  align-items: center;
  justify-content: center;
}

.project-card__img {
  width: 100%;
  height: 100%;
}

.project-card__placeholder {
  font-size: 64rpx;
}

.project-card__category {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 4rpx 16rpx;
  background: rgba(0,0,0,0.5);
  color: #FFFFFF;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.project-card__info {
  padding: 20rpx 24rpx;
}

.project-card__name {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.project-card__desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.project-card__meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.project-card__duration {
  font-size: 24rpx;
  color: var(--color-muted);
}

.project-card__price {
  display: flex;
  align-items: baseline;
}

.project-card__symbol {
  font-size: 24rpx;
  color: var(--color-primary);
}

.project-card__amount {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--color-primary);
}

.project-card__unit {
  font-size: 22rpx;
  color: var(--color-muted);
  margin-left: 4rpx;
}
