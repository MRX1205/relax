/* ==========================================================================
   Project List — Apple HIG Modern Aesthetics
   ========================================================================== */

.page {
  background: #F5F5F7;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 60rpx;
}

/* ── Apple Segmented Category Bar ── */
.cat-sticky-bar {
  position: sticky;
  top: 0;
  z-index: 50;
  background: rgba(245, 245, 247, 0.9);
  -webkit-backdrop-filter: blur(25px);
  backdrop-filter: blur(25px);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  padding: 16rpx 28rpx;
}

.cat-bar {
  width: 100%;
  white-space: nowrap;
}

.cat-chips {
  display: inline-flex;
  gap: 14rpx;
}

.cat-chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #636366;
  background: #FFFFFF;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  transition: all 0.2s cubic-bezier(0.25, 0.1, 0.25, 1);
}

.cat-chip--active {
  background: #1C1C1E;
  color: #FFFFFF;
  border-color: #1C1C1E;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.15);
}

/* ── 项目列表 ── */
.proj-list {
  padding: 20rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.proj-card {
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.proj-card__thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #E5E5EA;
}

.proj-card__center {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.proj-card__left {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.proj-pill-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.proj-card__tag {
  font-size: 20rpx;
  color: #FF382E;
  background: #FFF1EE;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  font-weight: 600;
}

.proj-card__meta {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #8E8E93;
}

.proj-card__name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1C1C1E;
}

.proj-card__right {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.proj-card__price {
  display: flex;
  align-items: baseline;
  color: #FF382E;
}

.proj-card__symbol {
  font-size: 22rpx;
  font-weight: 700;
}

.proj-card__amount {
  font-size: 40rpx;
  font-weight: 800;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display";
}

.proj-card__unit {
  font-size: 22rpx;
  color: #8E8E93;
  margin-left: 2rpx;
}

.proj-card__action {
  padding: 12rpx 28rpx;
  background: linear-gradient(135deg, #FF5A36 0%, #FF382E 100%);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 14rpx rgba(255, 56, 46, 0.28);
}

.empty-wrap {
  padding: 80rpx 0;
}
