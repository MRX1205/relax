.page {
  background: #14171D;
  min-height: 100vh;
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

.vip-card-box {
  padding: 32rpx 28rpx;
}

.vip-card {
  background: linear-gradient(135deg, #2E333D, #1A1C23);
  border: 1rpx solid #4A3E26;
  border-radius: 28rpx;
  padding: 36rpx;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.4);
  position: relative;
  overflow: hidden;
}

.vip-card::after {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(212, 175, 55, 0.15), transparent 70%);
}

.vc-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 36rpx;
}

.vc-brand {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.vc-crown {
  font-size: 36rpx;
}

.vc-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #D4AF37;
  letter-spacing: 1rpx;
}

.vc-status-badge {
  font-size: 22rpx;
  color: #1A1C23;
  background: #D4AF37;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 700;
}

.vc-middle {
  margin-bottom: 40rpx;
}

.vc-nickname {
  display: block;
  font-size: 38rpx;
  font-weight: 800;
  color: #F3E5C8;
  margin-bottom: 8rpx;
}

.vc-desc {
  font-size: 24rpx;
  color: #A0937D;
}

.vc-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.vc-card-no {
  font-size: 22rpx;
  color: #8C7C60;
  letter-spacing: 2rpx;
  font-family: monospace;
}

.vc-logo {
  font-size: 20rpx;
  color: #6E5F46;
  font-weight: 800;
  letter-spacing: 3rpx;
}

/* Privileges */
.privileges-section {
  padding: 0 28rpx;
  margin-bottom: 40rpx;
}

.sec-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #F3E5C8;
  margin-bottom: 24rpx;
}

.priv-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.priv-item {
  background: #1F242D;
  border: 1rpx solid #2C3340;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.priv-icon {
  font-size: 44rpx;
  margin-bottom: 4rpx;
}

.priv-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #E2D4B7;
}

.priv-desc {
  font-size: 22rpx;
  color: #88909E;
  line-height: 1.4;
}

/* Plans */
.plans-section {
  padding: 0 28rpx;
  margin-bottom: 40rpx;
}

.plans-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.plan-card {
  background: #1F242D;
  border: 2rpx solid #2C3340;
  border-radius: 20rpx;
  padding: 28rpx 16rpx;
  text-align: center;
  position: relative;
  transition: all 0.2s ease;
}

.plan-card--active {
  background: #2A2C29;
  border-color: #D4AF37;
  transform: translateY(-4rpx);
}

.plan-tip-badge {
  position: absolute;
  top: -14rpx;
  left: 50%;
  transform: translateX(-50%);
  background: #E54D42;
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 700;
  padding: 2rpx 12rpx;
  border-radius: 14rpx;
  white-space: nowrap;
}

.plan-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #D4AF37;
  margin-bottom: 12rpx;
}

.plan-price-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  color: #F3E5C8;
}

.plan-symbol {
  font-size: 26rpx;
  font-weight: 700;
}

.plan-price {
  font-size: 44rpx;
  font-weight: 900;
}

.plan-orig {
  display: block;
  font-size: 20rpx;
  color: #6C7584;
  text-decoration: line-through;
  margin-top: 6rpx;
}

/* Bottom Bar */
.bottom-subscribe-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #1A1C23;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -6rpx 20rpx rgba(0, 0, 0, 0.4);
  z-index: 100;
}

.sub-btn {
  background: linear-gradient(135deg, #E6C875, #D4AF37);
  color: #1A1C23;
  font-size: 32rpx;
  font-weight: 800;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 6rpx 20rpx rgba(212, 175, 55, 0.3);
}

.sub-icon {
  font-size: 36rpx;
}
