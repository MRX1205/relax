.page { padding-bottom: 140rpx; }

.profile-card {
  display: flex;
  align-items: center;
  padding: 32rpx;
  margin-bottom: 24rpx;
  gap: 24rpx;
}

.avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}

.avatar--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--color-primary), #E8704A);
}

.avatar-text {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.avatar-edit {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  text-align: center;
  background: rgba(0, 0, 0, 0.5);
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 4rpx 0;
  border-radius: 0 0 60rpx 60rpx;
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.nickname-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: 700;
}

.edit-icon {
  font-size: 24rpx;
}

.nickname-edit {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.nickname-input {
  flex: 1;
  height: 72rpx;
  padding: 0 16rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  font-size: 32rpx;
}

.nickname-save {
  padding: 12rpx 24rpx;
  background: var(--color-primary);
  color: #FFFFFF;
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  font-weight: 600;
}

.phone-text {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

.role-badge {
  display: inline-block;
  margin-top: 8rpx;
  padding: 4rpx 16rpx;
  background: #EDF8F3;
  color: var(--color-accent);
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.menu-group {
  margin-bottom: 24rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.menu-label {
  flex: 1;
  font-size: 30rpx;
}

.menu-arrow {
  color: var(--color-muted);
  font-size: 32rpx;
}

.logout-wrap {
  margin-top: 48rpx;
  padding: 0 32rpx;
}
