.empty {
  padding-top: 120rpx;
}

.address-list {
  display: grid;
  gap: 20rpx;
}

.address-item {
  padding: 24rpx;
}

.address-main {
  padding-bottom: 16rpx;
}

.address-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.address-name {
  font-size: 30rpx;
  font-weight: 600;
}

.address-phone {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.default-badge {
  padding: 2rpx 12rpx;
  background: var(--color-primary);
  color: #FFFFFF;
  border-radius: 8rpx;
  font-size: 20rpx;
}

.address-detail {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.address-label {
  display: inline-block;
  margin-top: 8rpx;
  padding: 2rpx 12rpx;
  background: #EDF8F3;
  color: var(--color-accent);
  border-radius: 8rpx;
  font-size: 20rpx;
}

.address-actions {
  display: flex;
  gap: 32rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-border);
}

.action-link {
  font-size: 24rpx;
  color: var(--color-primary);
}

.action-link--danger {
  color: var(--color-danger);
}

.add-bar {
  margin-top: 32rpx;
}
