.ios-tabbar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 112rpx;
  -webkit-backdrop-filter: blur(30px);
  backdrop-filter: blur(30px);
  background: rgba(255, 255, 255, 0.88);
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  padding-bottom: env(safe-area-inset-bottom);
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 999;
  box-shadow: 0 -4rpx 28rpx rgba(0, 0, 0, 0.04);
}

.tabbar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
  position: relative;
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tabbar-item:active {
  transform: scale(0.92);
}

.tabbar-icon-wrap {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
}

.tabbar-icon {
  width: 44rpx;
  height: 44rpx;
  transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tabbar-item--active .tabbar-icon {
  transform: translateY(-2rpx) scale(1.08);
}

.tabbar-indicator {
  position: absolute;
  bottom: -4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 8rpx;
  height: 8rpx;
  background: #FF382E;
  border-radius: 50%;
  box-shadow: 0 2rpx 6rpx rgba(255, 56, 46, 0.4);
  animation: iosDotPop 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes iosDotPop {
  0% { transform: translateX(-50%) scale(0); opacity: 0; }
  100% { transform: translateX(-50%) scale(1); opacity: 1; }
}

.tabbar-text {
  font-size: 20rpx;
  font-weight: 500;
  color: #8E8E93;
  line-height: 1.2;
  transition: color 0.2s ease, font-weight 0.2s ease;
  letter-spacing: 0.5rpx;
}

.tabbar-item--active .tabbar-text {
  color: #FF382E;
  font-weight: 600;
}
