.page {
  padding-bottom: 140rpx;
}

.tech-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  background: linear-gradient(135deg, #237A57, #2E9B6E);
  border-radius: 24rpx;
  color: #FFFFFF;
  margin-bottom: 32rpx;
}

.tech-header__name {
  font-size: 36rpx;
  font-weight: 700;
}

.tech-header__meta {
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 8rpx;
}

.online-btn {
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.online-btn--on {
  background: rgba(255,255,255,0.25);
  color: #FFFFFF;
}

.online-btn--off {
  background: rgba(0,0,0,0.15);
  color: rgba(255,255,255,0.7);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 32rpx;
}

.empty-state__icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-state__title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.empty-state__desc {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  text-align: center;
  margin-bottom: 40rpx;
}

.apply-btn {
  padding: 24rpx 64rpx;
  background: var(--color-primary);
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.stats-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.stat-card {
  flex: 1;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 20rpx;
  padding: 24rpx;
  text-align: center;
}

.stat-card__num {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-primary);
}

.stat-card__label {
  font-size: 22rpx;
  color: var(--color-muted);
  margin-top: 8rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.action-grid {
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.action-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 28rpx 16rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 20rpx;
}

.action-item__icon {
  font-size: 44rpx;
}

.action-item__text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text);
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.order-card {
  padding: 24rpx;
}

.order-card__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.order-card__no {
  font-size: 24rpx;
  color: var(--color-muted);
}

.order-card__status {
  font-size: 24rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
}

.order-card__status--PAID {
  background: #FFF3E0;
  color: #E65100;
}

.order-card__status--CONFIRMED {
  background: #E8F5E9;
  color: #2E7D32;
}

.order-card__body {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-card__project {
  font-size: 28rpx;
  font-weight: 600;
}

.order-card__time {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.empty-today {
  padding: 60rpx;
  text-align: center;
}

.empty-today__text {
  font-size: 28rpx;
  color: var(--color-muted);
}
