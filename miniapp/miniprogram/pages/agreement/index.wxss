.agreement-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.agreement-meta {
  font-size: 24rpx;
  color: var(--color-muted);
  margin-bottom: 24rpx;
}

.agreement-body {
  padding: 28rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--color-text);
  white-space: pre-wrap;
}

.consent-bar {
  margin-top: 32rpx;
  padding-bottom: env(safe-area-inset-bottom);
}
