<view class="page">
  <view class="list-header">
    <view class="page-title">我的排班</view>
    <view class="add-btn" bindtap="handleAdd">+ 新增</view>
  </view>

  <ui-state wx:if="{{loading}}" title="加载中" kind="loading" />

  <block wx:else>
    <view wx:if="{{showForm}}" class="surface form-card">
      <view class="form-row">
        <text class="form-label">日期</text>
        <picker mode="date" value="{{formDate}}" start="{{today}}" bindchange="handleDateChange">
          <view class="picker-val">{{formDate || '选择日期'}}</view>
        </picker>
      </view>
      <view class="form-row">
        <text class="form-label">开始时间</text>
        <picker mode="time" value="{{formStart}}" bindchange="handleStartChange">
          <view class="picker-val">{{formStart}}</view>
        </picker>
      </view>
      <view class="form-row">
        <text class="form-label">结束时间</text>
        <picker mode="time" value="{{formEnd}}" bindchange="handleEndChange">
          <view class="picker-val">{{formEnd}}</view>
        </picker>
      </view>
      <view class="form-actions">
        <ui-button label="取消" variant="secondary" bind:action="handleCancel" />
        <ui-button label="保存" loading="{{saving}}" bind:action="handleSave" />
      </view>
    </view>

    <view class="schedule-list">
      <view wx:for="{{schedules}}" wx:key="id" class="surface schedule-item">
        <view class="schedule-main" data-item="{{item}}" bindtap="handleEdit">
          <view class="schedule-date">{{item.scheduleDate}}</view>
          <view class="schedule-time">{{item.startTime}} - {{item.endTime}}</view>
        </view>
        <view class="schedule-delete" data-id="{{item.id}}" bindtap="handleDelete">删除</view>
      </view>
      <view wx:if="{{schedules.length === 0}}" class="empty-tip">暂无排班，请添加可服务时段</view>
    </view>
  </block>
</view>
