<view class="login-page">

  <!-- 顶部渐变与品牌区域 -->
  <view class="brand-hero">
    <view class="brand-logo-box">
      <text class="brand-logo-icon">💆</text>
    </view>
    <text class="brand-title">{{appName || '东莞到家'}}</text>
    <text class="brand-sub">专业理疗 · 上门到家 · 正规安全</text>
  </view>

  <!-- 登录主体卡片 -->
  <view class="login-card">

    <!-- 身份切换 Tab（普通用户 / 服务端） -->
    <view class="tab-switcher">
      <view
        class="tab-btn {{loginTab === 'user' ? 'tab-btn--active' : ''}}"
        data-tab="user"
        bindtap="switchTab"
      >
        <text class="tab-btn-txt">用户端 (找技师/预约)</text>
      </view>
      <view
        class="tab-btn {{loginTab === 'staff' ? 'tab-btn--active' : ''}}"
        data-tab="staff"
        bindtap="switchTab"
      >
        <text class="tab-btn-txt">服务端 (技师/管理员)</text>
      </view>
    </view>

    <!-- 错误提示条 -->
    <view wx:if="{{error}}" class="error-strip">
      <text class="error-strip-icon">⚠️</text>
      <text class="error-strip-txt">{{error}}</text>
    </view>

    <!-- ══ 1. 用户端登录模式 ══ -->
    <block wx:if="{{loginTab === 'user'}}">
      <!-- 3大品质保障胶囊 -->
      <view class="feature-badges">
        <view class="badge-item">
          <text class="badge-check">✓</text>
          <text class="badge-text">实名技师认证</text>
        </view>
        <view class="badge-item">
          <text class="badge-check">✓</text>
          <text class="badge-text">平台资金担保</text>
        </view>
        <view class="badge-item">
          <text class="badge-check">✓</text>
          <text class="badge-text">爽约未达包退</text>
        </view>
      </view>

      <!-- 微信登录主按钮 -->
      <button
        class="wechat-login-btn {{loading ? 'btn--loading' : ''}}"
        bindtap="handleUserWechatLogin"
        disabled="{{loading}}"
      >
        <text class="wx-icon">💬</text>
        <text class="wx-btn-txt">{{loading ? '正在登录…' : '微信一键快捷登录'}}</text>
      </button>
    </block>

    <!-- ══ 2. 服务端登录模式 (技师/管理员) ══ -->
    <block wx:else>
      <view class="staff-header-hint">
        <text class="staff-hint-title">服务端专属安全通道</text>
        <text class="staff-hint-sub">实名认证技师及平台管理员请使用账号密码或已绑定微信登录</text>
      </view>

      <view class="staff-form-wrap">
        <view class="input-field-item">
          <text class="field-icon">📱</text>
          <input
            class="form-input"
            type="number"
            maxlength="11"
            value="{{phone}}"
            placeholder="请输入已授权手机号"
            bindinput="handlePhoneInput"
          />
        </view>

        <view class="input-field-item">
          <text class="field-icon">🔐</text>
          <input
            class="form-input"
            password="{{true}}"
            value="{{password}}"
            placeholder="请输入登录密码"
            bindinput="handlePasswordInput"
          />
        </view>

        <!-- 密码登录主按钮 -->
        <button
          class="staff-submit-btn {{loading ? 'btn--loading' : ''}}"
          bindtap="handleStaffPasswordLogin"
          disabled="{{loading}}"
        >
          <text class="submit-btn-txt">{{loading ? '正在验证…' : '安全验证登录'}}</text>
        </button>

        <view class="staff-divider-row">
          <view class="divider-line"></view>
          <text class="divider-txt">或快捷登入</text>
          <view class="divider-line"></view>
        </view>

        <!-- 微信已绑定账号快捷登录 -->
        <button
          class="staff-wx-btn"
          bindtap="handleStaffWechatLogin"
          disabled="{{loading}}"
        >
          <text class="wx-icon">💬</text>
          <text class="staff-wx-txt">微信一键登录 (需已绑定微信号)</text>
        </button>
      </view>
    </block>

    <!-- 协议勾选行 -->
    <view class="agreement-row" bindtap="toggleAgree">
      <view class="agree-box {{agreed ? 'agree-box--checked' : ''}}">
        <text wx:if="{{agreed}}">✓</text>
      </view>
      <view class="agreement-text">
        <text>我已阅读并同意</text>
        <navigator url="/pages/agreement/index?type=USER_AGREEMENT" class="link" catchtap>《用户服务协议》</navigator>
        <text>及</text>
        <navigator url="/pages/agreement/index?type=PRIVACY_POLICY" class="link" catchtap>《隐私保护政策》</navigator>
      </view>
    </view>

  </view>

  <!-- 底部正规倡议 -->
  <view class="footer-note">
    <text class="shield-icon">🛡️</text>
    <text>正规健康平台 · 绿色阳光服务 · 严禁索要小费</text>
  </view>

</view>
