<view class="page">
  <view class="page-title">绑定手机号</view>
  <view class="page-subtitle">手机号仅用于订单预约通知及技师到达联络，严格保密。</view>

  <view class="phone-card surface">
    <view wx:if="{{error}}" class="error-banner">{{error}}</view>

    <!-- 方式1：微信一键授权 -->
    <button
      class="phone-btn phone-btn--wechat"
      open-type="getPhoneNumber"
      bindgetphonenumber="handleGetPhoneNumber"
      loading="{{loading}}"
    >
      💬 微信一键授权手机号
    </button>

    <view class="or-divider">
      <view class="divider-line"></view>
      <text class="divider-text">或手动输入绑定</text>
      <view class="divider-line"></view>
    </view>

    <!-- 方式2：手动输入手机号 -->
    <view class="manual-input-box">
      <input
        class="manual-input"
        type="number"
        maxlength="11"
        value="{{manualPhone}}"
        placeholder="请输入11位中国大陆手机号"
        bindinput="handleManualInput"
      />
      <button
        class="manual-btn"
        bindtap="handleManualBind"
        disabled="{{loading || !manualPhone}}"
      >
        确认绑定
      </button>
    </view>

    <view class="skip" bindtap="handleSkip">暂时跳过，稍后在个人中心绑定 ›</view>
  </view>
</view>
