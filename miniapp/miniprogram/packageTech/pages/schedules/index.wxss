.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.add-btn {
  padding: 12rpx 24rpx;
  background: var(--color-primary);
  color: #FFFFFF;
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  font-weight: 600;
}
.form-card {
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}
.form-row:last-of-type {
  border-bottom: none;
}
.form-label {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}
.picker-val {
  font-size: 30rpx;
  font-weight: 600;
}
.form-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
.schedule-list {
  display: grid;
  gap: 16rpx;
}
.schedule-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
}
.schedule-date {
  font-size: 30rpx;
  font-weight: 600;
}
.schedule-time {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}
.schedule-delete {
  font-size: 24rpx;
  color: var(--color-danger);
  padding: 8rpx 16rpx;
}
.empty-tip { text-align: center; color: var(--color-muted); padding: 48rpx; }
