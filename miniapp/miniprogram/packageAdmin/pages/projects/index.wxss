.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.add-btn {
  padding: 12rpx 24rpx;
  background: var(--color-primary);
  color: #FFFFFF;
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  font-weight: 600;
}
.form-card {
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.field {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}
.field__label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}
.picker-val {
  font-size: 30rpx;
  min-height: 48rpx;
  display: flex;
  align-items: center;
}
.form-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
.cover-upload {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed var(--color-border);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.cover-placeholder {
  font-size: 24rpx;
  color: var(--color-muted);
}
.cover-preview {
  width: 100%;
  height: 100%;
}
.proj-list {
  display: grid;
  gap: 16rpx;
}
.proj-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
}
.proj-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.proj-type-tag {
  font-size: 20rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}
.tag-custom {
  background: #FFF3E0;
  color: #E65100;
}
.tag-platform {
  background: #E3F2FD;
  color: #1565C0;
}
.proj-name {
  font-size: 30rpx;
  font-weight: 600;
}
.proj-meta {
  font-size: 24rpx;
  color: var(--color-muted);
  margin-top: 6rpx;
}
.proj-status {
  font-size: 24rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}
.status-on { background: #EDF8F3; color: var(--color-success); }
.status-off { background: #F6F7F9; color: var(--color-muted); }
.empty-tip { text-align: center; color: var(--color-muted); padding: 48rpx; }
