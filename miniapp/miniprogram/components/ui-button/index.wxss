.button {
  display: flex;
  min-height: 88rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 0;
}

.button::after {
  border: 0;
}

.button--primary {
  background: #FF382E !important;
  background-color: #FF382E !important;
  color: #FFFFFF !important;
  border-radius: 44rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 56, 46, 0.3);
}

.button--primary:active {
  background: #E03126 !important;
  opacity: 0.9;
}

.button--secondary {
  background: #FFFFFF !important;
  color: #FF382E !important;
  border: 1.5rpx solid #FF382E !important;
  border-radius: 44rpx;
}

.button[disabled] {
  background: #D9E2EC;
  color: #7B8794;
  opacity: 1;
}

