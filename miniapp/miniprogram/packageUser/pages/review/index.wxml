<view class="page">
  <view class="page-title">评价服务</view>

  <view class="surface section">
    <view class="label">评分</view>
    <view class="stars">
      <view wx:for="{{[1,2,3,4,5]}}" wx:key="*this" class="star {{score >= item ? 'star--active' : ''}}"
        data-score="{{item}}" bindtap="handleScoreTap">★</view>
    </view>
  </view>

  <view class="surface section">
    <view class="label">评价内容</view>
    <textarea class="content-input" placeholder="分享您的服务体验" value="{{content}}" bindinput="handleContentInput" maxlength="500" />
  </view>

  <ui-button label="提交评价" loading="{{submitting}}" bind:action="handleSubmit" />
</view>
