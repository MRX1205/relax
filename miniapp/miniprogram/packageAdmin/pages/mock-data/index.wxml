<view class="page">
  <ui-state wx:if="{{loading}}" title="加载状态中" kind="loading" />

  <block wx:else>
    <!-- 顶部说明卡片 -->
    <view class="hero-banner ios-card">
      <view class="hero-tag">DATA ISOLATION</view>
      <view class="hero-title">业务数据与演示隔离</view>
      <view class="hero-desc">
        开启/关闭演示数据，避免测试单污染平台财务大盘与实际运营报表；正式营业时请保持关闭。
      </view>
    </view>

    <!-- 1. 核心开关卡片 -->
    <view class="ios-card switch-card">
      <view class="switch-main">
        <view class="switch-icon-box {{status.enabled ? 'icon-box-active' : 'icon-box-idle'}}">
          {{status.enabled ? '🧪' : '🛡️'}}
        </view>
        <view class="switch-text-col">
          <text class="switch-title">Mock 模拟演示数据</text>
          <text class="switch-sub">
            {{status.enabled ? '当前处于【演示模式】，各端展示测试订单与模拟评价' : '当前处于【纯净真实模式】，仅显示真实顾客下单数据'}}
          </text>
        </view>
        <switch checked="{{status.enabled}}" disabled="{{actionLoading}}" color="#34C759" bindchange="toggleMock" />
      </view>
    </view>

    <!-- 2. 数据量对比面板 -->
    <view class="ios-card metrics-card">
      <view class="card-head">
        <text class="card-head-title">当前系统订单统计</text>
        <text class="card-head-sub">实时统计数据库记录</text>
      </view>
      <view class="metrics-grid">
        <view class="metric-item">
          <text class="metric-num text-orange">{{status.mockOrdersCount}}</text>
          <text class="metric-label">Mock 演示订单</text>
        </view>
        <view class="metric-divider"></view>
        <view class="metric-item">
          <text class="metric-num text-green">{{status.realOrdersCount}}</text>
          <text class="metric-label">真实顾客订单</text>
        </view>
      </view>
    </view>

    <!-- 3. 管理员账号保障说明 -->
    <view class="ios-card admin-protect-card">
      <view class="protect-head">
        <text class="protect-icon">👑</text>
        <text class="protect-title">超级管理员账号保障</text>
      </view>
      <view class="protect-body">
        <text class="protect-txt">平台管理员账号不受 Mock 开关与重置影响：</text>
        <view class="admin-pill">
          <text class="pill-label">专属超管账号：</text>
          <text class="pill-val">13926700205</text>
          <text class="pill-tag">核心保护</text>
        </view>
        <text class="protect-tip">初始登录密码同手机号，拥有平台全量最高管理权限。</text>
      </view>
    </view>

    <!-- 4. 快速运维动作 -->
    <view class="ios-card action-card">
      <view class="card-head">
        <text class="card-head-title">快速运维操作</text>
      </view>

      <view class="action-btn-row">
        <button class="action-btn btn-danger ios-touch-active" bindtap="cleanMockData">
          🗑️ 清空所有 Mock 演示数据
        </button>
        <button class="action-btn btn-primary ios-touch-active" bindtap="seedMockData">
          ✨ 重新注入演示数据包
        </button>
      </view>
    </view>

    <!-- 5. 规则与指引 -->
    <view class="ios-card guide-card">
      <view class="guide-title">💡 数据管理指引</view>
      <view class="guide-item">• <strong>关闭演示数据</strong>：测试订单、模拟理疗评价将立即在全端隐藏或物理移除，大盘数据纯净无污染。</view>
      <view class="guide-item">• <strong>导出 Excel</strong>：在订单调度页面导出的报表只包含当前生效状态的真实账单。</view>
      <view class="guide-item">• <strong>真实下单</strong>：小程序体验版中任何用户微信下单均自动沉淀为【真实顾客订单】。</view>
    </view>
  </block>
</view>

