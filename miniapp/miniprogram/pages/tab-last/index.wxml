<view class="ios-orders-page">

  <view wx:if="{{loading}}" class="loading-feed">
    <view class="ios-skeleton skeleton-card" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
  </view>

  <!-- ════ USER: 我的订单 ════ -->
  <block wx:elif="{{role === 'USER'}}">
    <view class="page-title-bar">
      <text class="page-main-title">服务订单</text>
      <text class="page-sub-title">预约记录与履约保障</text>
    </view>

    <!-- 空订单 -->
    <view wx:if="{{orders.length === 0}}" class="ios-empty-view">
      <view class="empty-icon-circle">
        <image class="empty-svg" src="/assets/icons/order.png" mode="aspectFit" />
      </view>
      <text class="empty-primary">暂无服务订单</text>
      <text class="empty-secondary">预约一个专业上门理疗放松一下吧</text>
    </view>

    <!-- 订单列表 -->
    <view wx:else class="orders-feed">
      <view
        wx:for="{{orders}}"
        wx:key="id"
        class="order-ticket-card ios-card ios-touch-active"
        data-id="{{item.id}}"
        data-no="{{item.orderNo || item.id}}"
        bindtap="goToOrderDetail"
      >
        <!-- 头部：单号与状态标签 -->
        <view class="ticket-header">
          <text class="ticket-no">订单号：{{item.orderNo}}</text>
          <view class="ticket-status-pill" style="{{item.statusInfo ? 'color:' + item.statusInfo.color + '; background:' + item.statusInfo.bg : ''}}">
            {{item.statusInfo ? item.statusInfo.text : (item.status === 'PENDING_PAYMENT' ? '待付款' : item.status === 'PAID' ? '待接单' : item.status === 'ACCEPTED' ? '已接单' : item.status === 'IN_SERVICE' ? '服务中' : item.status === 'COMPLETED' ? '已完成' : item.status === 'CANCELLED' ? '已取消' : item.status)}}
          </view>
        </view>

        <!-- 主体：项目与预约时间 -->
        <view class="ticket-body">
          <text class="ticket-proj-title">{{item.projectName || '正规理疗上门服务'}}</text>
          <view class="ticket-meta-line" wx:if="{{item.technicianName}}">
            <text class="meta-label">技师：</text>
            <text class="meta-val">{{item.technicianName}}</text>
          </view>
          <view class="ticket-meta-line" wx:if="{{item.serviceDate}}">
            <text class="meta-label">时间：</text>
            <text class="meta-val">{{item.serviceDate}} {{item.startTime}}-{{item.endTime}}</text>
          </view>
          <view class="ticket-meta-line" wx:if="{{item.serviceAddress}}">
            <text class="meta-label">地址：</text>
            <text class="meta-val ellipsis">{{item.serviceAddress}}</text>
          </view>
        </view>

        <!-- 底部：金额与行动入口 -->
        <view class="ticket-footer">
          <view class="ticket-price-box">
            <text class="price-lbl">实付：</text>
            <text class="price-curr">¥</text>
            <text class="price-val">{{item.amount || item.payableAmount || 168}}</text>
          </view>
          <view class="ticket-detail-link">
            <text>查看详情</text>
            <text class="chev">›</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <view class="safe-bottom-bar"></view>
</view>

<custom-tabbar />
