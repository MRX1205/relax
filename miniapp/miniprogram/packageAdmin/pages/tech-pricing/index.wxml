<view class="page">
  <view class="list-header">
    <view class="page-title">{{technicianName}} 的项目定价</view>
    <view class="add-btn" bindtap="handleShowAdd">+ 设置</view>
  </view>

  <ui-state wx:if="{{loading}}" title="加载中" kind="loading" />

  <block wx:else>
    <view wx:if="{{showAdd}}" class="surface form-card">
      <view class="field">
        <view class="field__label">项目</view>
        <picker range="{{projects}}" range-key="name" bindchange="handleProjectChange">
          <view class="picker-val">{{selectedProjectId ? '已选择' : '点击选择项目'}}</view>
        </picker>
      </view>
      <view class="field">
        <view class="field__label">技师价格（元）</view>
        <input class="price-input" type="digit" value="{{overridePrice}}" placeholder="输入技师实际价格" bindinput="handlePriceInput" />
      </view>
      <view class="form-actions">
        <ui-button label="取消" variant="secondary" bind:action="handleCancel" />
        <ui-button label="保存" loading="{{saving}}" bind:action="handleSave" />
      </view>
    </view>

    <view class="pricing-list">
      <view wx:for="{{pricing}}" wx:key="id" class="surface pricing-item">
        <view class="pricing-info">
          <view class="pricing-project">{{item.projectName}}</view>
          <view class="pricing-detail">
            <text>技师价：¥{{item.overridePrice}}</text>
            <text class="pricing-base">（基础价 ¥{{item.effectivePrice}}）</text>
          </view>
        </view>
        <view class="pricing-delete" data-id="{{item.id}}" bindtap="handleDelete">删除</view>
      </view>
      <view wx:if="{{pricing.length === 0}}" class="empty-tip">暂未设置独立定价，将使用项目基础价</view>
    </view>
  </block>
</view>
