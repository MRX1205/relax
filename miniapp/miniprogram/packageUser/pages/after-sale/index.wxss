.page {
  padding: 32rpx;
  background: #F5F6F8;
  min-height: 100vh;
}

.page-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #1A1A1A;
  margin-bottom: 28rpx;
}

.section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.label {
  font-size: 28rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 16rpx;
}

.label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.sub-label {
  font-size: 22rpx;
  color: #999999;
}

.type-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.type-chip {
  padding: 12rpx 28rpx;
  background: #F4F5F7;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666666;
}

.type-chip--active {
  background: #FFF0EC;
  color: #E54D42;
  font-weight: 700;
  border: 1rpx solid #E54D42;
}

.content-input {
  width: 100%;
  min-height: 180rpx;
  font-size: 28rpx;
  color: #333333;
}

/* 凭证网格 */
.uploader-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.thumb-wrap {
  width: 140rpx;
  height: 140rpx;
  border-radius: 14rpx;
  position: relative;
  overflow: hidden;
}

.thumb-img {
  width: 100%;
  height: 100%;
}

.remove-btn {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.upload-btn {
  width: 140rpx;
  height: 140rpx;
  border: 2rpx dashed #DCDFE6;
  border-radius: 14rpx;
  background: #F8F9FA;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.upload-icon {
  font-size: 40rpx;
}

.upload-txt {
  font-size: 22rpx;
  color: #999999;
}

.btn-wrap {
  margin-top: 36rpx;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #E54D42, #FF7043);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(229, 77, 66, 0.35);
  border: none;
}

.btn--disabled {
  opacity: 0.6;
}
