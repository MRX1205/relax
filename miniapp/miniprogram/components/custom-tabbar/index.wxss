.tabbar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 120rpx;
  background: #FFFFFF;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  padding-bottom: env(safe-area-inset-bottom);
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 999;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.tabbar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
  position: relative;
  transition: all 0.2s ease;
}

.tabbar-item:active {
  transform: scale(0.9);
}

.tabbar-icon-wrapper {
  position: relative;
  margin-bottom: 4rpx;
}

.tabbar-icon {
  font-size: 44rpx;
  transition: all 0.2s ease;
}

.tabbar-item--active .tabbar-icon {
  transform: scale(1.1);
}

.tabbar-dot {
  position: absolute;
  bottom: -4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 8rpx;
  height: 8rpx;
  background: #FF6B6B;
  border-radius: 50%;
}

.tabbar-text {
  font-size: 20rpx;
  color: #7B8794;
  line-height: 1.2;
  transition: all 0.2s ease;
}

.tabbar-item--active .tabbar-text {
  color: #FF6B6B;
  font-weight: 600;
}
