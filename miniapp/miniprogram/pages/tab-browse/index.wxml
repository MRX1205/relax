<view class="page">
  <ui-state wx:if="{{loading}}" title="加载中" kind="loading" />

  <!-- USER: Projects -->
  <block wx:elif="{{role === 'USER'}}">
    <scroll-view class="cat-scroll" scroll-x wx:if="{{categories.length > 0}}">
      <view class="cat-list">
        <view class="cat-chip {{currentCategory === 0 ? 'cat-chip--active' : ''}}" data-id="0" bindtap="switchCategory">全部</view>
        <view wx:for="{{categories}}" wx:key="id" class="cat-chip {{currentCategory === item.id ? 'cat-chip--active' : ''}}" data-id="{{item.id}}" bindtap="switchCategory">{{item.name}}</view>
      </view>
    </scroll-view>

    <block wx:if="{{projects.length === 0}}">
      <view class="empty"><view class="empty__icon">💆</view><view class="empty__text">暂无项目</view></view>
    </block>

    <view class="project-list">
      <view wx:for="{{projects}}" wx:key="id" class="project-card surface" data-id="{{item.id}}" bindtap="goToProjectDetail">
        <view class="project-card__cover">
          <image wx:if="{{item.coverFileId}}" src="{{item.coverFileId}}" mode="aspectFill" class="project-card__img" />
          <view wx:else class="project-card__ph">💆</view>
          <view class="project-card__cat">{{item.categoryName}}</view>
        </view>
        <view class="project-card__info">
          <view class="project-card__name">{{item.name}}</view>
          <view class="project-card__meta">
            <text>{{item.durationMinutes}}分钟</text>
            <view class="project-card__price"><text class="sym">¥</text><text class="amt">{{item.basePrice}}</text><text class="unit">起</text></view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- TECH/ADMIN: Orders -->
  <block wx:elif="{{role !== 'USER'}}">
    <view class="order-tabs">
      <view class="order-tab {{orderTab === 'all' ? 'order-tab--active' : ''}}" data-tab="all" bindtap="switchOrderTab">全部</view>
      <view class="order-tab {{orderTab === 'active' ? 'order-tab--active' : ''}}" data-tab="active" bindtap="switchOrderTab">进行中</view>
      <view class="order-tab {{orderTab === 'done' ? 'order-tab--active' : ''}}" data-tab="done" bindtap="switchOrderTab">已完成</view>
    </view>

    <block wx:if="{{orders.length === 0}}">
      <view class="empty"><view class="empty__icon">📋</view><view class="empty__text">暂无订单</view></view>
    </block>

    <view class="order-list">
      <view wx:for="{{orders}}" wx:key="id" class="order-card surface" data-id="{{item.id}}" bindtap="goToOrderDetail">
        <view class="order-card__head">
          <text class="order-card__no">{{item.orderNo}}</text>
          <text class="order-card__status">{{item.status}}</text>
        </view>
        <view class="order-card__body">
          <text class="order-card__proj">{{item.projectName || '服务项目'}}</text>
          <text class="order-card__time">{{item.serviceDate}} {{item.startTime}}-{{item.endTime}}</text>
        </view>
        <view class="order-card__foot">
          <text class="order-card__amount">¥{{item.amount || 0}}</text>
        </view>
      </view>
    </view>
  </block>
</view>

<custom-tabbar />
