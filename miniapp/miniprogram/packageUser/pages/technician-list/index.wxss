.tech-list {
  display: grid;
  gap: 20rpx;
}
.tech-card {
  display: flex;
  align-items: center;
  padding: 28rpx;
  background: var(--color-surface);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  gap: 24rpx;
}
.tech-card__avatar {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #EDF8F3, #D4EDDF);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.tech-card__avatar-text {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-accent);
}
.tech-card__online {
  position: absolute;
  bottom: 4rpx;
  right: 4rpx;
  width: 18rpx;
  height: 18rpx;
  background: var(--color-success);
  border-radius: 50%;
  border: 3rpx solid var(--color-surface);
}
.tech-card__info {
  flex: 1;
  min-width: 0;
}
.tech-card__name {
  font-size: 30rpx;
  font-weight: 700;
}
.tech-card__meta {
  font-size: 22rpx;
  color: var(--color-muted);
  margin-top: 6rpx;
}
.tech-card__intro {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tech-card__right {
  text-align: right;
  flex-shrink: 0;
}
.tech-card__status {
  font-size: 22rpx;
  color: var(--color-muted);
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  background: #F6F7F9;
}
.tech-card__status.online {
  color: var(--color-success);
  background: #EDF8F3;
}
.tech-card__price {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-primary);
  margin-top: 12rpx;
}
.empty-wrap { padding-top: 80rpx; }
