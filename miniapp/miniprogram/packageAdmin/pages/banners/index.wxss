.page {
  padding: 24rpx;
  background: #F5F6F8;
  min-height: 100vh;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.page-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.add-btn {
  background: linear-gradient(135deg, #E54D42, #FF7043);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 14rpx rgba(229, 77, 66, 0.35);
}

/* 表单卡片 */
.form-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.06);
}

.form-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 24rpx;
}

.field {
  margin-bottom: 20rpx;
}

.field-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 10rpx;
  display: block;
}

.field-input {
  background: #F8F9FA;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  font-size: 26rpx;
  color: #333333;
}

.picker-box {
  background: #F8F9FA;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-txt {
  font-size: 26rpx;
  color: #333333;
}

.picker-arrow {
  font-size: 20rpx;
  color: #999999;
}

/* 图片上传器 */
.banner-uploader {
  width: 100%;
  height: 220rpx;
  background: #F8F9FA;
  border: 2rpx dashed #DCDFE6;
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.banner-preview-img {
  width: 100%;
  height: 100%;
}

.banner-upload-ph {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.ph-icon {
  font-size: 48rpx;
}

.ph-txt {
  font-size: 24rpx;
  color: #999999;
}

.form-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 28rpx;
}

.form-btn {
  padding: 14rpx 36rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.form-btn--cancel {
  background: #F0F2F5;
  color: #666666;
}

.form-btn--save {
  background: linear-gradient(135deg, #E54D42, #FF7043);
  color: #FFFFFF;
  box-shadow: 0 4rpx 14rpx rgba(229, 77, 66, 0.3);
}

.btn--disabled {
  opacity: 0.6;
}

/* 轮播列表卡片 */
.banner-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.banner-item-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.banner-item-thumb {
  width: 140rpx;
  height: 90rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #FFF0EC;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.banner-thumb-img {
  width: 100%;
  height: 100%;
}

.banner-thumb-ph {
  font-size: 44rpx;
}

.banner-item-main {
  flex: 1;
}

.banner-item-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.banner-item-meta {
  display: flex;
  gap: 10rpx;
}

.meta-tag {
  font-size: 20rpx;
  color: #888888;
  background: #F4F5F7;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
}

.meta-tag--link {
  color: #E54D42;
  background: #FFF0EC;
}

.banner-item-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.edit-btn {
  font-size: 24rpx;
  color: #1890FF;
  padding: 4rpx 12rpx;
}

.card-toggle {
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}

.toggle-on {
  background: #E8F7ED;
  color: #2BA245;
}

.toggle-off {
  background: #F5F5F7;
  color: #999999;
}

.empty-tip {
  text-align: center;
  color: #999999;
  font-size: 26rpx;
  padding: 80rpx 0;
}
