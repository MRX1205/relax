.page { padding-bottom: 140rpx; }

.section-title { font-size: 32rpx; font-weight: 700; margin-bottom: 8rpx; }
.desc { font-size: 24rpx; color: var(--color-muted); margin-bottom: 24rpx; }

.form-card { padding: 24rpx; margin-bottom: 24rpx; }
.form-item { margin-bottom: 24rpx; }
.form-label { display: block; font-size: 26rpx; color: var(--color-text-secondary); margin-bottom: 8rpx; }
.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 16rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  box-sizing: border-box;
}
.form-textarea {
  width: 100%;
  height: 200rpx;
  padding: 16rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  font-size: 24rpx;
  box-sizing: border-box;
}
.switch-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.tips { padding: 24rpx; margin-bottom: 32rpx; }
.tips-title { font-size: 28rpx; font-weight: 600; margin-bottom: 12rpx; }
.tips-item { font-size: 24rpx; color: var(--color-text-secondary); line-height: 1.8; }

.save-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: var(--radius-sm);
  border: none;
}

.success-toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0, 0, 0, 0.7);
  color: #FFFFFF;
  padding: 24rpx 48rpx;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  z-index: 9999;
}
