.ios-browse-page {
  min-height: 100vh;
  background-color: var(--ios-bg);
  padding-bottom: 30rpx;
}

/* ════ 1. 吸顶分类胶囊条 ════ */
.ios-cat-header {
  position: sticky;
  top: 0;
  z-index: 100;
  padding: 20rpx 0 20rpx 28rpx;
}

.cat-scroll {
  width: 100%;
  white-space: nowrap;
}

.cat-pill-list {
  display: inline-flex;
  gap: 16rpx;
  padding-right: 28rpx;
}

.cat-pill {
  padding: 14rpx 28rpx;
  border-radius: var(--radius-full);
  background: rgba(142, 142, 147, 0.12);
  transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.cat-pill-txt {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--ios-text-secondary);
}

.cat-pill--active {
  background: #1D1D1F;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.15);
}

.cat-pill--active .cat-pill-txt {
  color: #FFFFFF;
  font-weight: 600;
}

/* ════ 2. 骨架屏 ════ */
.loading-grid {
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.skeleton-card {
  height: 260rpx;
  border-radius: var(--radius-lg);
}

/* ════ 3. 空状态 ════ */
.ios-empty-view {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 40rpx;
}

.empty-icon-circle {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  background: #EBEBF0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.empty-svg {
  width: 60rpx;
  height: 60rpx;
}

.empty-primary {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ios-text-primary);
  margin-bottom: 8rpx;
}

.empty-secondary {
  font-size: 24rpx;
  color: var(--ios-text-tertiary);
  text-align: center;
}

/* ════ 4. 项目卡片流 ════ */
.project-feed {
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.project-card {
  display: flex;
  background: var(--ios-card);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  box-shadow: var(--ios-shadow-card);
  border: 1rpx solid var(--ios-border);
}

.proj-media-wrap {
  width: 220rpx;
  height: 220rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  position: relative;
  background: #EBEBF0;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.proj-img {
  width: 100%;
  height: 100%;
}

.proj-img-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ph-glyph {
  font-size: 72rpx;
}

.proj-duration-tag {
  position: absolute;
  bottom: 8rpx;
  left: 8rpx;
  background: rgba(0, 0, 0, 0.65);
  color: #FFFFFF;
  font-size: 18rpx;
  padding: 4rpx 10rpx;
  border-radius: var(--radius-sm);
  backdrop-filter: blur(8px);
}

.proj-cat-tag {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  background: rgba(255, 255, 255, 0.9);
  color: var(--ios-text-primary);
  font-size: 18rpx;
  font-weight: 600;
  padding: 4rpx 10rpx;
  border-radius: var(--radius-sm);
  backdrop-filter: blur(8px);
}

.proj-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.proj-headline-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.proj-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ios-text-primary);
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
  letter-spacing: -0.5rpx;
}

.proj-desc {
  font-size: 22rpx;
  color: var(--ios-text-secondary);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin: 8rpx 0 16rpx;
}

.proj-bottom-bar {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.proj-pricing {
  display: flex;
  align-items: baseline;
}

.price-currency {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ios-red);
}

.price-amount {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--ios-red);
  margin: 0 4rpx;
  letter-spacing: -1rpx;
}

.price-sub {
  font-size: 22rpx;
  color: var(--ios-text-tertiary);
}

.book-cta-btn {
  background: var(--ios-red-gradient);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  padding: 12rpx 32rpx;
  border-radius: var(--radius-full);
  box-shadow: var(--ios-shadow-red);
}
