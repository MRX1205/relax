.page {
  background: #F8F9FA;
  min-height: 100vh;
}

/* Hero Section */
.hero-section {
  position: relative;
  padding: 60rpx 32rpx 48rpx;
  background: linear-gradient(135deg, #FF6B6B, #E84545);
  border-radius: 0 0 40rpx 40rpx;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  top: 0;
  right: 0;
  width: 300rpx;
  height: 300rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  transform: translate(30%, -30%);
}

.hero-content {
  position: relative;
  z-index: 1;
}

.hero-tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}

.hero-name {
  font-size: 44rpx;
  font-weight: 800;
  color: #FFFFFF;
  margin-bottom: 24rpx;
}

.hero-meta {
  display: flex;
  gap: 32rpx;
  margin-bottom: 24rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 26rpx;
}

.meta-icon {
  font-size: 28rpx;
}

.hero-price {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.price-symbol {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.price-value {
  font-size: 56rpx;
  font-weight: 800;
  color: #FFFFFF;
}

.price-unit {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-left: 8rpx;
}

/* Cards */
.section {
  padding: 0 32rpx;
  margin-bottom: 24rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 20rpx;
}

.card-icon {
  font-size: 32rpx;
}

.card-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.card-content.notice {
  color: #E67E22;
  background: #FFF8E1;
  padding: 20rpx;
  border-radius: 12rpx;
}

/* Section Header */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

/* Tech List */
.tech-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tech-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.tech-main {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.tech-avatar {
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.tech-avatar-text {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.tech-info {
  flex: 1;
}

.tech-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 8rpx;
}

.tech-meta {
  display: flex;
  gap: 16rpx;
}

.tech-exp {
  font-size: 24rpx;
  color: #666;
}

.tech-price {
  font-size: 36rpx;
  font-weight: 800;
  color: #FF6B6B;
}

.tech-action {
  display: flex;
  justify-content: flex-end;
}

.book-btn {
  padding: 16rpx 40rpx;
  background: linear-gradient(135deg, #FF6B6B, #E84545);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.3);
}

.book-btn:active {
  transform: scale(0.98);
}

/* Empty State */
.empty-state {
  text-align: center;
  padding: 60rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
