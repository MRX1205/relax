.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.add-btn {
  padding: 12rpx 24rpx;
  background: var(--color-primary);
  color: #FFFFFF;
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  font-weight: 600;
}
.form-card {
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.field {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}
.field__label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}
.picker-val {
  font-size: 30rpx;
  min-height: 48rpx;
  display: flex;
  align-items: center;
}
.price-input {
  height: 72rpx;
  font-size: 32rpx;
  font-weight: 600;
}
.form-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
.pricing-list {
  display: grid;
  gap: 16rpx;
}
.pricing-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
}
.pricing-project {
  font-size: 30rpx;
  font-weight: 600;
}
.pricing-detail {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}
.pricing-base {
  color: var(--color-muted);
}
.pricing-delete {
  font-size: 24rpx;
  color: var(--color-danger);
  padding: 8rpx 16rpx;
}
.empty-tip { text-align: center; color: var(--color-muted); padding: 48rpx; }
