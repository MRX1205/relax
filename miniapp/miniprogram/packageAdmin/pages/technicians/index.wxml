<view class="page">
  <view class="tabs">
    <view class="tab {{tab === 'technicians' ? 'tab--active' : ''}}" data-tab="technicians" bindtap="switchTab">技师列表</view>
    <view class="tab {{tab === 'applications' ? 'tab--active' : ''}}" data-tab="applications" bindtap="switchTab">
      待审核
      <view wx:if="{{applications.length > 0}}" class="tab-badge">{{applications.length}}</view>
    </view>
  </view>

  <ui-state wx:if="{{loading}}" title="加载中" kind="loading" />

  <block wx:elif="{{tab === 'technicians'}}">
    <view wx:for="{{technicians}}" wx:key="id" class="surface tech-item">
      <view class="tech-info" data-item="{{item}}" bindtap="goToPricing">
        <view class="tech-name">{{item.serviceName}}</view>
        <view class="tech-meta">{{item.realName}} · {{item.phone}}</view>
        <view class="tech-badges">
          <view class="badge badge--{{item.status}}">{{item.status === 'ACTIVE' ? '正常' : item.status === 'DISABLED' ? '已停用' : '暂停'}}</view>
          <view class="badge badge--{{item.onlineStatus}}">{{item.onlineStatus === 'ONLINE' ? '在线' : '离线'}}</view>
        </view>
      </view>
      <view class="tech-actions">
        <text class="action-link" data-item="{{item}}" bindtap="handleToggleStatus">
          {{item.status === 'ACTIVE' ? '停用' : '启用'}}
        </text>
        <text class="action-link" data-item="{{item}}" bindtap="goToPricing">定价</text>
      </view>
    </view>
    <view wx:if="{{technicians.length === 0}}" class="empty-tip">暂无技师</view>
  </block>

  <block wx:elif="{{tab === 'applications'}}">
    <view wx:for="{{applications}}" wx:key="id" class="surface app-item">
      <view class="app-info">
        <view class="app-name">{{item.serviceName}}</view>
        <view class="app-meta">{{item.realName}} · {{item.phone}} · {{item.experienceYears}}年经验</view>
        <view wx:if="{{item.intro}}" class="app-intro">{{item.intro}}</view>
      </view>
      <view class="app-actions">
        <view class="action-btn action-btn--reject" data-id="{{item.id}}" bindtap="showRejectDialog">拒绝</view>
        <view class="action-btn action-btn--approve" data-id="{{item.id}}" bindtap="handleApprove">通过</view>
      </view>
    </view>
    <view wx:if="{{applications.length === 0}}" class="empty-tip">暂无待审核申请</view>
  </block>

  <!-- Reject dialog -->
  <view wx:if="{{showReject}}" class="dialog-mask" bindtap="hideReject">
    <view class="dialog" catchtap="">
      <view class="dialog-title">拒绝原因</view>
      <textarea class="reject-input" placeholder="请输入拒绝原因（选填）" value="{{rejectReason}}" bindinput="handleRejectReasonInput" />
      <view class="dialog-actions">
        <ui-button label="取消" variant="secondary" bind:action="hideReject" />
        <ui-button label="确认拒绝" bind:action="confirmReject" />
      </view>
    </view>
  </view>
</view>
