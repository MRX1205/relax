.page { padding-bottom: 140rpx; }

.cat-scroll { white-space: nowrap; margin: 0 -32rpx 24rpx; padding: 0 32rpx; }
.cat-list { display: inline-flex; gap: 16rpx; }
.cat-chip { display: inline-flex; padding: 12rpx 28rpx; background: var(--color-surface); border: 1rpx solid var(--color-border); border-radius: 32rpx; font-size: 26rpx; color: var(--color-text-secondary); white-space: nowrap; }
.cat-chip--active { background: var(--color-primary); color: #FFFFFF; border-color: var(--color-primary); }

.project-list { display: flex; flex-direction: column; gap: 20rpx; }
.project-card { overflow: hidden; }
.project-card__cover { position: relative; height: 240rpx; background: linear-gradient(135deg, #FFF1ED, #FFE8E0); display: flex; align-items: center; justify-content: center; }
.project-card__img { width: 100%; height: 100%; }
.project-card__ph { font-size: 64rpx; }
.project-card__cat { position: absolute; top: 16rpx; left: 16rpx; padding: 4rpx 16rpx; background: rgba(0,0,0,0.5); color: #FFFFFF; border-radius: 8rpx; font-size: 22rpx; }
.project-card__info { padding: 20rpx 24rpx; }
.project-card__name { font-size: 30rpx; font-weight: 700; margin-bottom: 12rpx; }
.project-card__meta { display: flex; justify-content: space-between; align-items: center; font-size: 24rpx; color: var(--color-muted); }
.project-card__price { display: flex; align-items: baseline; }
.sym { font-size: 24rpx; color: var(--color-primary); }
.amt { font-size: 36rpx; font-weight: 800; color: var(--color-primary); }
.unit { font-size: 22rpx; color: var(--color-muted); margin-left: 4rpx; }

.order-tabs { display: flex; gap: 0; margin-bottom: 24rpx; background: var(--color-surface); border-radius: 16rpx; overflow: hidden; border: 1rpx solid var(--color-border); }
.order-tab { flex: 1; text-align: center; padding: 20rpx 0; font-size: 26rpx; color: var(--color-text-secondary); }
.order-tab--active { background: var(--color-primary); color: #FFFFFF; font-weight: 600; }

.order-list { display: flex; flex-direction: column; gap: 16rpx; }
.order-card { padding: 24rpx; }
.order-card__head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.order-card__no { font-size: 24rpx; color: var(--color-muted); }
.order-card__status { font-size: 22rpx; font-weight: 600; padding: 4rpx 16rpx; border-radius: 12rpx; background: #E8F5E9; color: #2E7D32; }
.order-card__proj { font-size: 28rpx; font-weight: 600; display: block; margin-bottom: 4rpx; }
.order-card__time { font-size: 24rpx; color: var(--color-text-secondary); }
.order-card__foot { padding-top: 12rpx; border-top: 1rpx solid var(--color-border); margin-top: 12rpx; }
.order-card__amount { font-size: 30rpx; font-weight: 700; color: var(--color-primary); }

.empty { display: flex; flex-direction: column; align-items: center; padding: 120rpx 32rpx; }
.empty__icon { font-size: 80rpx; margin-bottom: 24rpx; }
.empty__text { font-size: 28rpx; color: var(--color-muted); }
