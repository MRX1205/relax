<view class="page">
  <view class="admin-header">
    <view class="admin-header__title">管理工作台</view>
    <view class="admin-header__sub">{{account.nickname}}</view>
  </view>

  <ui-state wx:if="{{loading}}" title="加载中" kind="loading" />

  <block wx:else>
    <!-- Stats overview -->
    <view class="stats-grid">
      <view class="stat-card">
        <view class="stat-card__num">{{stats.todayOrders || 0}}</view>
        <view class="stat-card__label">今日订单</view>
      </view>
      <view class="stat-card">
        <view class="stat-card__num">{{stats.totalOrders || 0}}</view>
        <view class="stat-card__label">总订单</view>
      </view>
      <view class="stat-card">
        <view class="stat-card__num">{{stats.totalUsers || 0}}</view>
        <view class="stat-card__label">用户数</view>
      </view>
      <view class="stat-card">
        <view class="stat-card__num">{{stats.totalTechnicians || 0}}</view>
        <view class="stat-card__label">技师数</view>
      </view>
    </view>

    <!-- Pending actions -->
    <view class="pending-row" wx:if="{{stats.pendingRefunds > 0}}">
      <view class="pending-card" bindtap="goToRefunds">
        <view class="pending-card__icon">↩️</view>
        <view class="pending-card__info">
          <view class="pending-card__title">{{stats.pendingRefunds}} 笔退款待审核</view>
          <view class="pending-card__desc">点击处理</view>
        </view>
        <view class="pending-card__arrow">›</view>
      </view>
    </view>

    <!-- Quick menu -->
    <view class="section-title">管理功能</view>
    <view class="menu-grid">
      <view
        wx:for="{{quickMenus}}"
        wx:key="code"
        class="menu-card surface"
        data-url="{{item.url}}"
        bindtap="handleMenuTap"
      >
        <view class="menu-card__icon">{{item.icon}}</view>
        <view class="menu-card__name">{{item.name}}</view>
        <view class="menu-card__desc">{{item.desc}}</view>
      </view>
    </view>
  </block>
</view>

<custom-tabbar />
