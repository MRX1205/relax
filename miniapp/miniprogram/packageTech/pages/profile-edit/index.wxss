.page {
  background: #F8F9FA;
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  padding-bottom: 140rpx;
}

.form-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 24rpx;
}

.card-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #222222;
  margin-bottom: 24rpx;
}

.card-title-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-title-between .card-title {
  margin-bottom: 0;
}

.title-icon {
  font-size: 32rpx;
}

.photo-tip {
  font-size: 22rpx;
  color: #888888;
}

.view-map-btn {
  font-size: 24rpx;
  color: #1565C0;
  background: #EBF3FE;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

/* Avatar Edit */
.avatar-edit-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0 24rpx;
  border-bottom: 1rpx solid #F5F5F5;
  margin-bottom: 8rpx;
}

.avatar-preview-wrap {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  overflow: hidden;
  border: 4rpx solid #EBEBF0;
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-badge {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.6);
  color: #FFFFFF;
  font-size: 18rpx;
  text-align: center;
  padding: 2rpx 0;
}

.avatar-tip-wrap {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.avatar-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1C1C1E;
}

.avatar-sub {
  font-size: 22rpx;
  color: #8E8E93;
  margin-top: 4rpx;
}

.avatar-arrow {
  font-size: 32rpx;
  color: #C7C7CC;
}

/* Fields */
.field-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.field-label {
  font-size: 28rpx;
  color: #444444;
  font-weight: 600;
}

.field-input {
  font-size: 28rpx;
  color: #222222;
  text-align: right;
  flex: 1;
  padding-left: 20rpx;
}

.text-right {
  text-align: right;
}

.counter-input {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.unit-text {
  font-size: 26rpx;
  color: #888888;
}

.two-col-row {
  display: flex;
  gap: 32rpx;
  padding: 16rpx 0;
}

.flex-1 {
  flex: 1;
}

.field-col {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.field-col .field-input {
  text-align: left;
  padding: 16rpx 20rpx;
  background: #F8F9FA;
  border: 1rpx solid #E5E5E5;
  border-radius: 12rpx;
}

/* Chips & Tags */
.tag-section {
  padding-top: 16rpx;
}

.sub-label {
  display: block;
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 16rpx;
  font-weight: 600;
}

.chips-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  background: #F5F5F5;
  color: #555555;
  font-size: 24rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.chip--active {
  background: #FFF0EB;
  color: #E54D42;
  font-weight: 700;
  border: 1rpx solid #FFCCBC;
}

.add-tag-row {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.tag-input {
  flex: 1;
  height: 68rpx;
  background: #F8F9FA;
  border: 1rpx solid #E5E5E5;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
}

.add-tag-btn {
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 28rpx;
  background: #222222;
  color: #FFFFFF;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
}

/* Location Box */
.location-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #F8F9FA;
  border: 2rpx dashed #D0D0D0;
  border-radius: 16rpx;
  padding: 24rpx;
}

.loc-icon-col {
  font-size: 40rpx;
}

.loc-text-col {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
}

.loc-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #222222;
}

.loc-coords {
  font-size: 22rpx;
  color: #888888;
  font-family: monospace;
}

.loc-tip {
  font-size: 22rpx;
  color: #999999;
}

.loc-arrow {
  font-size: 32rpx;
  color: #AAAAAA;
}

/* Intro Textarea */
.textarea-wrap {
  margin-bottom: 20rpx;
}

.intro-textarea {
  width: 100%;
  height: 180rpx;
  background: #F8F9FA;
  border: 1rpx solid #E5E5E5;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #333333;
  box-sizing: border-box;
}

/* Photo Gallery Grid */
.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.photo-item {
  position: relative;
  width: 100%;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-del-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.65);
  color: #FFFFFF;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.photo-add-btn {
  width: 100%;
  height: 200rpx;
  border: 2rpx dashed #CCCCCC;
  border-radius: 16rpx;
  background: #FAFAFA;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.add-icon {
  font-size: 48rpx;
  color: #888888;
  line-height: 1;
}

.add-text {
  font-size: 22rpx;
  color: #888888;
}

/* Bottom Save Bar */
.bottom-save-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.save-btn {
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #FF7043, #E54D42);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 800;
  border-radius: 44rpx;
  box-shadow: 0 4rpx 16rpx rgba(229, 77, 66, 0.3);
}
