.container {
  padding: 24rpx;
  background: #F4F6F9;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 顶部筛选与导出控制台 */
.filter-panel {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.filter-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.f-tab {
  flex: 1;
  padding: 16rpx 12rpx;
  background: #F2F4F7;
  border-radius: 16rpx;
  font-size: 24rpx;
  text-align: center;
  color: #4B5563;
  font-weight: 600;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.f-tab--active {
  background: #EEF2FF;
  color: #4F46E5;
  border-color: #6366F1;
}

.export-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid #F1F3F5;
}

.filter-label {
  font-size: 24rpx;
  color: #6B7280;
}

.filter-highlight {
  font-weight: 700;
  color: #111827;
}

.export-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #10B981, #059669);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.3);
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 240rpx;
  font-size: 26rpx;
  color: #888888;
}

.section {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1F2937;
  margin-bottom: 20rpx;
}

.section-title-row .section-title {
  margin-bottom: 0;
}

.section-sub-tip {
  font-size: 22rpx;
  color: #4F46E5;
  font-weight: 600;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.stat-card {
  background: #F9FAFB;
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  text-align: center;
  border: 1rpx solid #F3F4F6;
}

.stat-value {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #111827;
  letter-spacing: -0.5rpx;
}

.stat-label {
  display: block;
  font-size: 22rpx;
  color: #6B7280;
  margin-top: 10rpx;
  font-weight: 500;
}

.stats-grid-today .stat-card-today {
  background: #FFFBEB;
  border-color: #FEF3C7;
}

.stats-grid-today .stat-value {
  color: #D97706;
}

.status-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.status-item {
  background: #F3F4F6;
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.status-name {
  font-size: 24rpx;
  color: #4B5563;
}

.status-count {
  font-size: 26rpx;
  font-weight: 700;
  color: #111827;
}

.ranking-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.ranking-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #F9FAFB;
  border-radius: 20rpx;
  border: 1rpx solid #F3F4F6;
}

.ranking-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.ranking-index {
  width: 44rpx;
  height: 44rpx;
  background: #9CA3AF;
  color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
}

.rank-1 { background: #F59E0B; }
.rank-2 { background: #94A3B8; }
.rank-3 { background: #D97706; }

.ranking-tech-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.ranking-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
}

.ranking-tap-hint {
  font-size: 20rpx;
  color: #4F46E5;
}

.ranking-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.ranking-orders {
  font-size: 24rpx;
  color: #6B7280;
}

.ranking-revenue {
  font-size: 28rpx;
  font-weight: 800;
  color: #EF4444;
}

.ranking-arrow {
  font-size: 32rpx;
  color: #9CA3AF;
}

.trend-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.trend-item {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #F9FAFB;
  border-radius: 16rpx;
}

.trend-date {
  flex: 1;
  font-size: 24rpx;
  color: #6B7280;
}

.trend-orders {
  font-size: 26rpx;
  font-weight: 700;
  color: #111827;
  margin-right: 20rpx;
}

.trend-valid {
  font-size: 24rpx;
  color: #10B981;
  font-weight: 600;
}

.empty-tip {
  text-align: center;
  color: #9CA3AF;
  font-size: 26rpx;
  padding: 40rpx 0;
}

/* ════ 技师时段订单弹窗（解耦式遮罩与弹窗） ════ */
.modal-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  z-index: 1;
}

.modal-body {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 680rpx;
  background: #FFFFFF !important;
  border-radius: 36rpx;
  padding: 36rpx 32rpx;
  box-sizing: border-box;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.35);
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F1F3F5;
}

.modal-header-col {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #111827;
}

.modal-sub {
  font-size: 22rpx;
  color: #6B7280;
}

.modal-close {
  font-size: 32rpx;
  color: #9CA3AF;
  padding: 4rpx 12rpx;
}

.modal-loading {
  padding: 80rpx 0;
  text-align: center;
  color: #9CA3AF;
  font-size: 26rpx;
}

.modal-empty-tip {
  padding: 60rpx 0;
  text-align: center;
  color: #9CA3AF;
  font-size: 26rpx;
}

.modal-order-scroll {
  width: 100%;
}

.tech-order-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 6rpx 0;
}

.t-order-card {
  background: #F9FAFB;
  border-radius: 20rpx;
  padding: 20rpx;
  border: 1rpx solid #F3F4F6;
}

.t-order-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #E5E7EB;
}

.t-order-no {
  font-size: 24rpx;
  font-weight: 700;
  color: #374151;
  font-family: monospace;
}

.t-order-status {
  font-size: 22rpx;
  font-weight: 700;
  color: #4F46E5;
  background: #EEF2FF;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

.t-order-body {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.t-order-row {
  display: flex;
  align-items: flex-start;
  font-size: 22rpx;
  line-height: 1.4;
}

.t-label {
  color: #9CA3AF;
  width: 130rpx;
  flex-shrink: 0;
}

.t-val {
  color: #1F2937;
  font-weight: 500;
  flex: 1;
}

.t-val-addr {
  word-break: break-all;
}

.t-val-price {
  color: #EF4444;
  font-weight: 800;
}

.modal-footer-bar {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F1F3F5;
}

.modal-btn-confirm {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #111827;
  color: #FFFFFF;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.ios-touch-active:active {
  opacity: 0.75;
  transform: scale(0.985);
}
