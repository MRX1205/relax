/* ==========================================================================
   Technician Detail — Continuous Unified Apple HIG Modern Aesthetics
   ========================================================================== */

.unified-tech-detail-page {
  background: #F2F2F7;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ════ 1. 沉浸式 Hero 头部 ════ */
.hero-section {
  position: relative;
  height: 640rpx;
  width: 100%;
  background: #1C1C1E;
}

.hero-swiper {
  width: 100%;
  height: 100%;
}

.hero-slide-wrap {
  width: 100%;
  height: 100%;
}

.hero-bg-img {
  width: 100%;
  height: 100%;
}

.hero-ph-view {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #1C1C1E 0%, #3A3A3C 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-ph-char {
  font-size: 160rpx;
  color: rgba(255, 255, 255, 0.35);
  font-weight: 800;
}

.hero-gradient-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 0.4) 0%,
    rgba(0, 0, 0, 0) 35%,
    rgba(0, 0, 0, 0.3) 70%,
    rgba(0, 0, 0, 0.75) 100%
  );
  pointer-events: none;
}

/* 顶部导航浮层 */
.hero-nav-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  padding: calc(env(safe-area-inset-top) + 20rpx) 32rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 10;
  pointer-events: none;
}

.glass-back-pill {
  pointer-events: auto;
  width: 72rpx;
  height: 72rpx;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-char {
  color: #FFFFFF;
  font-size: 52rpx;
  line-height: 1;
  font-weight: 300;
  margin-top: -6rpx;
}

.glass-photo-pill {
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 500;
}

/* 底部姓名与状态浮层 */
.hero-caption-overlay {
  position: absolute;
  bottom: 50rpx;
  left: 32rpx;
  right: 32rpx;
  z-index: 5;
}

.caption-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.caption-service-name {
  font-size: 46rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: -0.5rpx;
}

.status-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 18rpx;
  border-radius: 30rpx;
  font-size: 22rpx;
  font-weight: 600;
  backdrop-filter: blur(15px);
}

.status--online {
  background: rgba(52, 199, 89, 0.3);
  color: #FFFFFF;
  border: 1rpx solid rgba(52, 199, 89, 0.5);
}

.status-pulse-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #34C759;
  box-shadow: 0 0 10rpx #34C759;
}

.status--offline {
  background: rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.85);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.caption-tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.hero-mini-tag {
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(15px);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 500;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

/* ════ 2. 连续统一的主体面板 ════ */
.unified-body-sheet {
  position: relative;
  z-index: 10;
  margin-top: -36rpx;
  background: #FFFFFF;
  border-top-left-radius: 44rpx;
  border-top-right-radius: 44rpx;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.08);
  padding: 32rpx 32rpx 60rpx;
  box-sizing: border-box;
}

/* 核心指标条 */
.metrics-strip {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 24rpx 0 32rpx;
  border-bottom: 1rpx solid #F2F2F7;
}

.metric-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.metric-val-row {
  display: flex;
  align-items: baseline;
}

.metric-figure {
  font-size: 38rpx;
  font-weight: 800;
  color: #1C1C1E;
}

.figure-red {
  color: #FF382E;
}

.metric-unit {
  font-size: 22rpx;
  color: #8E8E93;
  margin-left: 4rpx;
}

.metric-caption {
  font-size: 22rpx;
  color: #8E8E93;
}

.metric-divider {
  width: 1rpx;
  height: 48rpx;
  background: #E5E5EA;
}

.follow-pill {
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
  background: rgba(0, 122, 255, 0.1);
  color: #007AFF;
  font-size: 22rpx;
  font-weight: 700;
}

.follow--active {
  background: #F2F2F7;
  color: #8E8E93;
}

/* 认证背书条 */
.trust-endorse-bar {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F2F2F7;
}

.trust-badge-item {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  background: #F9F9FB;
  padding: 8rpx 18rpx;
  border-radius: 12rpx;
}

.trust-check {
  color: #34C759;
  font-size: 22rpx;
  font-weight: 800;
}

.trust-txt {
  font-size: 22rpx;
  color: #3A3A3C;
  font-weight: 600;
}

/* 统一区块 (Sheet Block) */
.sheet-block {
  padding: 36rpx 0;
  border-bottom: 1rpx solid #F2F2F7;
}

.block-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.b-title-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.b-icon {
  font-size: 32rpx;
}

.b-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1C1C1E;
}

.b-count {
  font-size: 24rpx;
  color: #8E8E93;
}

.b-action-link {
  font-size: 24rpx;
  color: #007AFF;
  font-weight: 600;
}

.b-sub-text {
  font-size: 26rpx;
  color: #636366;
  line-height: 1.5;
}

.b-sub-score {
  font-size: 24rpx;
  color: #FF9500;
  font-weight: 700;
}

.intro-textbox {
  background: #F9F9FB;
  padding: 24rpx;
  border-radius: 20rpx;
}

.intro-content-txt {
  font-size: 26rpx;
  color: #3A3A3C;
  line-height: 1.6;
}

/* 项目连续列表 */
.projects-continuous-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.project-tile-card {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  background: #F9F9FB;
  border-radius: 24rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.03);
}

.tile-cover-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
}

.tile-info-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.tile-title-row {
  margin-bottom: 6rpx;
}

.tile-p-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1C1C1E;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

.tile-tags-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.tile-duration-tag {
  font-size: 20rpx;
  color: #007AFF;
  background: rgba(0, 122, 255, 0.08);
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  font-weight: 600;
}

.tile-feature-tag {
  font-size: 20rpx;
  color: #FF9500;
  background: rgba(255, 149, 0, 0.1);
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}

.tile-bottom-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tile-price-box {
  display: flex;
  align-items: baseline;
}

.tile-currency {
  font-size: 24rpx;
  font-weight: 700;
  color: #FF382E;
}

.tile-amount {
  font-size: 36rpx;
  font-weight: 800;
  color: #FF382E;
  margin-left: 4rpx;
}

.tile-book-btn {
  padding: 10rpx 28rpx;
  background: #C84B31;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(200, 75, 49, 0.25);
}

.empty-project-tip {
  text-align: center;
  padding: 40rpx;
  font-size: 24rpx;
  color: #8E8E93;
}

/* 排期横向滚动胶囊 */
.schedule-dates-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.schedule-dates-row {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx 0;
}

.s-date-pill {
  padding: 14rpx 28rpx;
  background: #F9F9FB;
  border-radius: 28rpx;
  transition: all 0.2s ease;
}

.s-date--active {
  background: #1C1C1E;
}

.s-date-txt {
  font-size: 24rpx;
  color: #636366;
  font-weight: 600;
}

.s-date--active .s-date-txt {
  color: #FFFFFF;
}

.schedule-empty-tip {
  padding: 36rpx 24rpx;
  background: #F9F9FB;
  border-radius: 16rpx;
  text-align: center;
  color: #8E8E93;
  font-size: 26rpx;
}

.schedule-slots-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.s-time-chip {
  padding: 18rpx;
  background: #F9F9FB;
  border-radius: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.st-time {
  font-size: 26rpx;
  font-weight: 700;
  color: #1C1C1E;
}

.st-status {
  font-size: 22rpx;
  color: #34C759;
  font-weight: 600;
}

/* 评价 Feed */
.reviews-feed {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.review-bubble-item {
  padding: 20rpx;
  background: #F9F9FB;
  border-radius: 20rpx;
}

.rb-header {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.rb-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #E5E5EA;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #636366;
  margin-right: 14rpx;
}

.rb-user-meta {
  flex: 1;
}

.rb-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #1C1C1E;
  display: block;
}

.rb-stars {
  display: flex;
  gap: 2rpx;
}

.star-char {
  font-size: 20rpx;
}

.star--gold { color: #FF9500; }
.star--gray { color: #C7C7CC; }

.rb-date {
  font-size: 20rpx;
  color: #8E8E93;
}

.rb-comment {
  font-size: 26rpx;
  color: #3A3A3C;
  line-height: 1.5;
}

.more-reviews-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 0 8rpx;
  margin-top: 12rpx;
  border-top: 1rpx dashed #E5E5EA;
}

.more-reviews-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #007AFF;
}

.more-reviews-arrow {
  font-size: 28rpx;
  color: #007AFF;
}

/* 官方履约保障 */
.guarantee-integrated-card {
  margin-top: 36rpx;
  padding: 28rpx;
  background: linear-gradient(135deg, #FBFBFD 0%, #F5F5F7 100%);
  border-radius: 24rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.g-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.g-head-badge {
  font-size: 40rpx;
}

.g-main-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #1C1C1E;
  display: block;
}

.g-sub-title {
  font-size: 20rpx;
  color: #8E8E93;
  display: block;
  margin-top: 2rpx;
}

.g-quad-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.g-quad-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.g-quad-dot {
  font-size: 14rpx;
  color: #34C759;
}

.g-quad-txt {
  font-size: 22rpx;
  color: #636366;
}

/* ════ 3. 底部悬浮快捷预约栏 ════ */
.sticky-booking-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
  border-top: 1rpx solid rgba(0, 0, 0, 0.08);
  padding: 16rpx 32rpx calc(env(safe-area-inset-bottom) + 16rpx);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  z-index: 100;
}

.bar-left-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}

.bar-icon-box {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F2F2F7;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bar-icon-char {
  font-size: 28rpx;
}

.bar-icon-label {
  font-size: 20rpx;
  color: #636366;
}

.bar-status-col {
  flex-shrink: 0;
}

.bar-online-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.b-on {
  background: rgba(52, 199, 89, 0.12);
  color: #248A3D;
}

.b-on .b-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #34C759;
}

.b-off {
  background: #F2F2F7;
  color: #8E8E93;
}

.b-off .b-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #8E8E93;
}

.bar-right-col {
  flex: 1;
}

.gradient-book-btn {
  height: 84rpx;
  background: linear-gradient(135deg, #1C1C1E 0%, #3A3A3C 100%);
  border-radius: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.2);
}

.btn-main-txt {
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
}

.btn-sub-txt {
  color: #FFD60A;
  font-size: 24rpx;
  font-weight: 700;
}

.ios-touch-active:active {
  opacity: 0.78;
}
