<view class="page">
  <view class="list-header">
    <view class="page-title">轮播图</view>
    <view class="add-btn" bindtap="handleAdd">+ 新增</view>
  </view>

  <view wx:if="{{showForm}}" class="surface form-card">
    <view class="field">
      <text class="field-label">标题</text>
      <input class="field-input" value="{{formTitle}}" placeholder="轮播图标题" bindinput="handleTitleInput" />
    </view>
    <view class="field">
      <text class="field-label">排序</text>
      <input class="field-input" type="number" value="{{formSort}}" placeholder="数字越小越靠前" bindinput="handleSortInput" />
    </view>
    <view class="form-actions">
      <view class="form-btn form-btn--cancel" bindtap="handleCancel">取消</view>
      <view class="form-btn form-btn--save" bindtap="handleSave">保存</view>
    </view>
  </view>

  <ui-state wx:if="{{loading}}" title="加载中" kind="loading" />
  <block wx:else>
    <view wx:if="{{banners.length === 0}}" class="empty-tip">暂无轮播图</view>
    <view class="list">
      <view wx:for="{{banners}}" wx:key="id" class="surface card">
        <view class="card-main">
          <view class="card-title">{{item.title}}</view>
          <view class="card-meta">排序：{{item.sort}}</view>
        </view>
        <view class="card-toggle {{item.status === 'ENABLED' ? 'toggle-on' : 'toggle-off'}}" data-item="{{item}}" bindtap="handleToggle">
          {{item.status === 'ENABLED' ? '启用' : '停用'}}
        </view>
      </view>
    </view>
  </block>
</view>
