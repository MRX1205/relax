/* ==========================================================================
   Admin Project Management — Apple HIG Modern Luxury Aesthetics
   ========================================================================== */

.admin-projects-page {
  min-height: 100vh;
  background: #F2F2F7;
  padding: 24rpx;
  box-sizing: border-box;
  padding-bottom: 80rpx;
}

/* ════ 1. 顶部操作栏 ════ */
.header-bar {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx 24rpx 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.header-main-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.page-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: #1C1C1E;
}

.page-sub {
  display: block;
  font-size: 22rpx;
  color: #8E8E93;
  margin-top: 4rpx;
}

.add-proj-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #1C1C1E;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 700;
  padding: 14rpx 28rpx;
  border-radius: 36rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.18);
}

.plus-icon {
  font-size: 32rpx;
  line-height: 1;
}

/* 搜索框 */
.search-box {
  display: flex;
  align-items: center;
  background: #F2F2F7;
  border-radius: 20rpx;
  padding: 14rpx 20rpx;
  margin-bottom: 20rpx;
}

.search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
  color: #8E8E93;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #1C1C1E;
}

.clear-icon {
  font-size: 26rpx;
  color: #8E8E93;
  padding: 0 10rpx;
}

/* 分类标签横滑 */
.category-scroll {
  width: 100%;
  white-space: nowrap;
}

.cat-chips-row {
  display: inline-flex;
  gap: 14rpx;
  padding: 4rpx 0;
}

.cat-chip {
  padding: 10rpx 26rpx;
  border-radius: 30rpx;
  background: #F2F2F7;
  color: #8E8E93;
  font-size: 24rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.cat-chip--active {
  background: #007AFF;
  color: #FFFFFF;
  box-shadow: 0 2rpx 10rpx rgba(0, 122, 255, 0.25);
}

/* ════ 2. 列表与卡片 ════ */
.proj-feed {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.proj-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.proj-card--off {
  background: #FAFAFC;
  opacity: 0.85;
}

.proj-top-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.cover-box {
  width: 160rpx;
  height: 160rpx;
  border-radius: 18rpx;
  overflow: hidden;
  position: relative;
  flex-shrink: 0;
  background: #E5E5EA;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #1C1C1E, #3A3A3C);
  color: #FFFFFF;
  font-size: 54rpx;
  font-weight: 800;
}

.cat-tag-pill {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.75);
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 600;
  text-align: center;
  padding: 4rpx 0;
}

.proj-info-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.proj-title-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.creator-badge {
  font-size: 18rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  white-space: nowrap;
}

.badge--platform { background: rgba(0, 122, 255, 0.12); color: #007AFF; }
.badge--tech { background: rgba(255, 149, 0, 0.12); color: #D97706; }

.proj-name-txt {
  font-size: 30rpx;
  font-weight: 700;
  color: #1C1C1E;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta-pills-row {
  display: flex;
  gap: 12rpx;
}

.duration-pill, .sort-pill {
  font-size: 20rpx;
  color: #8E8E93;
  background: #F2F2F7;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}

.price-line {
  display: flex;
  align-items: baseline;
}

.currency {
  font-size: 24rpx;
  font-weight: 700;
  color: #FF382E;
}

.price-amount {
  font-size: 36rpx;
  font-weight: 800;
  color: #FF382E;
  margin: 0 4rpx;
}

.unit {
  font-size: 20rpx;
  color: #8E8E93;
}

.desc-line {
  font-size: 22rpx;
  color: #8E8E93;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-col {
  flex-shrink: 0;
}

.shelf-toggle-pill {
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.shelf--on {
  background: rgba(52, 199, 89, 0.15);
  color: #248A3D;
}

.shelf--off {
  background: #F2F2F7;
  color: #8E8E93;
}

/* 对应在线技师展示条 */
.online-techs-container {
  margin: 16rpx 0 14rpx;
  padding: 14rpx 18rpx;
  background: #F8F9FA;
  border-radius: 16rpx;
}

.online-techs-bar {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.techs-tag-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #1D1D1F;
  font-weight: 600;
}

.green-dot {
  color: #34C759;
  font-size: 16rpx;
}

.gray-dot {
  color: #C7C7CC;
  font-size: 16rpx;
}

.techs-pills-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tech-mini-chip {
  background: #FFFFFF;
  border: 1rpx solid rgba(52, 199, 89, 0.3);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.03);
}

.chip-name {
  font-size: 22rpx;
  color: #1D1D1F;
  font-weight: 500;
}

.online-techs-empty {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #8E8E93;
}

/* 操作栏 */
.proj-action-bar {
  display: flex;
  justify-content: flex-end;
  gap: 14rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #F2F2F7;
}

.action-btn {
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.btn--edit {
  background: #F2F2F7;
  color: #1C1C1E;
}

.btn--toggle {
  background: rgba(0, 122, 255, 0.1);
  color: #007AFF;
}

.btn--delete {
  background: #FFF1EE;
  color: #FF382E;
}

/* ════ 空状态 ════ */
.empty-card {
  padding: 80rpx 40rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #FFFFFF;
  border-radius: 28rpx;
}

.empty-emoji {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1C1C1E;
}

.empty-desc {
  font-size: 24rpx;
  color: #8E8E93;
  margin-top: 8rpx;
}

/* ════ 3. 弹窗样式 ════ */
.modal-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100000 !important;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65) !important;
  z-index: 1;
}

.modal-sheet {
  position: relative;
  z-index: 2;
  width: 100%;
  max-height: 85vh;
  background: #FFFFFF !important;
  background-color: #FFFFFF !important;
  opacity: 1 !important;
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
  padding: 36rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  box-sizing: border-box;
  box-shadow: 0 -12rpx 48rpx rgba(0, 0, 0, 0.35) !important;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1C1C1E;
}

.modal-sub {
  font-size: 22rpx;
  color: #8E8E93;
  margin-top: 4rpx;
  display: block;
}

.modal-close-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #F2F2F7;
  color: #8E8E93;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}

.modal-form-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.form-row {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.form-dual-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.dual-col {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.f-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #1C1C1E;
}

.modal-form-scroll {
  max-height: 62vh;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding: 4rpx 2rpx 20rpx;
}


.req {
  color: #FF382E;
}

.f-input {
  height: 84rpx;
  line-height: 84rpx;
  background: #FFFFFF !important;
  border: 2rpx solid #E5E5EA !important;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1C1C1E !important;
  box-sizing: border-box;
}

.f-input:focus {
  border-color: #007AFF !important;
}

.f-textarea {
  width: 100%;
  height: 160rpx;
  background: #FFFFFF !important;
  border: 2rpx solid #E5E5EA !important;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #1C1C1E !important;
  box-sizing: border-box;
}

.f-textarea:focus {
  border-color: #007AFF !important;
}

.picker-box {
  height: 84rpx;
  background: #FFFFFF !important;
  border: 2rpx solid #E5E5EA !important;
  border-radius: 16rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.picker-txt--selected {
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1C1E;
}

.picker-txt--ph {
  font-size: 28rpx;
  color: #8E8E93;
}

.picker-arrow {
  color: #8E8E93;
  font-size: 32rpx;
}

.cover-uploader {
  width: 100%;
  height: 200rpx;
  border-radius: 20rpx;
  background: #F2F2F7;
  border: 2rpx dashed #C7C7CC;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.cover-preview-img {
  width: 100%;
  height: 100%;
}

.uploader-ph {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.ph-camera {
  font-size: 48rpx;
}

.ph-txt {
  font-size: 24rpx;
  color: #8E8E93;
}

.modal-footer-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 36rpx;
}

.m-cancel-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 20rpx;
  background: #F2F2F7;
  color: #636366;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.m-submit-btn {
  flex: 2;
  height: 84rpx;
  border-radius: 20rpx;
  background: #1C1C1E;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
