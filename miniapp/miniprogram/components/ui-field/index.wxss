.field__label {
  margin-bottom: 12rpx;
  color: var(--color-text, #1D1D1F);
  font-size: 28rpx;
  font-weight: 600;
}

.field__required,
.field__error {
  color: var(--color-danger, #FF382E);
}

.field__required {
  margin-right: 4rpx;
}

.field__input {
  min-height: 88rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  background: #FFFFFF;
  color: #1D1D1F;
  border: 1rpx solid var(--color-border, #E5E5EA);
  border-radius: 12rpx;
}

.field__input--error {
  border-color: var(--color-danger, #FF382E);
}

.field__error {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

