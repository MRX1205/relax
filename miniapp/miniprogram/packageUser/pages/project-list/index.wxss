.cat-bar {
  margin-bottom: 24rpx;
  white-space: nowrap;
}
.cat-chips {
  display: inline-flex;
  gap: 12rpx;
}
.cat-chip {
  display: inline-flex;
  padding: 12rpx 24rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 28rpx;
  font-size: 24rpx;
  white-space: nowrap;
  transition: all 0.2s;
}
.cat-chip--active {
  background: var(--color-primary);
  color: #FFFFFF;
  border-color: var(--color-primary);
  box-shadow: 0 4rpx 12rpx rgba(200, 75, 49, 0.3);
}
.proj-list {
  display: grid;
  gap: 16rpx;
}
.proj-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx;
  background: var(--color-surface);
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.proj-card__left {
  flex: 1;
  min-width: 0;
}
.proj-card__tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  background: #FFF1ED;
  color: var(--color-primary);
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.proj-card__name {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}
.proj-card__meta {
  font-size: 22rpx;
  color: var(--color-muted);
}
.proj-card__right {
  text-align: right;
  flex-shrink: 0;
  margin-left: 24rpx;
}
.proj-card__price {
  color: var(--color-primary);
  margin-bottom: 12rpx;
}
.proj-card__symbol {
  font-size: 24rpx;
}
.proj-card__amount {
  font-size: 36rpx;
  font-weight: 800;
}
.proj-card__action {
  display: inline-block;
  padding: 10rpx 28rpx;
  background: var(--color-primary);
  color: #FFFFFF;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 600;
}
.empty-wrap { padding-top: 80rpx; }
