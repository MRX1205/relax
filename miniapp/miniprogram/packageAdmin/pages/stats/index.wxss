.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 200rpx;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.stat-card {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #ff6b6b;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
}

.status-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.status-item {
  background: #f8f9fa;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.status-name {
  font-size: 24rpx;
  color: #666;
}

.status-count {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.ranking-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ranking-item {
  display: flex;
  align-items: center;
  padding: 16rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
}

.ranking-index {
  width: 40rpx;
  height: 40rpx;
  background: #ff6b6b;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  margin-right: 16rpx;
}

.ranking-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.ranking-orders {
  font-size: 24rpx;
  color: #666;
  margin-right: 16rpx;
}

.ranking-revenue {
  font-size: 28rpx;
  font-weight: bold;
  color: #ff6b6b;
}

.trend-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.trend-item {
  display: flex;
  align-items: center;
  padding: 16rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
}

.trend-date {
  flex: 1;
  font-size: 24rpx;
  color: #666;
}

.trend-orders {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-right: 16rpx;
}

.trend-valid {
  font-size: 24rpx;
  color: #52c41a;
}
