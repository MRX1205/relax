.phone-card {
  padding: 48rpx 32rpx;
  margin-top: 40rpx;
}

.error-banner {
  margin-bottom: 24rpx;
  padding: 16rpx 20rpx;
  background: #FFF5F5;
  border: 1rpx solid #FFCDD2;
  border-radius: var(--radius-sm);
  color: var(--color-danger);
  font-size: 24rpx;
}

.phone-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  background: var(--color-primary);
  color: #FFFFFF;
  border-radius: var(--radius-sm);
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.phone-btn::after {
  display: none;
}

.skip {
  margin-top: 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-muted);
}
