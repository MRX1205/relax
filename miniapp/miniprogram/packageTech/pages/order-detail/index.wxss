.status-banner { padding: 32rpx; margin-bottom: 24rpx; }
.status-banner--PAID { background: #FFF8F0; }
.status-banner--ACCEPTED, .status-banner--DEPARTED, .status-banner--ARRIVED { background: #FFF1ED; }
.status-banner--IN_SERVICE { background: #EDF8F3; }
.status-banner--COMPLETED { background: #EDF8F3; }
.status-text { font-size: 36rpx; font-weight: 700; }
.status-no { font-size: 24rpx; color: var(--color-text-secondary); margin-top: 8rpx; }
.info-card { padding: 24rpx; margin-bottom: 16rpx; }
.info-title { font-size: 28rpx; font-weight: 700; margin-bottom: 16rpx; }
.info-row { display: flex; justify-content: space-between; padding: 8rpx 0; font-size: 26rpx; }
.info-total { font-size: 28rpx; font-weight: 700; }
.info-total text:last-child { color: var(--color-primary); }
.log-item { padding: 8rpx 0; border-bottom: 1rpx solid var(--color-border); }
.log-item:last-child { border-bottom: none; }
.log-status { font-size: 26rpx; font-weight: 600; }
.log-meta { font-size: 22rpx; color: var(--color-muted); margin-top: 4rpx; }
.action-bar { display: flex; gap: 16rpx; margin-top: 32rpx; }
.action-btn { flex: 1; padding: 20rpx; border-radius: var(--radius-sm); text-align: center; font-size: 28rpx; font-weight: 600; }
.action-btn--primary { background: var(--color-primary); color: #FFFFFF; }
.action-btn--danger { background: #FFF5F5; color: var(--color-danger); border: 1rpx solid #FFCDD2; }
