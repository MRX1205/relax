.project-edit-page {
  min-height: 100vh;
  background: #F6F7F9;
  padding: 32rpx 32rpx 160rpx;
  box-sizing: border-box;
}

.edit-header {
  margin-bottom: 32rpx;
}

.header-tag {
  font-size: 20rpx;
  font-weight: 800;
  color: #E54D42;
  letter-spacing: 2rpx;
  display: block;
  margin-bottom: 6rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1C1C1E;
  display: block;
  margin-bottom: 10rpx;
}

.header-sub {
  font-size: 24rpx;
  color: #8E8E93;
}

.form-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1C1C1E;
  margin-bottom: 24rpx;
  border-left: 6rpx solid #E54D42;
  padding-left: 14rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 26rpx;
  color: #333333;
  font-weight: 600;
  margin-bottom: 12rpx;
  display: block;
}

.req {
  color: #E54D42;
}

.form-input {
  height: 88rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1A1A1A;
  border: 2rpx solid #E5E5EA;
  box-sizing: border-box;
}

.price-input-wrap {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 88rpx;
  border: 2rpx solid #E5E5EA;
  box-sizing: border-box;
}

.price-prefix {
  font-size: 32rpx;
  font-weight: 700;
  color: #E54D42;
  margin-right: 12rpx;
}

.price-input {
  background: transparent;
  border: none;
  padding: 0;
  flex: 1;
}

.picker-value-box {
  height: 88rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 2rpx solid #E5E5EA;
  box-sizing: border-box;
}

.picker-txt {
  font-size: 28rpx;
  color: #1A1A1A;
}

.placeholder-txt {
  color: #999999;
}

.picker-arrow {
  font-size: 32rpx;
  color: #C7C7CC;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: #1A1A1A;
  box-sizing: border-box;
  border: 2rpx solid #E5E5EA;
}


.form-switch-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
}

.switch-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.switch-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1C1E;
}

.switch-desc {
  font-size: 22rpx;
  color: #8E8E93;
}

.bottom-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.save-submit-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #E54D42, #FF7043);
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(229, 77, 66, 0.35);
}
