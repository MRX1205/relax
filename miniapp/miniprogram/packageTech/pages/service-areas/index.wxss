.page {
  padding: 32rpx;
  background: #F5F6F8;
  min-height: 100vh;
}

.header-box {
  margin-bottom: 28rpx;
}

.page-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 24rpx;
  color: #888888;
  line-height: 1.5;
}

.actions-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

.select-hint {
  font-size: 24rpx;
  color: #666666;
}

.select-all-btn {
  font-size: 24rpx;
  color: #E54D42;
  font-weight: 600;
}

.area-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 40rpx;
}

.area-card {
  background: #FFFFFF;
  border-radius: 18rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.area-card--active {
  border-color: #E54D42;
  background: #FFFDFC;
}

.area-check-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #DCDFE6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 700;
}

.area-card--active .area-check-dot {
  background: #E54D42;
  border-color: #E54D42;
}

.area-info {
  display: flex;
  flex-direction: column;
}

.area-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 4rpx;
}

.area-status-txt {
  font-size: 22rpx;
  color: #999999;
}

.save-bar {
  margin-top: 20rpx;
}

.save-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  background: linear-gradient(135deg, #E54D42, #FF7043);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 46rpx;
  box-shadow: 0 6rpx 20rpx rgba(229, 77, 66, 0.35);
  border: none;
}
