<view class="ios-tech-browse-page">

  <view wx:if="{{loading}}" class="loading-feed">
    <view class="ios-skeleton skeleton-card" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
  </view>

  <!-- ════ USER: 技师列表 ════ -->
  <block wx:elif="{{role === 'USER'}}">
    <!-- 顶部 iOS 药丸筛选条 -->
    <view class="filter-bar-header ios-blur">
      <view class="filter-pills-row">
        <view
          class="filter-pill {{sortBy === 'default' ? 'filter-pill--active' : ''}} ios-touch-active"
          data-sort="default"
          bindtap="switchSort"
        >
          <text>综合推荐</text>
        </view>
        <view
          class="filter-pill {{sortBy === 'rating' ? 'filter-pill--active' : ''}} ios-touch-active"
          data-sort="rating"
          bindtap="switchSort"
        >
          <text>评分最高</text>
        </view>
        <view
          class="filter-pill {{sortBy === 'price' ? 'filter-pill--active' : ''}} ios-touch-active"
          data-sort="price"
          bindtap="switchSort"
        >
          <text>价格优惠</text>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{technicians.length === 0}}" class="ios-empty-view">
      <view class="empty-icon-circle">
        <image class="empty-svg" src="/assets/tabbar/technicians.png" mode="aspectFit" />
      </view>
      <text class="empty-primary">暂无可约技师</text>
      <text class="empty-secondary">正在调配更多优质技师为您服务</text>
    </view>

    <!-- 技师列表 -->
    <view wx:else class="tech-feed">
      <view
        wx:for="{{technicians}}"
        wx:key="id"
        class="tech-card ios-card ios-touch-active"
        data-id="{{item.id}}"
        bindtap="goToTechDetail"
      >
        <view class="tech-top-row">
          <!-- 头像与在线绿点 -->
          <view class="avatar-box">
            <image src="{{item.displayAvatar || item.avatarUrl || '/assets/images/tech-wang.jpg'}}" mode="aspectFill" class="avatar-img" />
            <view class="status-dot {{item.onlineStatus === 'ONLINE' ? 'status-dot--on' : 'status-dot--off'}}"></view>
          </view>

          <!-- 技师核心资料 -->
          <view class="info-box">
            <view class="name-line">
              <text class="service-name">{{item.serviceName}}</text>
              <view class="verify-badge">
                <image class="shield-svg" src="/assets/icons/shield.png" mode="aspectFit" />
                <text>实名</text>
              </view>
              <view class="online-tag {{item.onlineStatus === 'ONLINE' ? 'tag--online' : 'tag--offline'}}">
                {{item.onlineStatus === 'ONLINE' ? '接单中' : '休息中'}}
              </view>
            </view>

            <view class="badges-line">
              <view class="star-rating">
                <text class="star-char">★</text>
                <text class="star-val">4.9</text>
              </view>
              <text class="dot-separator">•</text>
              <text class="stat-text">{{item.experienceYears || 5}}年经验</text>
              <text class="dot-separator">•</text>
              <text class="stat-text">已服务 800+ 单</text>
            </view>

            <text class="intro-snippet">{{item.intro || '手法细腻专业，擅长全身放松与深层肌肉理疗。'}}</text>
          </view>
        </view>

        <!-- 技师真实风采生活照缩略图 -->
        <view wx:if="{{item.displayPhotos.length > 0}}" class="tech-photos-strip">
          <image
            wx:for="{{item.displayPhotos}}"
            wx:key="*this"
            wx:for-item="photo"
            wx:for-index="pi"
            wx:if="{{pi < 4}}"
            class="strip-photo-img"
            src="{{photo}}"
            mode="aspectFill"
          />
        </view>

        <!-- 底部价格与行动条 -->
        <view class="card-footer-row">
          <view class="pricing-group">
            <text class="currency-sign">¥</text>
            <text class="start-price">{{item.startPrice || 168}}</text>
            <text class="price-suffix">起</text>
          </view>
          <view class="action-book-btn">去预约 ›</view>
        </view>
      </view>
    </view>
  </block>

  <view class="safe-bottom-bar"></view>
</view>

<custom-tabbar />
