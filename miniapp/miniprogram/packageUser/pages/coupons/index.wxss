.page { padding: 24rpx; }

.tabs {
  display: flex;
  margin-bottom: 24rpx;
  background: var(--color-surface);
  border-radius: var(--radius-md);
  overflow: hidden;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: var(--color-text-secondary);
}
.tab--active {
  background: var(--color-primary);
  color: #FFFFFF;
  font-weight: 600;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.empty__icon { font-size: 80rpx; margin-bottom: 24rpx; }
.empty__text { font-size: 28rpx; color: var(--color-muted); }

.coupon-list { display: flex; flex-direction: column; gap: 16rpx; }
.coupon-card {
  display: flex;
  padding: 0;
  overflow: hidden;
}
.coupon-used { opacity: 0.6; }

.coupon-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  background: var(--color-primary);
  color: #FFFFFF;
  padding: 24rpx;
}
.coupon-amount { font-size: 48rpx; font-weight: 800; }
.coupon-condition { font-size: 22rpx; margin-top: 8rpx; opacity: 0.8; }

.coupon-right {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.coupon-name { font-size: 28rpx; font-weight: 600; margin-bottom: 8rpx; }
.coupon-info { font-size: 22rpx; color: var(--color-muted); margin-bottom: 12rpx; }

.claim-btn {
  width: 160rpx;
  height: 56rpx;
  line-height: 56rpx;
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: 24rpx;
  border-radius: var(--radius-sm);
  border: none;
  padding: 0;
}
.claim-btn[disabled] {
  background: var(--color-muted);
  color: #FFFFFF;
}

.coupon-status { margin-top: 8rpx; }
.status-available { color: var(--color-success); font-size: 24rpx; font-weight: 600; }
.status-locked { color: var(--color-warning); font-size: 24rpx; }
.status-used { color: var(--color-muted); font-size: 24rpx; }
.status-expired { color: var(--color-muted); font-size: 24rpx; }
