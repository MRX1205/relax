.ios-account-page {
  min-height: 100vh;
  background-color: var(--ios-bg);
  padding-top: 24rpx;
  padding-bottom: 30rpx;
}

/* ════ 1. 个人资料头部卡片 ════ */
.profile-hero-card {
  margin: 0 32rpx 24rpx;
  padding: 36rpx 32rpx;
}

.profile-main-row {
  display: flex;
  align-items: center;
}

.avatar-container {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  flex-shrink: 0;
  margin-right: 28rpx;
}

.user-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 8rpx 24rpx -4rpx rgba(0, 0, 0, 0.12);
}

.user-avatar--placeholder {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF382E 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-letter {
  font-size: 52rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.avatar-badge {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 38rpx;
  height: 38rpx;
  background: #1D1D1F;
  border-radius: 50%;
  border: 3rpx solid #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.badge-cam {
  width: 20rpx;
  height: 20rpx;
}

.profile-text-col {
  flex: 1;
  min-width: 0;
}

.name-display-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.user-nickname {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--ios-text-primary);
  margin-right: 12rpx;
  letter-spacing: -0.5rpx;
}

.edit-pencil-svg {
  width: 28rpx;
  height: 28rpx;
}

.edit-nickname-box {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.edit-input {
  flex: 1;
  height: 64rpx;
  background: #F2F2F7;
  border-radius: 12rpx;
  padding: 0 16rpx;
  font-size: 28rpx;
  margin-right: 12rpx;
}

.save-chip {
  padding: 8rpx 20rpx;
  background: #1D1D1F;
  color: #FFFFFF;
  font-size: 22rpx;
  border-radius: 20rpx;
}

.phone-chip-row {
  margin-bottom: 12rpx;
}

.phone-number {
  font-size: 24rpx;
  color: var(--ios-text-secondary);
}

.phone-link {
  font-size: 24rpx;
  color: #007AFF;
  font-weight: 500;
}

.role-pill-tags {
  display: flex;
  gap: 10rpx;
}

.role-pill {
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 14rpx;
  border-radius: var(--radius-full);
}

.pill-user {
  background: #EBEBF0;
  color: #6E6E73;
}

.pill-tech {
  background: #E8F8EE;
  color: #34C759;
}

.pill-admin {
  background: #FEF3C7;
  color: #D97706;
}

/* ════ 2. 统计资产卡片 ════ */
.stats-bar-card {
  margin: 0 32rpx 24rpx;
  padding: 28rpx 0;
  display: flex;
  align-items: center;
}

.stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.stat-figure {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--ios-text-primary);
  margin-bottom: 4rpx;
  letter-spacing: -0.5rpx;
}

.figure-red {
  color: var(--ios-red);
}

.stat-caption {
  font-size: 22rpx;
  color: var(--ios-text-tertiary);
  font-weight: 500;
}

.stat-vert-line {
  width: 1rpx;
  height: 48rpx;
  background: var(--ios-border);
}

/* ════ 3. Apple Wallet 风格 VIP 黑金卡 ════ */
.vip-card-banner {
  margin: 0 32rpx 24rpx;
  background: linear-gradient(135deg, #2D2723 0%, #1A1715 100%);
  border-radius: var(--radius-lg);
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 8rpx 24rpx -4rpx rgba(45, 39, 35, 0.4);
}

.vip-left-wrap {
  display: flex;
  align-items: center;
}

.vip-crown-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.vip-text-wrap {
  display: flex;
  flex-direction: column;
}

.vip-head {
  font-size: 28rpx;
  font-weight: 700;
  color: #FFE6A0;
  margin-bottom: 4rpx;
  letter-spacing: 0.5rpx;
}

.vip-subline {
  font-size: 20rpx;
  color: rgba(255, 230, 160, 0.75);
}

.vip-cta-pill {
  font-size: 22rpx;
  font-weight: 600;
  color: #1A1715;
  background: linear-gradient(135deg, #FFEAB5 0%, #FFD07A 100%);
  padding: 10rpx 22rpx;
  border-radius: var(--radius-full);
}

/* ════ 4 & 5. 身份专区卡片 ════ */
.portal-card {
  margin: 0 32rpx 24rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.portal-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.portal-icon-bg {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.icon-bg-green {
  background: #E8F8EE;
}

.icon-bg-gold {
  background: #FEF3C7;
}

.portal-text-box {
  display: flex;
  flex-direction: column;
}

.portal-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ios-text-primary);
  margin-bottom: 4rpx;
}

.portal-desc {
  font-size: 20rpx;
  color: var(--ios-text-tertiary);
}

.portal-btn {
  font-size: 22rpx;
  font-weight: 600;
  padding: 10rpx 24rpx;
  border-radius: var(--radius-full);
  margin-left: 16rpx;
  flex-shrink: 0;
}

.btn-green {
  background: #34C759;
  color: #FFFFFF;
}

.btn-gold {
  background: #D97706;
  color: #FFFFFF;
}

/* ════ 6. iOS Inset Grouped TableView ════ */
.cell-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.cell-svg {
  width: 36rpx;
  height: 36rpx;
  display: block;
}

.icon-blue { background: rgba(0, 122, 255, 0.1); }
.icon-green { background: rgba(52, 199, 89, 0.1); }
.icon-orange { background: rgba(255, 149, 0, 0.1); }
.icon-red { background: rgba(255, 56, 46, 0.1); }
.icon-purple { background: rgba(175, 82, 222, 0.1); }
.icon-dark { background: rgba(29, 29, 31, 0.1); }
.icon-teal { background: rgba(48, 176, 199, 0.1); }

.cell-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ios-text-primary);
  flex: 1;
}

.cell-label-plain {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ios-text-primary);
  flex: 1;
}

.cell-badge {
  font-size: 20rpx;
  background: #FFE8E6;
  color: #FF382E;
  font-weight: 600;
  padding: 2rpx 12rpx;
  border-radius: var(--radius-full);
  margin-right: 8rpx;
}

.cell-tag {
  font-size: 20rpx;
  background: #E8F8EE;
  color: #34C759;
  font-weight: 600;
  padding: 2rpx 12rpx;
  border-radius: var(--radius-full);
  margin-right: 8rpx;
}

.cell-chevron {
  font-size: 36rpx;
  color: #C7C7CC;
  line-height: 1;
}

/* ════ 8. 退出登录 ════ */
.logout-container {
  padding: 32rpx 32rpx 60rpx;
}

.logout-btn {
  background: #FFFFFF;
  border-radius: var(--radius-lg);
  box-shadow: var(--ios-shadow-card);
  border: 1rpx solid var(--ios-border);
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logout-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ios-red);
}

/* ════ 管理员 2FA PIN 弹窗 ════ */
.admin-modal-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.admin-auth-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  z-index: 1;
}

.admin-auth-dialog {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 600rpx;
  background: #FFFFFF !important;
  background-color: #FFFFFF !important;
  opacity: 1 !important;
  border-radius: 36rpx;
  padding: 44rpx 36rpx;
  box-sizing: border-box;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.35);
}

.dialog-head {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.d-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.d-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ios-text-primary);
}

.d-subtitle {
  font-size: 24rpx;
  color: var(--ios-text-secondary);
  line-height: 1.4;
  margin-bottom: 32rpx;
}

.pin-input-wrap {
  margin-bottom: 36rpx;
}

.pin-input {
  height: 84rpx;
  background: #F2F2F7;
  border-radius: 18rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  letter-spacing: 6rpx;
  text-align: center;
}

.d-actions {
  display: flex;
  gap: 20rpx;
}

.d-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: var(--radius-full);
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.btn-cancel {
  background: #EBEBF0;
  color: #6E6E73;
}

.btn-confirm {
  background: #1D1D1F;
  color: #FFFFFF;
}

/* ════ 专属在线客服弹窗 (Apple Inset Sheet) ════ */
.customer-sheet {
  width: 100%;
  max-height: 85vh;
  background: #FFFFFF !important;
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
  padding: 36rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  box-sizing: border-box;
  box-shadow: 0 -12rpx 48rpx rgba(0, 0, 0, 0.28) !important;
  position: relative;
  z-index: 100001 !important;
}

.customer-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.cs-head-icon {
  font-size: 44rpx;
  margin-right: 16rpx;
}

.cs-head-text {
  flex: 1;
}

.cs-head-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1C1C1E;
  display: block;
}

.cs-head-sub {
  font-size: 22rpx;
  color: #8E8E93;
  margin-top: 4rpx;
  display: block;
}

.cs-close-btn {
  font-size: 32rpx;
  color: #8E8E93;
  padding: 8rpx 16rpx;
}

.cs-card-item {
  background: #F8F9FA;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid rgba(0,0,0,0.04);
}

.cs-card-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.cs-card-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.icon-phone {
  background: #E8F5E9;
}

.icon-wechat {
  background: #E3F2FD;
}

.cs-card-info {
  display: flex;
  flex-direction: column;
}

.cs-card-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #1C1C1E;
}

.cs-card-val {
  font-size: 30rpx;
  font-weight: 800;
  color: #007AFF;
  margin-top: 4rpx;
}

.cs-card-desc {
  font-size: 20rpx;
  color: #8E8E93;
  margin-top: 4rpx;
}

.cs-action-btn {
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.btn-call {
  background: #34C759;
  color: #FFFFFF;
}

.cs-qr-card {
  flex-direction: column;
  align-items: stretch;
  gap: 16rpx;
}

.cs-qr-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.cs-qr-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}

.cs-qr-image {
  width: 280rpx;
  height: 280rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  border: 1rpx solid #E5E5EA;
}

.cs-qr-hint {
  font-size: 20rpx;
  color: #8E8E93;
  margin-top: 12rpx;
}

.save-qr-pill {
  margin-top: 16rpx;
  padding: 12rpx 32rpx;
  border-radius: 30rpx;
  background: #007AFF;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
}

.cs-qr-empty {
  padding: 24rpx;
  text-align: center;
}

.cs-empty-text {
  font-size: 22rpx;
  color: #8E8E93;
}

.sheet-done-btn {
  margin-top: 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: #1C1C1E;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
}
