.search-page {
  min-height: 100vh;
  background: #F6F7F9;
  display: flex;
  flex-direction: column;
}

.search-bar-wrap {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  background: #FFFFFF;
  gap: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
}

.search-input-box {
  flex: 1;
  height: 80rpx;
  background: #F4F5F7;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A1A;
}

.clear-icon {
  font-size: 28rpx;
  color: #999999;
  padding: 8rpx;
}

.cancel-btn {
  font-size: 28rpx;
  color: #666666;
  font-weight: 500;
}

.recommend-box {
  padding: 32rpx;
}

.recommend-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #666666;
  margin-bottom: 20rpx;
}

.tag-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip-tag {
  padding: 12rpx 28rpx;
  background: #FFFFFF;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #333333;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.search-tabs {
  display: flex;
  background: #FFFFFF;
  border-bottom: 1rpx solid #EEEEEE;
  padding: 0 16rpx;
}

.tab-item {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #666666;
  position: relative;
}

.tab-item--active {
  color: #E54D42;
  font-weight: 700;
}

.tab-item--active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 25%;
  right: 25%;
  height: 4rpx;
  background: #E54D42;
  border-radius: 2rpx;
}

.result-scroll {
  flex: 1;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
}

.section-group {
  margin-bottom: 36rpx;
}

.section-header {
  margin-bottom: 16rpx;
}

.sec-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #1C1C1E;
}

.project-list, .tech-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.project-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  gap: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.p-media {
  width: 160rpx;
  height: 160rpx;
  border-radius: 18rpx;
  overflow: hidden;
  position: relative;
  flex-shrink: 0;
}

.p-img {
  width: 100%;
  height: 100%;
}

.p-cat {
  position: absolute;
  bottom: 8rpx;
  left: 8rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #FFFFFF;
  font-size: 18rpx;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}

.p-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.p-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.p-desc {
  font-size: 22rpx;
  color: #8E8E93;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.p-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.p-price {
  display: flex;
  align-items: baseline;
}

.symbol {
  font-size: 24rpx;
  font-weight: 700;
  color: #E54D42;
}

.amount {
  font-size: 36rpx;
  font-weight: 800;
  color: #E54D42;
  margin: 0 4rpx;
}

.unit {
  font-size: 20rpx;
  color: #999999;
}

.p-cta {
  padding: 8rpx 24rpx;
  background: linear-gradient(135deg, #E54D42, #FF7043);
  color: #FFFFFF;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.tech-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  display: flex;
  gap: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.tech-avatar-wrap {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
}

.tech-avatar {
  width: 100%;
  height: 100%;
  border-radius: 60rpx;
}

.tech-status-dot {
  position: absolute;
  bottom: 4rpx;
  right: 4rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 10rpx;
  border: 3rpx solid #FFFFFF;
}

.dot-online { background: #34C759; }
.dot-offline { background: #8E8E93; }

.tech-info {
  flex: 1;
  min-width: 0;
}

.tech-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.tech-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1C1C1E;
}

.online-tag {
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.tag-online {
  background: rgba(52, 199, 89, 0.12);
  color: #248A3D;
}

.tag-offline {
  background: rgba(142, 142, 147, 0.12);
  color: #8E8E93;
}

.tech-meta {
  display: flex;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.exp-tag, .auth-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: #F0F2F5;
  color: #666666;
}

.auth-tag {
  background: #FFF0ED;
  color: #E54D42;
}

.tech-intro {
  font-size: 22rpx;
  color: #8E8E93;
  line-height: 1.4;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.tech-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.price-txt {
  font-size: 22rpx;
  color: #666666;
}

.price-bold {
  font-size: 32rpx;
  font-weight: 800;
  color: #E54D42;
}

.tech-cta {
  padding: 8rpx 24rpx;
  background: #F4F5F7;
  color: #333333;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 600;
}
