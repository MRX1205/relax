.page {
  background: #F8F9FA;
  min-height: 100vh;
}

/* Hero Section */
.hero-section {
  position: relative;
  padding: 60rpx 32rpx 48rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 0 0 40rpx 40rpx;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  top: 0;
  right: 0;
  width: 300rpx;
  height: 300rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  transform: translate(30%, -30%);
}

.hero-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.hero-avatar {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
}

.hero-avatar-text {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.online-dot {
  position: absolute;
  bottom: 4rpx;
  right: 4rpx;
  width: 24rpx;
  height: 24rpx;
  background: #4CAF50;
  border-radius: 50%;
  border: 4rpx solid #FFFFFF;
}

.hero-info {
  flex: 1;
}

.hero-name {
  font-size: 36rpx;
  font-weight: 800;
  color: #FFFFFF;
  margin-bottom: 12rpx;
}

.hero-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.meta-dot {
  color: rgba(255, 255, 255, 0.5);
}

.status-online {
  color: #90EE90;
}

.status-offline {
  color: rgba(255, 255, 255, 0.7);
}

/* Cards */
.section {
  padding: 0 32rpx;
  margin-bottom: 24rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 20rpx;
}

.card-icon {
  font-size: 32rpx;
}

.card-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

/* Section Header */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

/* Project List */
.project-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.project-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.project-info {
  flex: 1;
}

.project-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.project-duration {
  font-size: 24rpx;
  color: #666;
}

.project-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.project-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #FF6B6B;
}

.book-btn {
  padding: 12rpx 32rpx;
  background: linear-gradient(135deg, #FF6B6B, #E84545);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 32rpx;
  border: none;
}

/* Date Selection */
.date-scroll {
  margin: 0 -32rpx;
  padding: 0 32rpx;
  margin-bottom: 20rpx;
}

.date-grid {
  display: inline-flex;
  gap: 16rpx;
  padding: 8rpx 0;
}

.date-item {
  padding: 16rpx 24rpx;
  background: #FFFFFF;
  border-radius: 12rpx;
  border: 2rpx solid #E5E5E5;
  min-width: 120rpx;
  text-align: center;
}

.date-item--active {
  background: #FF6B6B;
  border-color: #FF6B6B;
}

.date-item--active .date-label {
  color: #FFFFFF;
}

.date-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

/* Time Grid */
.time-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.time-slot {
  padding: 20rpx;
  background: #FFFFFF;
  border-radius: 12rpx;
  border: 2rpx solid #E5E5E5;
  text-align: center;
}

.time-slot:active {
  background: #FFF5F5;
  border-color: #FF6B6B;
}

.time-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

/* Empty State */
.empty-state {
  text-align: center;
  padding: 60rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
