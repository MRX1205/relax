/* ==========================================================================
   Project Detail — Apple HIG Modern Luxury Aesthetics (Unified Sheet)
   ========================================================================== */

.page {
  background: #F5F5F7;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ── 顶部电影感 Hero 区域 ── */
.hero-card {
  position: relative;
  background: linear-gradient(135deg, #1C1C1E 0%, #2C2C2E 100%);
  padding: calc(env(safe-area-inset-top) + 40rpx) 36rpx 70rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.18);
}

.hero-cover-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.38;
}

.hero-cover-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, rgba(28,28,30,0.6) 0%, rgba(28,28,30,0.95) 100%);
}

.hero-bg-glow {
  position: absolute;
  top: -80rpx;
  right: -80rpx;
  width: 360rpx;
  height: 360rpx;
  background: radial-gradient(circle, rgba(255, 56, 46, 0.35) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

.hero-content {
  position: relative;
  z-index: 1;
}

.hero-pill-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.hero-category-pill {
  display: inline-block;
  padding: 8rpx 22rpx;
  background: rgba(255, 255, 255, 0.16);
  -webkit-backdrop-filter: blur(15px);
  backdrop-filter: blur(15px);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 40rpx;
}

.hero-meta-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.12);
  -webkit-backdrop-filter: blur(15px);
  backdrop-filter: blur(15px);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 500;
  border-radius: 40rpx;
}

.hero-title {
  font-size: 46rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: -0.8rpx;
  margin-bottom: 28rpx;
  line-height: 1.25;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display";
}

.hero-bottom-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.hero-price-wrap {
  display: flex;
  align-items: baseline;
  color: #FF5A36;
}

.price-symbol {
  font-size: 32rpx;
  font-weight: 800;
}

.price-val {
  font-size: 60rpx;
  font-weight: 800;
  line-height: 1;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display";
}

.price-unit {
  font-size: 26rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.7);
  margin-left: 8rpx;
}

.tech-count-badge {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  background: rgba(255, 255, 255, 0.12);
  padding: 8rpx 20rpx;
  border-radius: 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

/* ── 统一连续流 Apple HIG Sheet (完全消除割裂卡片) ── */
.unified-body-sheet {
  position: relative;
  z-index: 10;
  margin-top: -36rpx;
  background: #FFFFFF;
  border-top-left-radius: 44rpx;
  border-top-right-radius: 44rpx;
  padding: 36rpx 32rpx 160rpx;
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.08);
}

/* 标签特性行 */
.feature-tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.ft-pill {
  font-size: 22rpx;
  color: #34C759;
  background: rgba(52, 199, 89, 0.08);
  padding: 8rpx 18rpx;
  border-radius: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.ft-dot {
  font-weight: 800;
}

.sheet-divider {
  height: 1.5rpx;
  background: #F0F0F2;
  margin: 32rpx 0;
}

/* 各版块通用样式 */
.sheet-section {
  padding: 4rpx 0;
}

.sheet-section-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.title-between {
  justify-content: space-between;
}

.title-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.icon-bubble {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-bubble--blue { background: rgba(0, 122, 255, 0.1); }
.icon-bubble--amber { background: rgba(255, 149, 0, 0.12); }
.icon-bubble--coral { background: rgba(255, 56, 46, 0.1); }

.bubble-icon-img {
  width: 24rpx;
  height: 24rpx;
}

.sheet-section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1C1C1E;
  letter-spacing: -0.4rpx;
}

.text-amber {
  color: #B45309;
}

.sheet-section-sub {
  font-size: 24rpx;
  color: #8E8E93;
}

.sheet-section-body {
  font-size: 26rpx;
  color: #3A3A3C;
  line-height: 1.7;
}

/* 提示注意框 */
.notice-box {
  background: #FFFBF0;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid rgba(245, 158, 11, 0.2);
}

.notice-content-body {
  font-size: 25rpx;
  color: #78350F;
  line-height: 1.65;
}

/* ── 技师列表 ── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
  gap: 16rpx;
}

.empty-text {
  font-size: 24rpx;
  color: #8E8E93;
}

.tech-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.tech-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background: #F8F9FA;
  border-radius: 24rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.tech-item-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.tech-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #E5E5EA;
  flex-shrink: 0;
  border: 3rpx solid #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.tech-avatar-img {
  width: 100%;
  height: 100%;
}

.tech-item-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.tech-item-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tech-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1C1C1E;
}

.tech-badge-light {
  font-size: 20rpx;
  color: #34C759;
  background: rgba(52, 199, 89, 0.12);
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.tech-meta-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.tech-exp {
  font-size: 22rpx;
  color: #8E8E93;
}

.tech-star {
  font-size: 22rpx;
  color: #FF9500;
  font-weight: 700;
}

.tech-item-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.tech-price-wrap {
  display: flex;
  align-items: baseline;
  color: #FF382E;
}

.tech-currency {
  font-size: 22rpx;
  font-weight: 700;
}

.tech-price-num {
  font-size: 34rpx;
  font-weight: 800;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display";
}

.ios-btn-coral {
  padding: 12rpx 28rpx;
  background: linear-gradient(135deg, #FF382E, #FF5A36);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 14rpx rgba(255, 56, 46, 0.3);
}

/* ── 品质服务保障 ── */
.guarantee-block {
  background: #F8F9FA;
  border-radius: 24rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.g-header {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.shield-badge {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: rgba(52, 199, 89, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}

.g-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1C1C1E;
}

.g-row {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}

.g-pill {
  font-size: 22rpx;
  color: #636366;
  background: #FFFFFF;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  border: 1rpx solid #E5E5EA;
  flex: 1;
  text-align: center;
}

/* ── 底部固定悬浮预约栏 ── */
.sticky-booking-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  padding: 18rpx 32rpx calc(env(safe-area-inset-bottom) + 18rpx);
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.bar-call-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 16rpx;
  gap: 4rpx;
}

.bar-call-icon {
  font-size: 36rpx;
}

.bar-call-text {
  font-size: 20rpx;
  color: #636366;
  font-weight: 500;
}

.bar-book-btn {
  flex: 1;
  height: 88rpx;
  background: linear-gradient(135deg, #FF382E, #FF5A36);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 56, 46, 0.35);
}

.book-btn-price {
  font-size: 32rpx;
  font-weight: 800;
  color: #FFFFFF;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display";
}

.book-btn-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
}
