.button {
  display: flex;
  min-height: 88rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 0;
}

.button::after {
  border: 0;
}

.button--primary {
  background: var(--color-primary);
  color: #FFFFFF;
}

.button--primary:active {
  background: var(--color-primary-pressed);
}

.button--secondary {
  background: #FFFFFF;
  color: var(--color-primary);
  border: 1rpx solid var(--color-primary);
}

.button[disabled] {
  background: #D9E2EC;
  color: #7B8794;
  opacity: 1;
}

