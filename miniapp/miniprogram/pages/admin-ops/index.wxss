.page {
  padding-bottom: 140rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.menu-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 24rpx;
}

.menu-item__icon {
  font-size: 40rpx;
  width: 56rpx;
  text-align: center;
}

.menu-item__content {
  flex: 1;
}

.menu-item__name {
  font-size: 30rpx;
  font-weight: 600;
}

.menu-item__desc {
  font-size: 24rpx;
  color: var(--color-muted);
  margin-top: 4rpx;
}

.menu-item__arrow {
  font-size: 32rpx;
  color: var(--color-muted);
}
