<view class="ios-browse-page">

  <!-- ════ 1. 顶部分类吸顶胶囊条 ════ -->
  <view class="ios-cat-header ios-blur">
    <scroll-view class="cat-scroll" scroll-x enhanced show-scrollbar="{{false}}" enable-flex>
      <view class="cat-pill-list">
        <view
          class="cat-pill {{currentCategory === 0 ? 'cat-pill--active' : ''}} ios-touch-active"
          data-id="0"
          bindtap="switchCategory"
        >
          <text class="cat-pill-txt">全部精选</text>
        </view>
        <view
          wx:for="{{categories}}"
          wx:key="id"
          class="cat-pill {{currentCategory === item.id ? 'cat-pill--active' : ''}} ios-touch-active"
          data-id="{{item.id}}"
          bindtap="switchCategory"
        >
          <text class="cat-pill-txt">{{item.name}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- ════ 2. 加载骨架屏 ════ -->
  <view wx:if="{{loading}}" class="loading-grid">
    <view class="ios-skeleton skeleton-card" wx:for="{{[1,2,3,4]}}" wx:key="*this"></view>
  </view>

  <!-- ════ 3. 空状态 ════ -->
  <view wx:elif="{{projects.length === 0}}" class="ios-empty-view">
    <view class="empty-icon-circle">
      <image class="empty-svg" src="/assets/tabbar/projects.png" mode="aspectFit" />
    </view>
    <text class="empty-primary">暂无该分类项目</text>
    <text class="empty-secondary">我们正在持续引入更多正规品质理疗项目</text>
  </view>

  <!-- ════ 4. 苹果风格卡片列表 ════ -->
  <view wx:else class="project-feed">
    <view
      wx:for="{{projects}}"
      wx:key="id"
      class="project-card ios-card ios-touch-active"
      data-id="{{item.id}}"
      bindtap="goToProjectDetail"
    >
      <view class="proj-media-wrap">
        <image src="{{item.displayCover || item.coverFileId || '/assets/defaults/default-cover.png'}}" mode="aspectFill" class="proj-img" />
        <view class="proj-duration-tag">⏱ {{item.durationMinutes}}分钟</view>
        <view class="proj-cat-tag">{{item.categoryName || '精选理疗'}}</view>
      </view>

      <view class="proj-content">
        <view class="proj-headline-row">
          <text class="proj-title">{{item.name}}</text>
        </view>
        <text class="proj-desc">{{item.description || '专业手法深层调理，缓解肌肉疲劳与酸痛。'}}</text>

        <view class="proj-bottom-bar">
          <view class="proj-pricing">
            <text class="price-currency">¥</text>
            <text class="price-amount">{{item.basePrice || 168}}</text>
            <text class="price-sub">起</text>
          </view>
          <view class="book-cta-btn">立即预约</view>
        </view>
      </view>
    </view>
  </view>

  <view class="safe-bottom-bar"></view>
</view>

<custom-tabbar />
