.coupon-admin-page {
  min-height: 100vh;
  background: #F6F7F9;
  padding: 24rpx 28rpx 120rpx;
  box-sizing: border-box;
}

.hero-top-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.hero-text-col {
  flex: 1;
}

.hero-tag {
  font-size: 20rpx;
  font-weight: 800;
  color: #FF382E;
  letter-spacing: 2rpx;
  margin-bottom: 6rpx;
}

.hero-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1C1C1E;
  margin-bottom: 6rpx;
}

.hero-desc {
  font-size: 22rpx;
  color: #8E8E93;
}

.add-btn {
  background: linear-gradient(135deg, #FF382E, #FF5A36);
  color: #FFFFFF;
  padding: 16rpx 28rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 56, 46, 0.3);
}

.add-btn-icon {
  font-size: 30rpx;
  font-weight: 700;
}

.add-btn-txt {
  font-size: 26rpx;
  font-weight: 700;
}

/* 列表展示 */
.coupon-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.c-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  display: flex;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}

.c-left {
  width: 200rpx;
  background: linear-gradient(135deg, #FFF4E5 0%, #FFE6B8 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 12rpx;
  border-right: 2rpx dashed #E5D0A0;
  position: relative;
}

.c-amount-wrap {
  display: flex;
  align-items: baseline;
  color: #B45309;
}

.c-symbol {
  font-size: 24rpx;
  font-weight: 700;
}

.c-val {
  font-size: 52rpx;
  font-weight: 900;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display";
}

.c-cond {
  font-size: 20rpx;
  color: #92400E;
  margin-top: 4rpx;
  font-weight: 600;
}

.c-right {
  flex: 1;
  padding: 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.c-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.c-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1C1C1E;
}

.c-badge {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.badge-active {
  background: #E8F8EE;
  color: #34C759;
}

.badge-disabled {
  background: #F2F2F7;
  color: #8E8E93;
}

.c-meta-row {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-bottom: 16rpx;
}

.c-meta-txt {
  font-size: 22rpx;
  color: #8E8E93;
}

.c-actions-row {
  display: flex;
  gap: 14rpx;
  border-top: 1rpx solid #F5F5F7;
  padding-top: 14rpx;
}

.action-pill {
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.pill-grant-all {
  background: #FF382E;
  color: #FFFFFF;
}

.pill-grant-user {
  background: #007AFF;
  color: #FFFFFF;
}

.pill-toggle {
  background: #F2F2F7;
  color: #636366;
}

/* 弹窗通用样式 (Solid White Non-Transparent) */
.modal-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100000 !important;
  padding: 40rpx;
  box-sizing: border-box;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65) !important;
  z-index: 1;
}

.modal-body {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 680rpx;
  background: #FFFFFF !important;
  background-color: #FFFFFF !important;
  opacity: 1 !important;
  border-radius: 36rpx;
  padding: 36rpx 32rpx;
  box-sizing: border-box;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.35) !important;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1C1C1E;
}

.modal-close {
  font-size: 32rpx;
  color: #8E8E93;
  padding: 8rpx;
}

.modal-sub {
  font-size: 22rpx;
  color: #8E8E93;
  margin-bottom: 24rpx;
  display: block;
  line-height: 1.4;
}

.modal-form {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.m-row {
  display: flex;
  gap: 16rpx;
}

.flex-1 {
  flex: 1;
}

.m-field {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.m-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #1C1C1E;
}

.m-input {
  background: #FFFFFF !important;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1C1C1E !important;
  border: 2rpx solid #E5E5EA !important;
  box-sizing: border-box;
}

.m-input:focus {
  border-color: #007AFF !important;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.m-btn-cancel {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  background: #F2F2F7;
  color: #636366;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.m-btn-confirm {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  background: #1C1C1E;
  color: #FFFFFF;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 700;
}

/* 空状态 */
.loading-state,
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1C1C1E;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #8E8E93;
}
