<view class="page">
  <view class="profile-card surface">
    <view class="avatar-wrap" bindtap="handleChangeAvatar">
      <image
        wx:if="{{account.avatarUrl}}"
        class="avatar"
        src="{{account.avatarUrl}}"
        mode="aspectFill"
      />
      <view wx:else class="avatar avatar--placeholder">
        <text class="avatar-text">{{account.nickname[0] || '?'}}</text>
      </view>
      <view class="avatar-edit">更换</view>
    </view>
    <view class="profile-info">
      <view wx:if="{{editing}}" class="nickname-edit">
        <input class="nickname-input" value="{{editNickname}}" bindinput="handleNicknameInput" maxlength="64" />
        <view class="nickname-save" bindtap="handleSaveNickname">保存</view>
      </view>
      <view wx:else class="nickname-row" bindtap="handleEditNickname">
        <text class="nickname">{{account.nickname || '未设置昵称'}}</text>
        <text class="edit-icon">✏️</text>
      </view>
      <view class="phone-text">{{account.phone || '未绑定手机号'}}</view>
      <view class="role-badge">{{account.lastRole}}</view>
    </view>
  </view>

  <view class="menu-group surface">
    <view class="menu-item" bindtap="goToRoleSwitch">
      <text class="menu-icon">🔄</text>
      <text class="menu-label">切换身份</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToNotifications">
      <text class="menu-icon">🔔</text>
      <text class="menu-label">消息通知</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToCoupons">
      <text class="menu-icon">🎫</text>
      <text class="menu-label">我的优惠券</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToAddresses">
      <text class="menu-icon">📍</text>
      <text class="menu-label">地址管理</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="menu-group surface">
    <view class="menu-item" data-type="USER_AGREEMENT" bindtap="goToAgreement">
      <text class="menu-icon">📄</text>
      <text class="menu-label">用户协议</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" data-type="PRIVACY_POLICY" bindtap="goToAgreement">
      <text class="menu-icon">🔒</text>
      <text class="menu-label">隐私政策</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" data-type="TRANSACTION_RULES" bindtap="goToAgreement">
      <text class="menu-icon">📋</text>
      <text class="menu-label">交易规则</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="logout-wrap">
    <ui-button label="退出登录" variant="secondary" bind:action="handleLogout" />
  </view>
</view>

<custom-tabbar />
