.hero {
  padding: 32rpx 0 48rpx;
}

.hero__city {
  display: inline-flex;
  min-height: 48rpx;
  margin-bottom: 20rpx;
  padding: 4rpx 16rpx;
  align-items: center;
  background: #EDF8F3;
  border-radius: 8rpx;
  color: var(--color-accent);
  font-size: 24rpx;
  font-weight: 600;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
}

.service-panel {
  display: grid;
  gap: 28rpx;
  padding: 28rpx;
}

.service-line {
  display: flex;
  margin-top: 16rpx;
  align-items: center;
  gap: 12rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
}

.service-dot {
  width: 16rpx;
  height: 16rpx;
  flex: 0 0 auto;
  background: var(--color-muted);
  border-radius: 50%;
}

.service-dot--checking {
  background: var(--color-warning);
}

.service-dot--online {
  background: var(--color-success);
}

.service-dot--offline {
  background: var(--color-danger);
}

.service-env {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 24rpx;
}

.roles-title {
  margin: 48rpx 0 20rpx;
}

.role-list {
  display: grid;
  gap: 20rpx;
}

.role-item {
  display: flex;
  min-height: 136rpx;
  box-sizing: border-box;
  padding: 24rpx;
  align-items: center;
  gap: 24rpx;
}

.role-item--pressed {
  background: #F8FAFC;
}

.role-item__code {
  display: flex;
  width: 80rpx;
  height: 80rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  background: #FFF1ED;
  border-radius: 12rpx;
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 700;
}

.role-item__code--tech {
  background: #EDF8F3;
  color: var(--color-accent);
}

.role-item__code--admin {
  background: #EEF2F6;
  color: #334E68;
}

.role-item__content {
  min-width: 0;
  flex: 1;
}

.role-item__title {
  font-size: 30rpx;
  font-weight: 700;
}

.role-item__description {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 1.5;
}

.role-item__arrow {
  color: var(--color-muted);
  font-size: 48rpx;
  line-height: 1;
}

