.admin-users-page {
  min-height: 100vh;
  background: #F6F7F9;
  padding: 24rpx;
  box-sizing: border-box;
}

.search-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.search-input-box {
  flex: 1;
  height: 80rpx;
  background: #FFFFFF;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #1A1A1A;
}

.clear-btn {
  font-size: 28rpx;
  color: #999999;
  padding: 8rpx;
}

.search-btn {
  padding: 0 28rpx;
  height: 80rpx;
  background: #1C1C1E;
  color: #FFFFFF;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.users-count-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.count-txt {
  font-size: 26rpx;
  font-weight: 700;
  color: #333333;
}

.refresh-tip {
  font-size: 22rpx;
  color: #999999;
}

.user-card-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.user-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.user-card--disabled {
  opacity: 0.7;
  background: #F9F9FB;
}

.card-top-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 20rpx;
}

.user-avatar-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #1C1C1E, #3A3A3C);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-weight: 700;
}

.user-info-col {
  flex: 1;
  min-width: 0;
}

.user-name-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.user-nickname {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.status-chip {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.chip-active {
  background: rgba(7, 193, 96, 0.12);
  color: #07C160;
}

.chip-disabled {
  background: rgba(229, 77, 66, 0.12);
  color: #E54D42;
}

.user-phone {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 12rpx;
  display: block;
}

.user-roles-row {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.role-badge {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  font-weight: 600;
}

.role-badge--USER {
  background: #F0F2F5;
  color: #666666;
}

.role-badge--TECHNICIAN {
  background: rgba(52, 199, 89, 0.15);
  color: #248A3D;
}

.role-badge--ADMIN, .role-badge--SUPER_ADMIN {
  background: rgba(255, 149, 0, 0.15);
  color: #D97706;
}

.card-action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 18rpx;
  border-top: 1rpx solid #F0F0F0;
}

.uid-tag {
  font-size: 22rpx;
  color: #AAAAAA;
}

.btn-group {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  font-weight: 600;
}

.btn-freeze {
  background: #FFF0ED;
  color: #E54D42;
}

.btn-unfreeze {
  background: #EDFBF2;
  color: #07C160;
}
