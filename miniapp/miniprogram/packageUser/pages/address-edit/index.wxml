<view class="page">
  <view class="form">
    <view class="surface form-card">
      <view class="form-row">
        <text class="form-label"><text class="required-star">*</text>联系人</text>
        <input
          class="form-input"
          placeholder="您的姓名"
          placeholder-style="color: #C7C7CC;"
          value="{{contactName}}"
          data-field="contactName"
          bindinput="handleFieldInput"
        />
      </view>

      <view class="form-row">
        <text class="form-label"><text class="required-star">*</text>手机号</text>
        <input
          class="form-input"
          type="number"
          maxlength="11"
          placeholder="联系手机号"
          placeholder-style="color: #C7C7CC;"
          value="{{contactPhone}}"
          data-field="contactPhone"
          bindinput="handleFieldInput"
        />
      </view>

      <picker mode="selector" range="{{areaNames}}" value="{{selectedAreaIndex}}" bindchange="handleRegionPickerChange">
        <view class="form-row">
          <text class="form-label"><text class="required-star">*</text>所属区域</text>
          <view class="picker-trigger">
            <text wx:if="{{regionName}}" class="picker-val">{{regionName}}</text>
            <text wx:else class="placeholder-text">选择东莞镇街 (32镇街全覆盖) ›</text>
          </view>
        </view>
      </picker>

      <view class="form-row form-row--vertical">
        <text class="form-label"><text class="required-star">*</text>详细门牌地址</text>
        <input
          class="form-input"
          placeholder="小区、楼栋、单元门牌号（如：万达广场3号楼1201）"
          placeholder-style="color: #C7C7CC;"
          value="{{detail}}"
          data-field="detail"
          bindinput="handleFieldInput"
        />
      </view>
    </view>

    <view class="surface form-card">
      <view class="form-row" bindtap="handlePickLocation">
        <text class="form-label">地图精确定位</text>
        <view class="location-trigger">
          <text wx:if="{{longitude}}" class="loc-val">📍 已选点 ({{longitude}}, {{latitude}})</text>
          <text wx:else class="placeholder-text">地图选点（选填）›</text>
        </view>
      </view>

      <view class="form-row">
        <text class="form-label">地址标签</text>
        <input
          class="form-input"
          placeholder="家 / 公司 / 酒店（选填）"
          placeholder-style="color: #C7C7CC;"
          value="{{label}}"
          data-field="label"
          bindinput="handleFieldInput"
        />
      </view>

      <view class="switch-row">
        <text class="form-label">设为默认服务地址</text>
        <switch checked="{{isDefault}}" color="#FF5A36" bindchange="handleDefaultChange" />
      </view>
    </view>

    <view class="submit-wrap">
      <button class="save-submit-btn {{saving ? 'btn--disabled' : ''}}" loading="{{saving}}" bindtap="handleSave">
        {{isEdit ? '保存修改' : '确认新增并使用'}}
      </button>
    </view>
  </view>
</view>
