.page {
  padding: 40rpx 32rpx;
  min-height: 100vh;
  background: #f5f5f5;
}

.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.page-desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 48rpx;
}

.role-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.role-card {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.role-card--active {
  border-color: #ff6b6b;
  background: #fff5f5;
}

.role-card__icon {
  font-size: 48rpx;
  margin-right: 24rpx;
}

.role-card__info {
  flex: 1;
}

.role-card__name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.role-card__desc {
  font-size: 24rpx;
  color: #666;
}

.role-card__check {
  width: 48rpx;
  height: 48rpx;
  background: #ff6b6b;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.tip {
  margin-top: 48rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999;
}
