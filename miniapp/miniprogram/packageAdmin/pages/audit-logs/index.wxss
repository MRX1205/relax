.ios-audit-page {
  min-height: 100vh;
  background-color: #F2F2F7;
  padding: 24rpx;
  box-sizing: border-box;
  padding-bottom: 80rpx;
}

.hero-header {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.hero-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1D1D1F;
}

.hero-desc {
  display: block;
  font-size: 22rpx;
  color: #8E8E93;
  margin-top: 6rpx;
}

.log-timeline-feed {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.log-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.log-top-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.action-tag {
  background: #EBF3FB;
  color: #007AFF;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
}

.log-time {
  font-size: 22rpx;
  color: #AEAEB2;
}

.log-target-line {
  font-size: 26rpx;
  margin-bottom: 12rpx;
}

.target-lbl {
  color: #8E8E93;
}

.target-val {
  font-weight: 600;
  color: #1D1D1F;
}

.log-detail-box {
  background: #F8F8FA;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  margin-bottom: 14rpx;
}

.detail-text {
  font-size: 22rpx;
  color: #4A4A4C;
  word-break: break-all;
  line-height: 1.4;
}

.log-footer-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 20rpx;
  color: #AEAEB2;
  border-top: 1rpx solid #F2F2F7;
  padding-top: 12rpx;
}

.ios-empty-view {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  text-align: center;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #8E8E93;
}
