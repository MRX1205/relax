page {
  background-color: #F6F7F9;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
  color: #1D1D1F;
}

.tech-pricing-page {
  padding: 24rpx 32rpx 60rpx;
}

/* ════ 1. 说明横幅 ════ */
.guide-banner {
  padding: 28rpx 30rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(0, 122, 255, 0.15);
  box-shadow: 0 4rpx 20rpx rgba(0, 122, 255, 0.04);
}

.guide-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.guide-icon {
  font-size: 32rpx;
}

.guide-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #007AFF;
}

.guide-body {
  font-size: 24rpx;
  color: #636366;
  line-height: 1.6;
}

/* ════ 2. 技师切换卡片 ════ */
.tech-picker-card {
  padding: 28rpx 30rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.picker-label-col {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.picker-hint {
  font-size: 22rpx;
  color: #8E8E93;
}

.picker-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.tech-name-bold {
  font-size: 34rpx;
  font-weight: 800;
  color: #1C1C1E;
}

.tech-count-tag {
  font-size: 20rpx;
  color: #007AFF;
  background: rgba(0, 122, 255, 0.08);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-weight: 600;
}

.switch-tech-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: #F2F2F7;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #1C1C1E;
}

.chevron-arrow {
  font-size: 28rpx;
  color: #8E8E93;
}

/* ════ 3. 定价矩阵流 ════ */
.pricing-matrix-feed {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.project-pricing-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 30rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.03);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.project-pricing-card.card--custom {
  border-left: 8rpx solid #FF9500;
}

.card-head-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.title-group {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.p-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1D1D1F;
}

.p-duration {
  font-size: 22rpx;
  color: #8E8E93;
}

.status-pill {
  font-size: 20rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

.pill-default {
  background: #F2F2F7;
  color: #8E8E93;
}

.pill-higher {
  background: #FFF4E5;
  color: #D97706;
}

.pill-lower {
  background: #E8F8EE;
  color: #059669;
}

/* 价格对比区 */
.price-compare-grid {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: #F8F9FA;
  border-radius: 20rpx;
  padding: 20rpx 16rpx;
}

.compare-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.col-label {
  font-size: 20rpx;
  color: #8E8E93;
}

.price-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  color: #636366;
}

.price-row--active {
  color: #FF382E;
}

.symbol {
  font-size: 22rpx;
  font-weight: 700;
}

.num {
  font-size: 38rpx;
  font-weight: 800;
}

.custom-badge {
  font-size: 18rpx;
  font-weight: 700;
  background: #FF382E;
  color: #FFFFFF;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  margin-left: 8rpx;
}

.compare-divider {
  font-size: 28rpx;
  color: #C7C7CC;
}

/* 底部操作 */
.card-footer-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #F2F2F7;
}

.action-reset {
  font-size: 24rpx;
  color: #8E8E93;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  background: #F2F2F7;
}

.action-edit {
  font-size: 24rpx;
  font-weight: 600;
  color: #007AFF;
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(0, 122, 255, 0.08);
}

/* 空状态 */
.empty-pricing-card {
  padding: 80rpx 40rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #FFFFFF;
  border-radius: 28rpx;
}

.empty-emoji {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1C1C1E;
}

.empty-desc {
  font-size: 24rpx;
  color: #8E8E93;
  margin-top: 8rpx;
}

/* ════ 4. 弹窗样式 ════ */
.modal-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100000 !important;
  padding: 40rpx;
  box-sizing: border-box;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65) !important;
  z-index: 1;
}

.modal-body {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 680rpx;
  background: #FFFFFF !important;
  border-radius: 36rpx;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.35) !important;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1D1D1F;
}

.modal-close {
  font-size: 32rpx;
  color: #8E8E93;
  padding: 8rpx;
}

.modal-sub {
  display: block;
  font-size: 24rpx;
  color: #8E8E93;
  line-height: 1.4;
  margin-bottom: 24rpx;
}

.modal-form {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.m-field {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.m-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #3A3A3C;
}

.readonly-base-price {
  height: 80rpx;
  background: #F2F2F7;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #8E8E93;
  font-weight: 600;
}

.m-input {
  height: 80rpx;
  background: #FFFFFF;
  border: 2rpx solid #007AFF;
  border-radius: 16rpx;
  padding: 0 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #FF382E;
}

.diff-preview-box {
  background: #FFF9F0;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid #FFE4C4;
}

.diff-preview-txt {
  font-size: 24rpx;
  color: #B45309;
  font-weight: 500;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}

.m-btn-cancel {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: #F2F2F7;
  color: #3A3A3C;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.m-btn-confirm {
  flex: 2;
  height: 88rpx;
  line-height: 88rpx;
  background: #007AFF;
  color: #FFFFFF;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.ios-touch-active:active {
  opacity: 0.8;
  transform: scale(0.985);
}
