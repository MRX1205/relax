.admin-users-page {
  min-height: 100vh;
  background: #F6F7F9;
  padding: 24rpx;
  box-sizing: border-box;
}

.search-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.search-input-box {
  flex: 1;
  height: 80rpx;
  background: #FFFFFF;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #1A1A1A;
}

.clear-btn {
  font-size: 28rpx;
  color: #999999;
  padding: 8rpx;
}

.search-btn {
  padding: 0 28rpx;
  height: 80rpx;
  background: #1C1C1E;
  color: #FFFFFF;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.users-count-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.count-txt {
  font-size: 26rpx;
  font-weight: 700;
  color: #333333;
}

.refresh-tip {
  font-size: 22rpx;
  color: #999999;
}

.user-card-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.user-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.user-card--disabled {
  opacity: 0.7;
  background: #F9F9FB;
}

.card-top-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 20rpx;
}

.user-avatar-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #1C1C1E, #3A3A3C);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-weight: 700;
}

.user-info-col {
  flex: 1;
  min-width: 0;
}

.user-name-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.user-nickname {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.status-chip {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.chip-active {
  background: rgba(7, 193, 96, 0.12);
  color: #07C160;
}

.chip-disabled {
  background: rgba(229, 77, 66, 0.12);
  color: #E54D42;
}

.user-phone {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 12rpx;
  display: block;
}

.user-roles-row {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.role-badge {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  font-weight: 600;
}

.role-badge--USER {
  background: #F0F2F5;
  color: #666666;
}

.role-badge--TECHNICIAN {
  background: rgba(52, 199, 89, 0.15);
  color: #248A3D;
}

.role-badge--ADMIN, .role-badge--SUPER_ADMIN {
  background: rgba(255, 149, 0, 0.15);
  color: #D97706;
}

.card-action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 18rpx;
  border-top: 1rpx solid #F0F0F0;
}

.uid-tag {
  font-size: 22rpx;
  color: #AAAAAA;
}

.btn-group {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  font-weight: 600;
}

.btn-freeze {
  background: #FFF0ED;
  color: #E54D42;
}

.btn-unfreeze {
  background: #EDFBF2;
  color: #07C160;
}

/* ════ 用户详情弹窗 (Apple HIG Modal) ════ */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65) !important;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  z-index: 100000 !important;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-sheet {
  width: 100%;
  max-height: 82vh;
  background: #FFFFFF !important;
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
  padding: 36rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  box-sizing: border-box;
  overflow-y: auto;
  box-shadow: 0 -12rpx 48rpx rgba(0, 0, 0, 0.28) !important;
  position: relative;
  z-index: 100001 !important;
}

.modal-sheet-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1C1C1E;
}

.sheet-sub {
  font-size: 22rpx;
  color: #8E8E93;
  margin-top: 4rpx;
  display: block;
}

.sheet-close-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #F2F2F7;
  color: #8E8E93;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}

.user-profile-banner {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx;
  background: #F9F9FB;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}

.banner-avatar-wrap {
  width: 110rpx;
  height: 110rpx;
  border-radius: 55rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.banner-avatar-img {
  width: 100%;
  height: 100%;
}

.banner-avatar-ph {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #1C1C1E, #3A3A3C);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 800;
}

.banner-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.banner-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.banner-nickname {
  font-size: 32rpx;
  font-weight: 800;
  color: #1C1C1E;
}

.banner-phone-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.banner-phone {
  font-size: 26rpx;
  color: #3A3A3C;
}

.copy-hint {
  font-size: 20rpx;
  color: #007AFF;
  background: rgba(0, 122, 255, 0.1);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.banner-uid {
  font-size: 22rpx;
  color: #8E8E93;
}

.sheet-section {
  margin-bottom: 28rpx;
}

.sec-header-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.sec-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #1C1C1E;
  margin-bottom: 12rpx;
  display: block;
}

.link-more {
  font-size: 24rpx;
  color: #007AFF;
  font-weight: 600;
}

.roles-chips-grid {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
}

.sheet-role-chip {
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.orders-loading, .orders-empty-box {
  padding: 30rpx;
  text-align: center;
  font-size: 24rpx;
  color: #8E8E93;
  background: #F9F9FB;
  border-radius: 16rpx;
}

.mini-orders-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.mini-order-item {
  padding: 18rpx 20rpx;
  background: #F9F9FB;
  border-radius: 16rpx;
}

.mo-row-top, .mo-row-sub {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.mo-row-top {
  margin-bottom: 6rpx;
}

.mo-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1C1C1E;
}

.mo-status {
  font-size: 22rpx;
  color: #07C160;
  font-weight: 600;
}

.mo-no {
  font-size: 22rpx;
  color: #8E8E93;
}

.mo-price {
  font-size: 26rpx;
  font-weight: 700;
  color: #FF382E;
}

.modal-sheet-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 32rpx;
}

.sheet-btn {
  width: 100%;
  height: 84rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sheet-btn--freeze {
  background: #FFF1EE;
  color: #E54D42;
}

.sheet-btn--unfreeze {
  background: #EDFBF2;
  color: #07C160;
}

.sheet-btn--orders {
  background: #1C1C1E;
  color: #FFFFFF;
}

