/* ========================================================
   Login Page — 现代多身份登录页
   ======================================================== */

.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF1EE 0%, #F5F6F8 35%, #F5F6F8 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx 60rpx;
  box-sizing: border-box;
}

/* ── 品牌头图区 ── */
.brand-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 50rpx;
}

.brand-logo-box {
  width: 140rpx;
  height: 140rpx;
  background: linear-gradient(135deg, #E54D42, #FF7043);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(229, 77, 66, 0.35);
  margin-bottom: 24rpx;
}

.brand-logo-icon {
  font-size: 72rpx;
}

.brand-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #1A1A1A;
  letter-spacing: 2rpx;
  margin-bottom: 10rpx;
}

.brand-sub {
  font-size: 26rpx;
  color: #888888;
  letter-spacing: 1rpx;
}

/* ── 登录卡片 ── */
.login-card {
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 8rpx 36rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

/* 身份切换器 */
.tab-switcher {
  display: flex;
  background: #F4F5F7;
  border-radius: 20rpx;
  padding: 6rpx;
  margin-bottom: 36rpx;
}

.tab-btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.tab-btn--active {
  background: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.tab-btn-txt {
  font-size: 26rpx;
  color: #666666;
  font-weight: 500;
}

.tab-btn--active .tab-btn-txt {
  color: #E54D42;
  font-weight: 700;
}

/* 错误提示 */
.error-strip {
  display: flex;
  align-items: center;
  background: #FFF3F0;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
  gap: 10rpx;
}

.error-strip-icon {
  font-size: 28rpx;
}

.error-strip-txt {
  font-size: 24rpx;
  color: #E54D42;
}

/* 保障标签 */
.feature-badges {
  display: flex;
  justify-content: space-between;
  margin-bottom: 40rpx;
  padding: 0 10rpx;
}

.badge-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.badge-check {
  font-size: 22rpx;
  color: #2BA245;
  font-weight: 800;
}

.badge-text {
  font-size: 22rpx;
  color: #666666;
}

/* 微信登录按钮 */
.wechat-login-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #07C160, #0ab85b);
  border-radius: 48rpx;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.35);
  margin-bottom: 30rpx;
}

.wx-icon {
  font-size: 36rpx;
}

.wx-btn-txt {
  font-size: 32rpx;
  font-weight: 700;
}

/* 服务端模式 */
.staff-header-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  margin-bottom: 32rpx;
}

.staff-hint-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.staff-hint-sub {
  font-size: 22rpx;
  color: #999999;
}

.staff-form-wrap {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.input-field-item {
  display: flex;
  align-items: center;
  background: #F4F5F7;
  border-radius: 20rpx;
  padding: 0 24rpx;
  height: 96rpx;
  border: 1.5rpx solid rgba(0, 0, 0, 0.04);
}

.field-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A1A;
  height: 100%;
}

.staff-submit-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #1C1C1E, #3A3A3C);
  border-radius: 48rpx;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.25);
  margin-top: 10rpx;
}

.submit-btn-txt {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.staff-divider-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin: 10rpx 0;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #EAEAEA;
}

.divider-txt {
  font-size: 22rpx;
  color: #AAAAAA;
}

.staff-wx-btn {
  width: 100%;
  height: 88rpx;
  background: #F4F5F7;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: none;
}

.staff-wx-txt {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

/* 协议行 */
.agreement-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.agree-box {
  width: 32rpx;
  height: 32rpx;
  border-radius: 6rpx;
  border: 2rpx solid #CCCCCC;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #FFFFFF;
  flex-shrink: 0;
}

.agree-box--checked {
  background: #E54D42;
  border-color: #E54D42;
}

.agreement-text {
  font-size: 22rpx;
  color: #888888;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.link {
  color: #E54D42;
  display: inline;
}

/* 底部倡议 */
.footer-note {
  margin-top: auto;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  color: #AAAAAA;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
}

.shield-icon {
  font-size: 26rpx;
}



