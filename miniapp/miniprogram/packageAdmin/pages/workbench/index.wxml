<view class="admin-workbench-page">

  <!-- ════ 1. 管理员个人信息头部卡片 (Apple Inset Profile Card) ════ -->
  <view class="ios-card profile-hero-card">
    <view class="profile-main-row">
      <view class="admin-avatar">
        <text class="avatar-letter">管</text>
        <view class="avatar-badge-icon">
          <image src="/assets/icons/shield.png" style="width: 22rpx; height: 22rpx;" mode="aspectFit" />
        </view>
      </view>

      <view class="profile-text-col">
        <view class="name-display-row">
          <text class="user-nickname">{{account.nickname || '系统管理员'}}</text>
          <text class="role-pill pill-super">超级管理员</text>
        </view>

        <view class="phone-chip-row">
          <text class="phone-number">📱 {{account.phone || '13800000000'}}</text>
          <text class="auth-tag">全域调度授权</text>
        </view>
      </view>

      <view class="return-home-pill ios-touch-active" bindtap="returnToUserMode">
        <text class="pill-home-icon">🏠</text>
        <text class="pill-home-txt">顾客端</text>
      </view>
    </view>
  </view>

  <!-- ════ 2. 实时核心业务数据大盘 (4-Col Stat Bar) ════ -->
  <view class="ios-card stats-bar-card">
    <view class="stat-cell ios-touch-active" data-url="/packageAdmin/pages/stats/index" bindtap="handleMenuTap">
      <text class="stat-figure figure-red">¥{{stats.todayRevenue || '0.00'}}</text>
      <text class="stat-caption">今日平台营收</text>
    </view>
    <view class="stat-vert-line"></view>
    <view class="stat-cell ios-touch-active" data-url="/packageAdmin/pages/order-list/index" bindtap="handleMenuTap">
      <text class="stat-figure">{{stats.todayOrders || 0}}</text>
      <text class="stat-caption">今日订单数</text>
    </view>
    <view class="stat-vert-line"></view>
    <view class="stat-cell ios-touch-active" data-url="/packageAdmin/pages/technicians/index" bindtap="handleMenuTap">
      <text class="stat-figure figure-green">{{stats.totalTechnicians || 0}}</text>
      <text class="stat-caption">认证技师数</text>
    </view>
    <view class="stat-vert-line"></view>
    <view class="stat-cell ios-touch-active" data-url="/packageAdmin/pages/refunds/index" bindtap="handleMenuTap">
      <text class="stat-figure {{pendingRefundCount > 0 ? 'figure-orange' : ''}}">{{pendingRefundCount}}</text>
      <text class="stat-caption">待审核退款</text>
    </view>
  </view>

  <!-- ════ 3. 支付与结算生效模式横幅 (Apple Banner Style) ════ -->
  <view class="ios-card pay-mode-banner ios-touch-active" data-url="/packageAdmin/pages/payment-config/index" bindtap="handleMenuTap">
    <view class="mode-left">
      <view class="mode-icon-circle">
        <text wx:if="{{paymentModeInfo.mode === 'OFFLINE'}}">💵</text>
        <text wx:elif="{{paymentModeInfo.mode === 'WXPAY'}}">💬</text>
        <text wx:else>🧪</text>
      </view>
      <view class="mode-text-wrap">
        <view class="mode-title-line">
          <text class="mode-title">当前结算模式：{{paymentModeInfo.label}}</text>
          <text class="mode-status-tag {{paymentModeInfo.mode === 'OFFLINE' ? 'tag-offline' : (paymentModeInfo.mode === 'WXPAY' ? 'tag-wx' : 'tag-mock')}}">生效中</text>
        </view>
        <text class="mode-desc">{{paymentModeInfo.description}}</text>
      </view>
    </view>
    <view class="mode-action-btn">
      <text>配置开关 ›</text>
    </view>
  </view>

  <!-- ════ 4. 微信安全绑定管理卡片 ════ -->
  <view class="ios-card wechat-binding-card" wx:if="{{authorized}}">
    <view class="wb-left">
      <view class="wb-icon-box">
        <image class="wb-icon-img" src="/assets/icons/wechat.png" mode="aspectFit" />
      </view>
      <view class="wb-info">
        <view class="wb-title-row">
          <text class="wb-title">管理员微信号绑定</text>
          <text class="wb-tag {{account.wechatBound ? 'wb-tag--bound' : 'wb-tag--unbound'}}">
            {{account.wechatBound ? '已绑定' : '未绑定'}}
          </text>
        </view>
        <text class="wb-desc">{{account.wechatBound ? '已开启管理员微信一键快捷登录' : '绑定微信后可在登录页直接一键快捷登录'}}</text>
      </view>
    </view>
    <view class="wb-btn {{account.wechatBound ? 'wb-btn--bound' : 'wb-btn--action'}} ios-touch-active" bindtap="handleBindWechat">
      <text>{{account.wechatBound ? '更换绑定' : '一键绑定'}}</text>
    </view>
  </view>

  <!-- ════ 5. 消息发布与全员广播横幅 ════ -->
  <view class="ios-card broadcast-card ios-touch-active" bindtap="openBroadcastModal">
    <view class="bc-left">
      <view class="bc-icon-box">📢</view>
      <view class="bc-info">
        <text class="bc-title">发布系统消息与全员广播</text>
        <text class="bc-desc">向全平台顾客发布活动公告或定向发送系统通知</text>
      </view>
    </view>
    <view class="bc-btn">发布消息 ›</view>
  </view>

  <!-- ════ 6. 核心业务调度 (2x2 Grid) ════ -->
  <view class="section-container">
    <view class="section-header">
      <text class="section-title">核心业务调度</text>
      <text class="section-sub">全平台履约与资金监控</text>
    </view>

    <view class="ops-grid">
      <view
        wx:for="{{opsMenus}}"
        wx:key="code"
        class="ios-card ops-card ios-touch-active"
        data-url="{{item.url}}"
        bindtap="handleMenuTap"
      >
        <view class="ops-top-row">
          <view class="ops-icon-box icon-bg--{{item.code}}">
            <image wx:if="{{item.code === 'orders'}}" src="/assets/icons/order.png" class="ops-icon" mode="aspectFit" />
            <image wx:elif="{{item.code === 'refunds'}}" src="/assets/icons/flame.png" class="ops-icon" mode="aspectFit" />
            <image wx:elif="{{item.code === 'settlements'}}" src="/assets/icons/invite.png" class="ops-icon" mode="aspectFit" />
            <image wx:else src="/assets/icons/star.png" class="ops-icon" mode="aspectFit" />
          </view>
          <text wx:if="{{item.badge}}" class="ops-badge badge--alert">{{item.badge}}</text>
        </view>

        <text class="ops-name">{{item.name}}</text>
        <text class="ops-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <!-- ════ 6. 人员与权限中心 (3-Col Grid) ════ -->
  <view class="section-container">
    <view class="section-header">
      <text class="section-title">人员与权限管理</text>
      <text class="section-sub">技师入驻 · 管理员赋权 · 顾客档案</text>
    </view>

    <view class="ios-card grid-card-container">
      <view class="menu-grid-3">
        <view
          wx:for="{{peopleMenus}}"
          wx:key="code"
          class="grid-tile-item ios-touch-active"
          data-url="{{item.url}}"
          bindtap="handleMenuTap"
        >
          <view class="tile-icon-box icon-bg--{{item.code}}">
            <image wx:if="{{item.code === 'technicians'}}" src="/assets/icons/tech.png" class="tile-icon" mode="aspectFit" />
            <image wx:elif="{{item.code === 'admins'}}" src="/assets/icons/lock.png" class="tile-icon" mode="aspectFit" />
            <image wx:else src="/assets/icons/role.png" class="tile-icon" mode="aspectFit" />
            <text wx:if="{{item.badge}}" class="tile-badge">{{item.badge}}</text>
          </view>
          <text class="tile-title">{{item.name}}</text>
          <text class="tile-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ════ 7. 供给服务与商城运营 (4-Col Grid) ════ -->
  <view class="section-container">
    <view class="section-header">
      <text class="section-title">服务供给与运营</text>
      <text class="section-sub">项目库 · 分类排序 · 技师定价 · 轮播海报</text>
    </view>

    <view class="ios-card grid-card-container">
      <view class="menu-grid-4">
        <view
          wx:for="{{serviceMenus}}"
          wx:key="code"
          class="grid-tile-mini ios-touch-active"
          data-url="{{item.url}}"
          bindtap="handleMenuTap"
        >
          <view class="tile-icon-box-sm icon-bg--{{item.code}}">
            <image wx:if="{{item.code === 'projects'}}" src="/assets/tabbar/projects-active.png" class="tile-icon-sm" mode="aspectFit" />
            <image wx:elif="{{item.code === 'categories'}}" src="/assets/tabbar/projects.png" class="tile-icon-sm" mode="aspectFit" />
            <image wx:elif="{{item.code === 'pricing'}}" src="/assets/icons/coupon.png" class="tile-icon-sm" mode="aspectFit" />
            <image wx:else src="/assets/icons/camera.png" class="tile-icon-sm" mode="aspectFit" />
          </view>
          <text class="tile-title-sm">{{item.name}}</text>
          <text class="tile-desc-sm">{{item.desc}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ════ 8. 系统安全与结算配置 (3-Col Grid) ════ -->
  <view class="section-container">
    <view class="section-header">
      <text class="section-title">系统安全与配置</text>
      <text class="section-sub">支付模式 · 基础设置 · 审计日志</text>
    </view>

    <view class="ios-card grid-card-container">
      <view class="menu-grid-3">
        <view
          wx:for="{{systemMenus}}"
          wx:key="code"
          class="grid-tile-item ios-touch-active"
          data-url="{{item.url}}"
          bindtap="handleMenuTap"
        >
          <view class="tile-icon-box icon-bg--{{item.code}}">
            <image wx:if="{{item.code === 'payment'}}" src="/assets/icons/coupon.png" class="tile-icon" mode="aspectFit" />
            <image wx:elif="{{item.code === 'system'}}" src="/assets/icons/shield.png" class="tile-icon" mode="aspectFit" />
            <image wx:else src="/assets/icons/notice.png" class="tile-icon" mode="aspectFit" />
            <text wx:if="{{item.badge}}" class="tile-badge badge--pill">{{item.badge}}</text>
          </view>
          <text class="tile-title">{{item.name}}</text>
          <text class="tile-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ════ 7. 退出登录与安全 ════ -->
  <view class="footer-actions-wrap">
    <view class="logout-btn ios-touch-active" bindtap="handleLogout">
      <text>退出管理员登录</text>
    </view>
    <view class="back-home-link ios-touch-active" bindtap="returnToUserMode">
      <text>‹ 返回顾客端首页</text>
    </view>
  </view>

  <view style="height: 60rpx;"></view>

  <!-- ════ 8. 发布系统消息与全员广播弹窗 (Solid White) ════ -->
  <view wx:if="{{showBroadcastModal}}" class="modal-mask" bindtap="closeBroadcastModal">
    <view class="modal-body" catchtap="">
      <view class="modal-header">
        <text class="modal-title">发布系统通知与公告</text>
        <text class="modal-close ios-touch-active" bindtap="closeBroadcastModal">✕</text>
      </view>
      <text class="modal-sub">消息发布后将实时推送至顾客端「消息通知」列表。</text>

      <view class="modal-form">
        <view class="m-field">
          <text class="m-label">消息标题 *</text>
          <input
            class="m-input"
            placeholder="如：平台周年庆优惠券已派发"
            value="{{broadcastTitle}}"
            bindinput="handleBroadcastTitleInput"
          />
        </view>

        <view class="m-field">
          <text class="m-label">通知正文内容 *</text>
          <textarea
            class="m-textarea"
            placeholder="请输入详细通知内容..."
            value="{{broadcastContent}}"
            bindinput="handleBroadcastContentInput"
          ></textarea>
        </view>

        <view class="m-field">
          <text class="m-label">通知宣传配图（可选）</text>
          <view wx:if="{{broadcastImageUrl}}" class="broadcast-img-preview-box">
            <image class="preview-img" src="{{broadcastImageUrl}}" mode="aspectFill" bindtap="previewBroadcastImage" />
            <view class="del-img-btn ios-touch-active" bindtap="clearBroadcastImage">✕ 移除配图</view>
          </view>
          <view wx:else class="upload-img-box ios-touch-active" bindtap="chooseBroadcastImage">
            <text class="upload-plus">+</text>
            <text class="upload-txt">点击上传公告封面或横幅海报</text>
          </view>
        </view>

        <view class="m-field">
          <text class="m-label">推送目标范围</text>
          <view class="target-radio-row">
            <view
              class="target-chip {{broadcastTarget === 'ALL' ? 'target-chip--active' : ''}}"
              data-target="ALL"
              bindtap="setBroadcastTarget"
            >
              📢 全体顾客 (全员广播)
            </view>
            <view
              class="target-chip {{broadcastTarget === 'SINGLE' ? 'target-chip--active' : ''}}"
              data-target="SINGLE"
              bindtap="setBroadcastTarget"
            >
              🎯 指定用户ID
            </view>
          </view>
        </view>

        <view class="m-field" wx:if="{{broadcastTarget === 'SINGLE'}}">
          <text class="m-label">目标顾客 User ID *</text>
          <input
            class="m-input"
            type="number"
            placeholder="请输入目标用户数字ID"
            value="{{broadcastUserId}}"
            bindinput="handleBroadcastUserIdInput"
          />
        </view>
      </view>

      <view class="modal-footer">
        <button class="m-btn-cancel ios-touch-active" bindtap="closeBroadcastModal">取消</button>
        <button class="m-btn-confirm ios-touch-active" loading="{{submittingBroadcast}}" bindtap="handleConfirmBroadcast">
          确认发送
        </button>
      </view>
    </view>
  </view>

</view>
