page {
  --color-primary: #C84B31;
  --color-primary-pressed: #A83C27;
  --color-accent: #237A57;
  --color-text: #1F2933;
  --color-text-secondary: #52606D;
  --color-muted: #7B8794;
  --color-surface: #FFFFFF;
  --color-background: #F6F7F9;
  --color-border: #D9E2EC;
  --color-danger: #C62828;
  --color-warning: #A85D00;
  --color-success: #237A57;
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-5: 48rpx;

  min-height: 100%;
  background: var(--color-background);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  letter-spacing: 0;
}

button,
input,
textarea {
  font: inherit;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.surface {
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
}

.page-title {
  margin: 0;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: 0;
}

.page-subtitle {
  margin-top: 12rpx;
  color: var(--color-text-secondary);
  font-size: 28rpx;
  line-height: 1.6;
}

