<view class="coupon-admin-page">
  <!-- 顶部概览与新增栏 -->
  <view class="hero-top-card ios-card">
    <view class="hero-text-col">
      <view class="hero-tag">MARKETING CENTER</view>
      <view class="hero-title">优惠券与营销中心</view>
      <view class="hero-desc">创建平台满减券，支持向全员广播派券或定向顾客发放。</view>
    </view>
    <view class="add-btn ios-touch-active" bindtap="openCreateModal">
      <text class="add-btn-icon">＋</text>
      <text class="add-btn-txt">新建卡券</text>
    </view>
  </view>

  <!-- 优惠券模板列表 -->
  <view class="coupons-container">
    <view wx:if="{{loading}}" class="loading-state">
      <text>正在获取卡券列表…</text>
    </view>

    <view wx:elif="{{templates.length === 0}}" class="empty-state">
      <view class="empty-icon">🎫</view>
      <text class="empty-title">暂无优惠券模板</text>
      <text class="empty-desc">点击右上角「新建卡券」创建第一张活动优惠券</text>
    </view>

    <view wx:else class="coupon-list">
      <view wx:for="{{templates}}" wx:key="id" class="c-card ios-card">
        <view class="c-left">
          <view class="c-amount-wrap">
            <text class="c-symbol">¥</text>
            <text class="c-val">{{item.amount}}</text>
          </view>
          <text class="c-cond">满{{item.minSpend}}元可用</text>
        </view>

        <view class="c-right">
          <view class="c-header-row">
            <text class="c-name">{{item.name}}</text>
            <text class="c-badge {{item.status === 'ACTIVE' ? 'badge-active' : 'badge-disabled'}}">
              {{item.status === 'ACTIVE' ? '投放中' : '已停发'}}
            </text>
          </view>

          <view class="c-meta-row">
            <text class="c-meta-txt">发行总量：{{item.totalCount}} 张</text>
            <text class="c-meta-txt">剩余库存：{{item.remainCount != null ? item.remainCount : item.totalCount}} 张</text>
          </view>

          <!-- 运营派发操作栏 -->
          <view class="c-actions-row">
            <view class="action-pill pill-grant-all ios-touch-active" data-id="{{item.id}}" bindtap="handleGrantAll">
              全员派发
            </view>
            <view class="action-pill pill-grant-user ios-touch-active" data-id="{{item.id}}" bindtap="openGrantUserModal">
              定向派送
            </view>
            <view class="action-pill pill-toggle ios-touch-active" data-id="{{item.id}}" data-status="{{item.status}}" bindtap="handleToggleStatus">
              {{item.status === 'ACTIVE' ? '停发' : '恢复'}}
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- ════ 新建卡券弹窗 (Solid White Apple Modal) ════ -->
  <view wx:if="{{showCreateModal}}" class="modal-container">
    <view class="modal-mask" catchtouchmove="true" bindtap="closeCreateModal"></view>
    <view class="modal-body" catchtap="noop">
      <view class="modal-header">
        <text class="modal-title">新建优惠券模板</text>
        <text class="modal-close ios-touch-active" bindtap="closeCreateModal">✕</text>
      </view>
      <text class="modal-sub">设定优惠券面额、门槛与发行数量，创建后可在前端领券中心展示或派发给用户。</text>

      <view class="modal-form">
        <view class="m-field">
          <text class="m-label">优惠券名称 *</text>
          <input
            class="m-input"
            adjust-position="{{true}}"
            cursor-spacing="30"
            placeholder="如：全场通用减20元券"
            value="{{formName}}"
            bindinput="handleNameInput"
          />
        </view>

        <view class="m-row">
          <view class="m-field flex-1">
            <text class="m-label">立减面额 (¥) *</text>
            <input
              class="m-input"
              type="digit"
              adjust-position="{{true}}"
              cursor-spacing="30"
              placeholder="如：20"
              value="{{formAmount}}"
              bindinput="handleAmountInput"
            />
          </view>
          <view class="m-field flex-1">
            <text class="m-label">使用门槛 (¥) *</text>
            <input
              class="m-input"
              type="digit"
              adjust-position="{{true}}"
              cursor-spacing="30"
              placeholder="0为无门槛"
              value="{{formMinSpend}}"
              bindinput="handleMinSpendInput"
            />
          </view>
        </view>

        <view class="m-field">
          <text class="m-label">总发行张数 *</text>
          <input
            class="m-input"
            type="number"
            adjust-position="{{true}}"
            cursor-spacing="30"
            placeholder="如：500"
            value="{{formTotalCount}}"
            bindinput="handleTotalCountInput"
          />
        </view>
      </view>

      <view class="modal-footer">
        <button class="m-btn-cancel ios-touch-active" bindtap="closeCreateModal">取消</button>
        <button class="m-btn-confirm ios-touch-active" loading="{{submitting}}" bindtap="handleCreateSubmit">
          确认创建
        </button>
      </view>
    </view>
  </view>

  <!-- ════ 定向派发弹窗 ════ -->
  <view wx:if="{{showGrantModal}}" class="modal-container">
    <view class="modal-mask" catchtouchmove="true" bindtap="closeGrantModal"></view>
    <view class="modal-body" catchtap="noop">
      <view class="modal-header">
        <text class="modal-title">定向派发优惠券</text>
        <text class="modal-close ios-touch-active" bindtap="closeGrantModal">✕</text>
      </view>
      <text class="modal-sub">向指定注册顾客直接发放该优惠券（请输入目标用户ID）。</text>

      <view class="modal-form">
        <view class="m-field">
          <text class="m-label">目标顾客 User ID *</text>
          <input
            class="m-input"
            type="number"
            adjust-position="{{true}}"
            cursor-spacing="30"
            placeholder="在「用户会员管理」中查看UID"
            value="{{targetUserIdInput}}"
            bindinput="handleTargetUserIdInput"
          />
        </view>
      </view>

      <view class="modal-footer">
        <button class="m-btn-cancel ios-touch-active" bindtap="closeGrantModal">取消</button>
        <button class="m-btn-confirm ios-touch-active" loading="{{submittingGrant}}" bindtap="handleConfirmGrantUser">
          确认派发
        </button>
      </view>
    </view>
  </view>

</view>
