.ios-tech-access-page {
  min-height: 100vh;
  background-color: #F2F2F7;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 顶部宣传横幅 */
.banner-hero {
  padding: 32rpx 28rpx;
  background: linear-gradient(135deg, #2C3E50 0%, #000000 100%);
  border-radius: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.12);
}

.banner-tag {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #E2B97F;
  background: rgba(226, 185, 127, 0.15);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

.banner-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 0.5rpx;
  margin-bottom: 8rpx;
}

.banner-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.5;
}

/* 表单卡片 */
.form-group {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.group-header {
  margin-bottom: 24rpx;
}

.group-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.group-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D1D1F;
}

.group-sub {
  display: block;
  font-size: 22rpx;
  color: #8E8E93;
  margin-top: 6rpx;
}

.area-action-links {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.link-btn {
  font-size: 24rpx;
  color: #C84B31;
  font-weight: 500;
}

.link-sep {
  font-size: 22rpx;
  color: #D1D1D6;
}

/* 单行输入行 */
.form-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.row-label {
  width: 170rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #3A3A3C;
}

.req {
  color: #FF382E;
  margin-left: 4rpx;
}

.row-input {
  flex: 1;
  font-size: 28rpx;
  color: #1D1D1F;
}

.ph-style {
  color: #C7C7CC;
  font-size: 26rpx;
}

.row-divider {
  height: 1rpx;
  background-color: #E5E5EA;
  margin: 4rpx 0;
}

/* 简介多行输入 */
.intro-textarea {
  width: 100%;
  height: 180rpx;
  background: #F2F2F7;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: #1D1D1F;
  line-height: 1.5;
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: #AEAEB2;
  margin-top: 10rpx;
}

/* 区域胶囊网格 */
.area-chip-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.area-chip {
  padding: 14rpx 28rpx;
  background: #F2F2F7;
  border: 1.5rpx solid transparent;
  border-radius: 36rpx;
  font-size: 26rpx;
  color: #3A3A3C;
  transition: all 0.2s ease;
}

.area-chip--active {
  background: rgba(200, 75, 49, 0.08);
  border-color: #C84B31;
  color: #C84B31;
  font-weight: 600;
}

/* 上传网格 */
.upload-grid {
  display: flex;
  gap: 28rpx;
}

.upload-slot {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.slot-title {
  font-size: 24rpx;
  color: #3A3A3C;
  margin-bottom: 14rpx;
  font-weight: 500;
}

.upload-box {
  width: 100%;
  height: 220rpx;
  background: #F8F8FA;
  border: 2rpx dashed #C7C7CC;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.uploaded-img {
  width: 100%;
  height: 100%;
}

.upload-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.upload-icon {
  font-size: 48rpx;
}

.upload-hint {
  font-size: 24rpx;
  color: #8E8E93;
}

.remove-link {
  font-size: 22rpx;
  color: #C84B31;
  margin-top: 12rpx;
}

/* 协议条 */
.agreement-bar {
  display: flex;
  align-items: center;
  padding: 8rpx 12rpx 24rpx;
  gap: 16rpx;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #C7C7CC;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #FFFFFF;
  flex-shrink: 0;
}

.checkbox--checked {
  background: #C84B31;
  border-color: #C84B31;
}

.agreement-text {
  font-size: 24rpx;
  color: #8E8E93;
  line-height: 1.4;
}

.agreement-link {
  color: #C84B31;
}

/* 状态展示 */
.status-hero {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  margin-top: 40rpx;
}

.status-icon-bubble {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  margin: 0 auto 28rpx;
}

.bubble--APPROVED { background: #E8F5E9; }
.bubble--REJECTED { background: #FFEBEE; }
.bubble--PENDING { background: #FFF8E1; }

.status-hero-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1D1D1F;
  margin-bottom: 16rpx;
}

.status-hero-desc {
  display: block;
  font-size: 26rpx;
  color: #8E8E93;
  line-height: 1.6;
}

.reject-box {
  margin-top: 32rpx;
  background: #FFF5F5;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: left;
}

.reject-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #FF382E;
}

.reject-content {
  font-size: 26rpx;
  color: #4A4A4C;
  line-height: 1.5;
}

.status-action-row {
  margin-top: 48rpx;
}

.reapply-btn, .home-btn {
  height: 88rpx;
  line-height: 88rpx;
  background: #C84B31;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
}

/* 底部提交栏 */
.bottom-submit-placeholder {
  height: 140rpx;
}

.bottom-submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20px);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 99;
}

.submit-action-btn {
  height: 92rpx;
  line-height: 92rpx;
  background: linear-gradient(135deg, #D45B3E 0%, #C84B31 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 46rpx;
  box-shadow: 0 8rpx 24rpx rgba(200, 75, 49, 0.35);
}

.ios-touch-active:active {
  opacity: 0.82;
  transform: scale(0.985);
}
