<view class="page">
  <view class="form">
    <view class="surface form-card">
      <ui-field label="联系人" value="{{contactName}}" placeholder="您的姓名" bindinput="handleInput('contactName')" />
      <ui-field label="手机号" value="{{contactPhone}}" type="number" placeholder="联系手机号" bindinput="handleInput('contactPhone')" />
      <view class="field">
        <view class="field__label">区域</view>
        <view class="picker-trigger" bindtap="handleRegionTap">
          <text wx:if="{{regionName}}">{{regionName}}</text>
          <text wx:else class="placeholder-text">选择东莞镇街</text>
        </view>
      </view>
      <ui-field label="详细地址" value="{{detail}}" placeholder="小区、楼栋、门牌号" bindinput="handleInput('detail')" />
    </view>

    <view class="surface form-card">
      <view class="field">
        <view class="field__label">地图定位</view>
        <view class="location-row" bindtap="handlePickLocation">
          <text wx:if="{{longitude}}">已定位（{{longitude}}, {{latitude}}）</text>
          <text wx:else class="placeholder-text">点击选择位置</text>
        </view>
      </view>
      <ui-field label="标签" value="{{label}}" placeholder="家、公司（选填）" bindinput="handleInput('label')" />
      <view class="switch-row">
        <text class="field__label">设为默认地址</text>
        <switch checked="{{isDefault}}" bindchange="handleDefaultChange" />
      </view>
    </view>

    <ui-button label="{{isEdit ? '保存修改' : '新增地址'}}" loading="{{saving}}" bind:action="handleSave" />
  </view>
</view>
