.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 200rpx;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.switch-info {
  flex: 1;
}

.switch-label {
  display: block;
  font-size: 30rpx;
  color: #333;
}

.switch-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #666;
}

.info-value {
  font-size: 28rpx;
  color: #333;
}

.status-on {
  color: #52c41a;
}

.status-off {
  color: #999;
}

.btn-reset {
  width: 100%;
  height: 88rpx;
  background: #ff6b6b;
  color: #fff;
  font-size: 32rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tip {
  margin-top: 16rpx;
  padding: 16rpx;
  background: #fffbe6;
  border-radius: 8rpx;
}

.tip text {
  font-size: 24rpx;
  color: #8c6e00;
}

.desc-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.desc-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.desc-num {
  font-size: 28rpx;
  color: #ff6b6b;
  font-weight: bold;
}

.desc-text {
  font-size: 28rpx;
  color: #666;
  flex: 1;
}
