.ios-admins-page {
  min-height: 100vh;
  background-color: #F2F2F7;
  padding: 24rpx;
  box-sizing: border-box;
  padding-bottom: 80rpx;
}

/* 顶部操作头 */
.header-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.header-main-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1D1D1F;
}

.header-desc {
  display: block;
  font-size: 22rpx;
  color: #8E8E93;
  margin-top: 4rpx;
}

.add-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #C84B31;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  padding: 14rpx 24rpx;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(200, 75, 49, 0.3);
}

.add-plus {
  font-size: 32rpx;
  line-height: 1;
}

/* 列表展示 */
.admin-list-wrap {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.admin-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.card-head-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.admin-avatar-circle {
  width: 92rpx;
  height: 92rpx;
  background: linear-gradient(135deg, #007AFF 0%, #5856D6 100%);
  border-radius: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  flex-shrink: 0;
}

.circle--super {
  background: linear-gradient(135deg, #FF9500 0%, #C84B31 100%);
}

.admin-head-info {
  flex: 1;
}

.name-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.admin-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1D1D1F;
}

.role-pill {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

.pill--super {
  background: #FFF3E0;
  color: #E65100;
}

.pill--admin {
  background: #E3F2FD;
  color: #1565C0;
}

.status-tag {
  font-size: 20rpx;
  font-weight: 500;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
}

.tag--active { background: #E8F5E9; color: #2E7D32; }
.tag--disabled { background: #FFEBEE; color: #C62828; }

.admin-phone {
  font-size: 24rpx;
  color: #8E8E93;
}

/* 权限组展示 */
.groups-section {
  background: #F8F8FA;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}

.section-label {
  display: block;
  font-size: 22rpx;
  color: #8E8E93;
  margin-bottom: 12rpx;
}

.groups-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.group-chip {
  background: #FFFFFF;
  border: 1rpx solid #E5E5EA;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #3A3A3C;
  padding: 6rpx 16rpx;
}

.chip--super {
  background: #FFF8E1;
  border-color: #FFE082;
  color: #F57F17;
  font-weight: 600;
}

.chip--none {
  color: #AEAEB2;
  border-style: dashed;
}

/* 操作药丸按钮 */
.card-action-bar {
  display: flex;
  gap: 16rpx;
  border-top: 1rpx solid #F2F2F7;
  padding-top: 20rpx;
}

.action-pill {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.pill--edit { background: #EBF3FB; color: #007AFF; }
.pill--pwd { background: #F2F2F7; color: #3A3A3C; }
.pill--del { background: #FFF0F0; color: #FF382E; }

/* 权限组选择项卡片 */
.group-select-grid {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 10rpx;
}

.group-select-item {
  background: #F2F2F7;
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  transition: all 0.2s ease;
}

.group-select-item--active {
  background: #F0F7FF;
  border-color: #007AFF;
}

.item-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 4rpx;
}

.item-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1D1D1F;
}

.item-check {
  font-size: 28rpx;
  font-weight: 700;
  color: #007AFF;
}

.item-desc {
  font-size: 22rpx;
  color: #8E8E93;
  line-height: 1.4;
}

/* 弹窗通用 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65) !important;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99999 !important;
  padding: 40rpx;
  box-sizing: border-box;
}

.modal-body {
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  background: #FFFFFF !important;
  background-color: #FFFFFF !important;
  opacity: 1 !important;
  border-radius: 36rpx;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.35) !important;
  position: relative;
  z-index: 100000 !important;
  transform: translateZ(0);
  -webkit-transform: translateZ(0);
  isolation: isolate;
  -webkit-overflow-scrolling: touch;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1D1D1F;
}

.modal-close {
  font-size: 32rpx;
  color: #8E8E93;
  padding: 8rpx;
}

.modal-sub {
  display: block;
  font-size: 24rpx;
  color: #8E8E93;
  line-height: 1.4;
  margin-bottom: 24rpx;
}

.modal-form {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.m-field {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.m-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #3A3A3C;
}

.req {
  color: #FF382E;
}

.m-input {
  height: 80rpx;
  background: #F2F2F7;
  border-radius: 16rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #1D1D1F;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}

.m-btn-cancel {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  background: #F2F2F7;
  color: #3A3A3C;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 42rpx;
}

.m-btn-confirm {
  flex: 2;
  height: 84rpx;
  line-height: 84rpx;
  background: #C84B31;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 42rpx;
}

.ios-empty-view {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  text-align: center;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #8E8E93;
}

.ios-touch-active:active {
  opacity: 0.78;
}
