/* ========================================================
   Login Page — 现代多身份登录页
   ======================================================== */

.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF1EE 0%, #F5F6F8 35%, #F5F6F8 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx 60rpx;
  box-sizing: border-box;
}

/* ── 品牌头图区 ── */
.brand-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 50rpx;
}

.brand-logo-box {
  width: 140rpx;
  height: 140rpx;
  background: linear-gradient(135deg, #E54D42, #FF7043);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(229, 77, 66, 0.35);
  margin-bottom: 24rpx;
}

.brand-logo-icon {
  font-size: 72rpx;
}

.brand-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #1A1A1A;
  letter-spacing: 2rpx;
  margin-bottom: 10rpx;
}

.brand-sub {
  font-size: 26rpx;
  color: #888888;
  letter-spacing: 1rpx;
}

/* ── 登录卡片 ── */
.login-card {
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 8rpx 36rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

/* 身份切换器 */
.tab-switcher {
  display: flex;
  background: #F4F5F7;
  border-radius: 20rpx;
  padding: 6rpx;
  margin-bottom: 36rpx;
}

.tab-btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.tab-btn--active {
  background: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.tab-btn-txt {
  font-size: 26rpx;
  color: #666666;
  font-weight: 500;
}

.tab-btn--active .tab-btn-txt {
  color: #E54D42;
  font-weight: 700;
}

/* 错误提示 */
.error-strip {
  display: flex;
  align-items: center;
  background: #FFF3F0;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
  gap: 10rpx;
}

.error-strip-icon {
  font-size: 28rpx;
}

.error-strip-txt {
  font-size: 24rpx;
  color: #E54D42;
}

/* 保障标签 */
.feature-badges {
  display: flex;
  justify-content: space-between;
  margin-bottom: 40rpx;
  padding: 0 10rpx;
}

.badge-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.badge-check {
  font-size: 22rpx;
  color: #2BA245;
  font-weight: 800;
}

.badge-text {
  font-size: 22rpx;
  color: #666666;
}

/* 微信登录按钮 */
.wechat-login-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #07C160, #0ab85b);
  border-radius: 48rpx;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.35);
  margin-bottom: 30rpx;
}

.wx-icon {
  font-size: 36rpx;
}

.wx-btn-txt {
  font-size: 32rpx;
  font-weight: 700;
}

/* 服务端模式 */
.staff-header-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  margin-bottom: 32rpx;
}

.staff-hint-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.staff-hint-sub {
  font-size: 22rpx;
  color: #999999;
}

.input-group {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.input-item {
  display: flex;
  align-items: center;
  background: #F8F9FA;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  gap: 16rpx;
}

.input-icon {
  font-size: 32rpx;
}

.field-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.staff-login-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #E54D42, #FF7043);
  border-radius: 48rpx;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(229, 77, 66, 0.35);
  margin-bottom: 30rpx;
}

.btn--loading {
  opacity: 0.7;
}

/* 协议行 */
.agreement-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.agree-box {
  width: 32rpx;
  height: 32rpx;
  border-radius: 6rpx;
  border: 2rpx solid #CCCCCC;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #FFFFFF;
  flex-shrink: 0;
}

.agree-box--checked {
  background: #E54D42;
  border-color: #E54D42;
}

.agreement-text {
  font-size: 22rpx;
  color: #888888;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.link {
  color: #E54D42;
  display: inline;
}

/* 底部倡议 */
.footer-note {
  margin-top: auto;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  color: #AAAAAA;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
}

.shield-icon {
  font-size: 26rpx;
}

/* ── 快速体验通道 (用户端) ── */
.quick-persona-box {
  margin-top: 36rpx;
  padding-top: 28rpx;
  border-top: 1rpx dashed #EEEEEE;
}

.quick-persona-title {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.quick-persona-line {
  width: 60rpx;
  height: 2rpx;
  background: #E8E8E8;
}

.quick-persona-label {
  font-size: 22rpx;
  color: #999999;
}

.quick-persona-btn {
  display: flex;
  align-items: center;
  background: #FFF8F6;
  border: 1rpx solid #FFDDD7;
  border-radius: 18rpx;
  padding: 18rpx 24rpx;
  gap: 18rpx;
}

.quick-persona-icon {
  font-size: 38rpx;
}

.quick-persona-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.quick-persona-main {
  font-size: 26rpx;
  font-weight: 700;
  color: #E54D42;
}

.quick-persona-desc {
  font-size: 20rpx;
  color: #999999;
}

.quick-persona-arrow {
  font-size: 32rpx;
  color: #FF7043;
}

/* ── 服务端直通车网格 ── */
.staff-quick-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 30rpx;
}

.staff-quick-card {
  flex: 1;
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.04);
}

.staff-quick-card--tech {
  background: linear-gradient(135deg, #FFF9F2 0%, #FFF0E0 100%);
  border: 1rpx solid #FFE0B2;
}

.staff-quick-card--boss {
  background: linear-gradient(135deg, #F5F7FF 0%, #E8EDFF 100%);
  border: 1rpx solid #D0DCFF;
}

.staff-quick-icon {
  font-size: 40rpx;
  margin-bottom: 4rpx;
}

.staff-quick-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #222222;
}

.staff-quick-sub {
  font-size: 20rpx;
  color: #888888;
}

/* ── 底部网络环境切换条 ── */
.env-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(0, 0, 0, 0.05);
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  margin-top: 30rpx;
}

.env-bar-icon {
  font-size: 24rpx;
}

.env-bar-txt {
  font-size: 22rpx;
  color: #666666;
  max-width: 480rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.env-bar-btn {
  font-size: 22rpx;
  color: #E54D42;
  font-weight: 700;
}

/* ── 环境配置弹窗 ── */
.env-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.env-modal-card {
  width: 100%;
  max-width: 650rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 36rpx;
  box-sizing: border-box;
}

.env-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.env-modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.env-modal-close {
  font-size: 36rpx;
  color: #999999;
  padding: 8rpx;
}

.env-modal-desc {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

.env-tag {
  color: #E54D42;
  font-weight: 700;
}

.env-modal-tip {
  display: block;
  font-size: 20rpx;
  color: #FF7043;
  margin-top: 8rpx;
}

.env-presets-label {
  font-size: 22rpx;
  color: #888888;
  margin-bottom: 12rpx;
}

.env-presets-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.env-preset-chip {
  padding: 16rpx 20rpx;
  background: #F8F9FA;
  border: 2rpx solid #EFEFEF;
  border-radius: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.env-preset-chip--active {
  background: #FFF5F4;
  border-color: #E54D42;
}

.preset-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #333333;
}

.preset-url {
  font-size: 20rpx;
  color: #888888;
}

.env-input-box {
  background: #F4F5F7;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 28rpx;
}

.env-input {
  font-size: 26rpx;
  color: #222222;
}

.env-modal-actions {
  display: flex;
  gap: 20rpx;
}

.env-action-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.env-action-btn--reset {
  background: #F0F2F5;
  color: #666666;
}

.env-action-btn--save {
  background: linear-gradient(135deg, #E54D42, #FF7043);
  color: #FFFFFF;
  box-shadow: 0 6rpx 18rpx rgba(229, 77, 66, 0.3);
}

