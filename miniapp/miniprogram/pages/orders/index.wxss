.page {
  padding-bottom: 140rpx;
}

.tabs {
  display: flex;
  gap: 0;
  margin-bottom: 24rpx;
  background: var(--color-surface);
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid var(--color-border);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  transition: all 0.2s;
}

.tab--active {
  background: var(--color-primary);
  color: #FFFFFF;
  font-weight: 600;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 32rpx;
}

.empty-state__icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-state__title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.empty-state__desc {
  font-size: 26rpx;
  color: var(--color-muted);
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.order-card {
  padding: 24rpx;
}

.order-card__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-card__no {
  font-size: 24rpx;
  color: var(--color-muted);
}

.order-card__status {
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
}

.order-card__body {
  margin-bottom: 16rpx;
}

.order-card__project {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.order-card__info {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.order-card__people {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
  display: flex;
  gap: 24rpx;
}

.order-card__footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-border);
}

.order-card__amount {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.order-card__time {
  font-size: 22rpx;
  color: var(--color-muted);
}
