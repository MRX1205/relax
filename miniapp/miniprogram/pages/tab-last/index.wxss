.ios-orders-page {
  min-height: 100vh;
  background-color: var(--ios-bg);
  padding: 32rpx 32rpx 30rpx;
  box-sizing: border-box;
}

.page-title-bar {
  margin-bottom: 28rpx;
}

.page-main-title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--ios-text-primary);
  display: block;
  letter-spacing: -0.5rpx;
}

.page-sub-title {
  font-size: 24rpx;
  color: var(--ios-text-tertiary);
  margin-top: 4rpx;
  display: block;
}

/* ════ 骨架屏 ════ */
.loading-feed {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.skeleton-card {
  height: 260rpx;
  border-radius: var(--radius-lg);
}

/* ════ 空状态 ════ */
.ios-empty-view {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 40rpx;
}

.empty-icon-circle {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  background: #EBEBF0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.empty-svg {
  width: 60rpx;
  height: 60rpx;
}

.empty-primary {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ios-text-primary);
  margin-bottom: 8rpx;
}

.empty-secondary {
  font-size: 24rpx;
  color: var(--ios-text-tertiary);
  text-align: center;
}

/* ════ 订单票据卡片 ════ */
.orders-feed {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.order-ticket-card {
  padding: 28rpx 32rpx;
  background: var(--ios-card);
}

.ticket-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid var(--ios-border);
  margin-bottom: 20rpx;
}

.ticket-no {
  font-size: 22rpx;
  color: var(--ios-text-tertiary);
}

.ticket-status-pill {
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-full);
}

.pill-active {
  background: rgba(0, 122, 255, 0.08);
  color: #007AFF;
}

.pill-done {
  background: rgba(52, 199, 89, 0.1);
  color: #34C759;
}

.pill-cancel {
  background: #EBEBF0;
  color: #8E8E93;
}

.ticket-body {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.ticket-proj-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ios-text-primary);
  letter-spacing: -0.5rpx;
  margin-bottom: 4rpx;
}

.ticket-meta-line {
  display: flex;
  align-items: center;
  font-size: 24rpx;
}

.meta-label {
  color: var(--ios-text-tertiary);
  width: 80rpx;
}

.meta-val {
  color: var(--ios-text-secondary);
  flex: 1;
}

.ellipsis {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.ticket-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--ios-border);
}

.ticket-price-box {
  display: flex;
  align-items: baseline;
}

.price-lbl {
  font-size: 22rpx;
  color: var(--ios-text-tertiary);
}

.price-curr {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--ios-red);
}

.price-val {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--ios-red);
  letter-spacing: -0.5rpx;
}

.ticket-detail-link {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--ios-text-secondary);
}

.chev {
  font-size: 32rpx;
  margin-left: 4rpx;
  line-height: 1;
}
