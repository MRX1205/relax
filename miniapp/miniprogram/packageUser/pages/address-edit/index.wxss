.page {
  padding: 24rpx 28rpx 60rpx;
  background-color: var(--ios-bg);
  min-height: 100vh;
  box-sizing: border-box;
}

.form {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.form-card {
  padding: 10rpx 28rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.form-row {
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.form-row:last-child {
  border-bottom: none;
}

.form-row--vertical {
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1C1E;
  min-width: 160rpx;
  flex-shrink: 0;
}

.required-star {
  color: #FF382E;
  margin-right: 4rpx;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #1C1C1E;
  width: 100%;
}

.picker-trigger, .location-trigger {
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex: 1;
}

.picker-val {
  color: #1C1C1E;
  font-weight: 600;
}

.placeholder-text {
  color: #8E8E93;
}

.loc-val {
  color: #007AFF;
  font-weight: 600;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
}

.submit-wrap {
  margin-top: 24rpx;
  padding: 0 4rpx;
}

.save-submit-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #FF5A36 0%, #FF382E 100%);
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(255, 56, 46, 0.35);
}

.btn--disabled {
  opacity: 0.6;
}
