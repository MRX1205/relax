.tabs {
  display: flex;
  gap: 0;
  margin-bottom: 24rpx;
  background: var(--color-surface);
  border-radius: var(--radius-md);
  overflow: hidden;
  border: 1rpx solid var(--color-border);
}
.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  position: relative;
}
.tab--active {
  background: var(--color-primary);
  color: #FFFFFF;
}
.tab-badge {
  position: absolute;
  top: 8rpx;
  right: 20%;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  background: var(--color-danger);
  color: #FFFFFF;
  border-radius: 16rpx;
  font-size: 20rpx;
  padding: 0 8rpx;
}
.tech-item, .app-item {
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.tech-name, .app-name {
  font-size: 30rpx;
  font-weight: 600;
}
.tech-meta, .app-meta {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}
.tech-badges {
  display: flex;
  gap: 12rpx;
  margin-top: 8rpx;
}
.badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}
.badge--ACTIVE { background: #EDF8F3; color: var(--color-success); }
.badge--DISABLED, .badge--SUSPENDED { background: #F6F7F9; color: var(--color-muted); }
.badge--ONLINE { background: #EDF8F3; color: var(--color-success); }
.badge--OFFLINE { background: #F6F7F9; color: var(--color-muted); }
.tech-actions, .app-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-border);
}
.action-link {
  font-size: 24rpx;
  color: var(--color-primary);
}
.app-intro {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
  line-height: 1.5;
}
.app-actions {
  justify-content: flex-end;
}
.action-btn {
  padding: 12rpx 24rpx;
  border-radius: var(--radius-sm);
  font-size: 24rpx;
  font-weight: 600;
}
.action-btn--approve {
  background: var(--color-accent);
  color: #FFFFFF;
}
.action-btn--reject {
  background: #F6F7F9;
  color: var(--color-danger);
  border: 1rpx solid var(--color-border);
}
.empty-tip { text-align: center; color: var(--color-muted); padding: 48rpx; }
.dialog-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.dialog {
  width: 80%;
  background: var(--color-surface);
  border-radius: var(--radius-md);
  padding: 32rpx;
}
.dialog-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}
.reject-input {
  width: 100%;
  height: 200rpx;
  padding: 16rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  box-sizing: border-box;
}
.dialog-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
