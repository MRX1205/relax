.page {
  background: #F8F9FA;
  min-height: 100vh;
  padding-bottom: 60rpx;
}

.invite-banner {
  background: linear-gradient(135deg, #FF6B4A, #E54D42);
  padding: 50rpx 40rpx 70rpx;
  color: #FFFFFF;
  text-align: center;
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
}

.banner-badge {
  display: inline-block;
  background: rgba(255, 255, 255, 0.2);
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  font-weight: 600;
}

.banner-title {
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.banner-subtitle {
  font-size: 24rpx;
  opacity: 0.9;
}

.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: -30rpx 28rpx 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.05);
}

.code-box {
  background: #FFF8F6;
  border: 1rpx dashed #FFAB91;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  margin-bottom: 28rpx;
}

.code-label {
  font-size: 24rpx;
  color: #888888;
  margin-bottom: 8rpx;
}

.code-val-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.code-val {
  font-size: 44rpx;
  font-weight: 800;
  color: #E54D42;
  letter-spacing: 4rpx;
}

.copy-btn {
  font-size: 22rpx;
  color: #E54D42;
  background: #FFEBE6;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.share-btn {
  background: linear-gradient(135deg, #25D366, #128C7E);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 6rpx 16rpx rgba(37, 211, 102, 0.3);
}

.share-icon {
  font-size: 36rpx;
}

.earnings-card {
  margin: 0 28rpx 24rpx;
}

.card-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #222222;
}

.withdraw-link {
  font-size: 24rpx;
  color: #E54D42;
  font-weight: 600;
}

.stats-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 12rpx 0;
}

.stat-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 800;
  color: #222222;
}

.color-red {
  color: #E54D42;
}

.stat-lbl {
  font-size: 22rpx;
  color: #888888;
}

.stat-line {
  width: 1rpx;
  height: 50rpx;
  background: #EEEEEE;
}

.rules-card {
  margin: 0 28rpx 24rpx;
}

.rule-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 20rpx;
}

.rule-dot {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 18rpx;
  background: #FFF0EB;
  color: #E54D42;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.rule-text {
  font-size: 24rpx;
  color: #555555;
  line-height: 1.6;
}

.highlight {
  color: #E54D42;
  font-weight: 700;
}

/* Modal */
.modal-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 40rpx;
  box-sizing: border-box;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1;
}

.modal-content {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 600rpx;
  background: #FFFFFF !important;
  border-radius: 28rpx;
  padding: 32rpx;
  box-sizing: border-box;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #222222;
}

.modal-close {
  font-size: 36rpx;
  color: #999999;
}

.avail-tip {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 20rpx;
}

.input-wrap {
  display: flex;
  align-items: center;
  background: #F8F9FA;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}

.currency-tag {
  font-size: 36rpx;
  font-weight: 700;
  color: #222222;
  margin-right: 12rpx;
}

.amt-input {
  font-size: 36rpx;
  font-weight: 700;
  flex: 1;
}

.modal-hint {
  font-size: 22rpx;
  color: #999999;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.m-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.btn-sec {
  background: #F0F0F0;
  color: #666666;
}

.btn-pri {
  background: linear-gradient(135deg, #FF6B4A, #E54D42);
  color: #FFFFFF;
}
