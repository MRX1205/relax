.ios-admin-tech-page {
  min-height: 100vh;
  background-color: #F2F2F7;
  padding: 24rpx;
  box-sizing: border-box;
  padding-bottom: 80rpx;
}

/* 顶部操作头 */
.header-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx 28rpx 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.header-main-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.header-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1D1D1F;
}

.header-desc {
  display: block;
  font-size: 22rpx;
  color: #8E8E93;
  margin-top: 4rpx;
}

.add-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #C84B31;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  padding: 14rpx 24rpx;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(200, 75, 49, 0.3);
}

.add-plus {
  font-size: 32rpx;
  line-height: 1;
}

/* 分段选项卡 */
.segmented-tabs {
  display: flex;
  background: #E5E5EA;
  padding: 6rpx;
  border-radius: 20rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 0;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #8E8E93;
  position: relative;
  transition: all 0.2s ease;
}

.tab-item--active {
  background: #FFFFFF;
  color: #1D1D1F;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.tab-badge {
  position: absolute;
  right: 28rpx;
  top: 10rpx;
  background: #FF382E;
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: 14rpx;
}

/* 技师卡片列表 */
.tech-list-feed, .app-list-feed {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.tech-card, .app-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.card-head-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.tech-avatar-circle {
  width: 92rpx;
  height: 92rpx;
  background: linear-gradient(135deg, #FF9500 0%, #C84B31 100%);
  border-radius: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  flex-shrink: 0;
}

.tech-head-info {
  flex: 1;
}

.name-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.service-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1D1D1F;
}

.pill-badge {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.pill-status--ACTIVE { background: #E8F5E9; color: #2E7D32; }
.pill-status--DISABLED { background: #FFEBEE; color: #C62828; }
.pill-online--ONLINE { background: #E3F2FD; color: #1565C0; }
.pill-online--OFFLINE { background: #F5F5F5; color: #757575; }

.meta-line {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #8E8E93;
}

.phone-link {
  color: #007AFF;
}

/* 操作药丸按钮 */
.card-action-bar {
  display: flex;
  gap: 16rpx;
  border-top: 1rpx solid #F2F2F7;
  padding-top: 20rpx;
}

.action-pill {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.pill--toggle { background: #F2F2F7; color: #3A3A3C; }
.pill--pwd { background: #EBF3FB; color: #007AFF; }
.pill--pricing { background: #FFF4E5; color: #E65100; }
.pill--del { background: #FFF0F0; color: #FF382E; }

/* 待审核卡片 */
.app-head-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.app-name-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.app-service-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1D1D1F;
}

.app-exp-pill {
  background: #E8F5E9;
  color: #2E7D32;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 10rpx;
  border-radius: 10rpx;
}

.app-phone-link {
  font-size: 24rpx;
  color: #007AFF;
}

.app-time {
  font-size: 22rpx;
  color: #C7C7CC;
}

.app-intro-box {
  background: #F8F8FA;
  border-radius: 14rpx;
  padding: 16rpx;
  font-size: 24rpx;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.intro-label {
  color: #8E8E93;
}

.intro-content {
  color: #3A3A3C;
}

.area-tag-box {
  font-size: 22rpx;
  color: #8E8E93;
  margin-bottom: 20rpx;
}

.area-val {
  color: #3A3A3C;
}

.app-actions-row {
  display: flex;
  gap: 20rpx;
}

.reject-cta {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  background: #FFEBEE;
  color: #FF382E;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 36rpx;
}

.approve-cta {
  flex: 2;
  height: 72rpx;
  line-height: 72rpx;
  background: #C84B31;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 36rpx;
}

/* 弹窗通用样式 */
.modal-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100000 !important;
  padding: 40rpx;
  box-sizing: border-box;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65) !important;
  z-index: 1;
}

.modal-body {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 680rpx;
  background: #FFFFFF !important;
  background-color: #FFFFFF !important;
  opacity: 1 !important;
  border-radius: 36rpx;
  padding: 36rpx 32rpx;
  box-sizing: border-box;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.35) !important;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1D1D1F;
}

.modal-close {
  font-size: 32rpx;
  color: #8E8E93;
  padding: 8rpx;
}

.modal-sub {
  display: block;
  font-size: 24rpx;
  color: #8E8E93;
  line-height: 1.4;
  margin-bottom: 24rpx;
}

.modal-form {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.m-field {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.m-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #3A3A3C;
}

.req {
  color: #FF382E;
}

.m-input {
  height: 80rpx;
  background: #F2F2F7;
  border-radius: 16rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #1D1D1F;
}

.m-textarea {
  width: 100%;
  height: 160rpx;
  background: #F2F2F7;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: #1D1D1F;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}

.m-btn-cancel {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  background: #F2F2F7;
  color: #3A3A3C;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 42rpx;
}

.m-btn-confirm {
  flex: 2;
  height: 84rpx;
  line-height: 84rpx;
  background: #C84B31;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 42rpx;
}

.m-btn-reject {
  flex: 2;
  height: 84rpx;
  line-height: 84rpx;
  background: #FF382E;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 42rpx;
}

/* 空状态 */
.ios-empty-view {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  text-align: center;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 8rpx;
}

/* 搜索栏 */
.search-box {
  display: flex;
  align-items: center;
  background: #F2F2F7;
  border-radius: 20rpx;
  padding: 14rpx 20rpx;
  margin-bottom: 20rpx;
}

.search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
  color: #8E8E93;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #1C1C1E;
}

.clear-icon {
  font-size: 26rpx;
  color: #8E8E93;
  padding: 0 10rpx;
}

/* 技师详情弹窗 */
.tech-detail-modal {
  max-height: 85vh;
}

.modal-title-col {
  display: flex;
  flex-direction: column;
}

.tech-profile-hero {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: #F9F9FB;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}

.hero-avatar-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1C1C1E, #3A3A3C);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.hero-avatar-txt {
  font-size: 42rpx;
  font-weight: 800;
}

.hero-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.hero-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-tech-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #1C1C1E;
}

.hero-tech-real {
  font-size: 24rpx;
  color: #636366;
}

.hero-tech-phone {
  font-size: 24rpx;
  color: #007AFF;
}

.hero-tech-id {
  font-size: 20rpx;
  color: #8E8E93;
}

.m-section {
  margin-bottom: 24rpx;
}

.m-section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.m-section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1C1C1E;
}

.m-link {
  font-size: 24rpx;
  color: #007AFF;
  font-weight: 600;
}

.pricing-loading, .pricing-empty {
  padding: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: #8E8E93;
  background: #F9F9FB;
  border-radius: 14rpx;
}

.pricing-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}

.pricing-item-pill {
  padding: 14rpx 18rpx;
  background: #F9F9FB;
  border-radius: 14rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.pi-name {
  font-size: 24rpx;
  color: #1C1C1E;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 65%;
}

.pi-price {
  font-size: 26rpx;
  font-weight: 800;
  color: #FF382E;
}

.modal-footer-dual {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.m-btn-action {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 20rpx;
  border: none;
}

.btn--reset-pwd {
  background: rgba(255, 149, 0, 0.15);
  color: #D97706;
}

.btn--toggle-disable {
  background: #FFF1EE;
  color: #FF382E;
}

.btn--toggle-enable {
  background: rgba(52, 199, 89, 0.15);
  color: #248A3D;
}

.ios-touch-active:active {
  opacity: 0.78;
}
