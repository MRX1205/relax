<view class="page">
  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab {{currentTab === item.key ? 'tab--active' : ''}}"
      data-tab="{{item.key}}"
      bindtap="switchTab"
    >
      {{item.text}}
    </view>
  </view>

  <ui-state wx:if="{{loading}}" title="加载中" kind="loading" />

  <block wx:elif="{{filteredOrders.length === 0}}">
    <view class="empty-state">
      <view class="empty-state__icon">📋</view>
      <view class="empty-state__title">暂无订单</view>
      <view class="empty-state__desc">去预约一个服务吧</view>
    </view>
  </block>

  <block wx:else>
    <view class="order-list">
      <view
        wx:for="{{filteredOrders}}"
        wx:key="id"
        class="order-card surface"
        data-order-no="{{item.orderNo}}"
        bindtap="goToDetail"
      >
        <view class="order-card__header">
          <text class="order-card__no">{{item.orderNo}}</text>
          <text class="order-card__status" style="color: {{getStatusColor(item.status)}}; background: {{getStatusColor(item.status)}}15;">
            {{getStatusText(item.status)}}
          </text>
        </view>
        <view class="order-card__body">
          <view class="order-card__project">{{item.projectName}}</view>
          <view class="order-card__info">
            <text>{{item.serviceDate}} {{item.startTime}}-{{item.endTime}}</text>
          </view>
          <view class="order-card__people" wx:if="{{item.technicianName || item.userName}}">
            <text wx:if="{{item.technicianName}}">技师: {{item.technicianName}}</text>
            <text wx:if="{{item.userName}}">用户: {{item.userName}}</text>
          </view>
        </view>
        <view class="order-card__footer">
          <text class="order-card__amount">¥{{item.amount}}</text>
          <text class="order-card__time">{{item.createdAt}}</text>
        </view>
      </view>
    </view>
  </block>
</view>

<custom-tabbar />
