/* ==========================================================================
   Role Login — Apple HIG Modern Aesthetics
   ========================================================================== */

.role-login-page {
  min-height: 100vh;
  background-color: #F5F5F7;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* ── 顶部沉浸头部 ── */
.header-hero {
  padding: calc(env(safe-area-inset-top) + 60rpx) 40rpx 80rpx;
  position: relative;
  overflow: hidden;
}

.theme-tech .header-hero {
  background: linear-gradient(135deg, #1C1C1E 0%, #243B2C 100%);
}

.theme-admin .header-hero {
  background: linear-gradient(135deg, #1C1C1E 0%, #2A2C35 100%);
}

.header-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.role-badge-icon {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.12);
  -webkit-backdrop-filter: blur(15px);
  backdrop-filter: blur(15px);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.role-title {
  font-size: 42rpx;
  font-weight: 800;
  color: #FFFFFF;
  margin-bottom: 12rpx;
  letter-spacing: -0.6rpx;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display";
}

.role-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.45;
  max-width: 540rpx;
}

/* ── 登录卡片 ── */
.login-card {
  margin: -40rpx 28rpx 0;
  padding: 36rpx 32rpx 44rpx;
  position: relative;
  z-index: 2;
}

/* ── Apple Segmented Control ── */
.login-tabs {
  display: flex;
  background: #E5E5EA;
  border-radius: 18rpx;
  padding: 6rpx;
  margin-bottom: 36rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 14rpx;
  transition: all 0.2s cubic-bezier(0.25, 0.1, 0.25, 1);
}

.tab-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #636366;
}

.tab-item--active {
  background: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.tab-item--active .tab-text {
  color: #1C1C1E;
  font-weight: 700;
}

/* ── 错误提示条 ── */
.error-tip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #FFF1EE;
  border: 1rpx solid rgba(255, 56, 46, 0.2);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 28rpx;
}

.error-text {
  font-size: 24rpx;
  color: #FF382E;
  line-height: 1.4;
}

/* ── 表单输入 ── */
.form-wrap {
  display: flex;
  flex-direction: column;
}

.input-row {
  display: flex;
  align-items: center;
  background: #F2F2F7;
  border: 1rpx solid transparent;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 24rpx;
  transition: border-color 0.2s;
}

.input-icon-box {
  display: flex;
  align-items: center;
  margin-right: 18rpx;
}

.input-field {
  flex: 1;
  font-size: 28rpx;
  color: #1C1C1E;
}

.clear-icon {
  font-size: 24rpx;
  color: #8E8E93;
  padding: 8rpx;
}

.eye-icon {
  display: flex;
  align-items: center;
  padding: 8rpx;
}

/* 快捷填充 */
.quick-fill-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 36rpx;
}

.quick-label {
  font-size: 22rpx;
  color: #8E8E93;
}

.quick-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  font-size: 22rpx;
  background: rgba(0, 122, 255, 0.08);
  color: #007AFF;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 46rpx;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  border: none;
  background: #1C1C1E;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.2);
}

.theme-tech .submit-btn {
  background: linear-gradient(135deg, #34C759 0%, #28A745 100%);
  box-shadow: 0 8rpx 24rpx rgba(52, 199, 89, 0.35);
}

.theme-admin .submit-btn {
  background: linear-gradient(135deg, #1C1C1E 0%, #3A3A3C 100%);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.25);
}

.btn--loading {
  opacity: 0.6;
}

/* 微信快捷登录板块 */
.wechat-login-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 10rpx;
}

.wx-hero-badge {
  width: 116rpx;
  height: 116rpx;
  background: rgba(7, 193, 96, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.wx-hint-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1C1C1E;
  margin-bottom: 10rpx;
}

.wx-hint-desc {
  font-size: 24rpx;
  color: #8E8E93;
  text-align: center;
  line-height: 1.5;
  margin-bottom: 40rpx;
  max-width: 500rpx;
}

.wx-submit-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  background: #07C160;
  color: #FFFFFF;
  border-radius: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.35);
  margin-bottom: 32rpx;
}

.wx-btn-label {
  font-size: 30rpx;
  font-weight: 700;
}

.wx-notice-box {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  background: #F2F2F7;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  width: 100%;
  box-sizing: border-box;
}

.wx-notice-icon {
  margin-top: 2rpx;
}

.notice-text {
  font-size: 22rpx;
  color: #636366;
  line-height: 1.5;
}

/* 底部返回操作 */
.footer-actions {
  margin-top: auto;
  padding: 60rpx 0;
  display: flex;
  justify-content: center;
}

.return-home-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #636366;
  padding: 16rpx 36rpx;
  border-radius: 40rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.05);
}
