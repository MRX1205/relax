<view class="page">
  <view class="page-title">绑定手机号</view>
  <view class="page-subtitle">手机号仅用于订单联系和技师到达通知，不会公开显示。</view>

  <view class="phone-card surface">
    <view wx:if="{{error}}" class="error-banner">{{error}}</view>
    <button
      class="phone-btn"
      open-type="getPhoneNumber"
      bindgetphonenumber="handleGetPhoneNumber"
      loading="{{loading}}"
    >
      微信授权手机号
    </button>
    <view class="skip" bindtap="handleSkip">暂时跳过，稍后绑定</view>
  </view>
</view>
