.page {
  padding: 24rpx 28rpx 180rpx 28rpx;
  background: #F8F9FA;
  min-height: 100vh;
  box-sizing: border-box;
}

/* Hero card */
.hero-card {
  background: linear-gradient(135deg, #1A1A1A 0%, #2D3139 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  color: #FFFFFF;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.hero-title-box {
  flex: 1;
  padding-right: 20rpx;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 8rpx;
  letter-spacing: -0.5rpx;
}

.hero-desc {
  font-size: 24rpx;
  color: #AEB5C0;
  line-height: 1.4;
  display: block;
}

.stat-pill {
  background: rgba(255, 255, 255, 0.12);
  border-radius: 32rpx;
  padding: 8rpx 24rpx;
  display: flex;
  align-items: baseline;
  backdrop-filter: blur(10px);
}

.stat-num {
  font-size: 36rpx;
  font-weight: 800;
  color: #07C160;
}

.stat-total {
  font-size: 24rpx;
  color: #AEB5C0;
  margin-left: 2rpx;
}

.hero-footer {
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  padding-top: 16rpx;
}

.hero-tip {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.tip-icon {
  font-size: 24rpx;
}

.tip-text {
  font-size: 22rpx;
  color: #E2E8F0;
}

/* Zone filter tabs */
.zone-tabs {
  display: flex;
  white-space: nowrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding-bottom: 4rpx;
}

.zone-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 28rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  border: 2rpx solid #EBECEF;
  transition: all 0.2s ease;
}

.zone-tab--active {
  background: #1A1A1A;
  border-color: #1A1A1A;
}

.zone-tab-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #666666;
}

.zone-tab--active .zone-tab-text {
  color: #FFFFFF;
  font-weight: 600;
}

/* Batch actions bar */
.batch-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

.batch-info {
  font-size: 24rpx;
  color: #8E8E93;
}

.batch-btns {
  display: flex;
  gap: 16rpx;
}

.batch-btn {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.batch-btn--open {
  background: rgba(7, 193, 96, 0.1);
  color: #07C160;
}

.batch-btn--close {
  background: rgba(142, 142, 147, 0.12);
  color: #666666;
}

/* Area cards grid */
.area-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.area-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 2rpx solid #EAEAEA;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.02);
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.area-card--selected {
  border-color: #07C160;
  background: #F7FCF9;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.08);
}

.card-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.check-box {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid #D1D1D6;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  background: #FFFFFF;
}

.check-box--active {
  background: #07C160;
  border-color: #07C160;
}

.check-mark {
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}

.card-content {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.card-badges {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.zone-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  background: #F0F2F5;
  color: #555555;
  font-weight: 500;
}

.status-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.status-badge--on {
  background: rgba(7, 193, 96, 0.1);
  color: #07C160;
}

.status-badge--off {
  background: #F2F2F7;
  color: #8E8E93;
}

.card-status-text {
  font-size: 24rpx;
  font-weight: 600;
}

.status-active {
  color: #07C160;
}

.status-inactive {
  color: #C7C7CC;
}

.empty-box {
  padding: 80rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.empty-icon {
  font-size: 60rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #8E8E93;
}

/* Bottom bar */
.save-bar-wrapper {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  border-top: 1rpx solid #EAEAEA;
  z-index: 100;
}

.save-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #1A1A1A;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  border: none;
}

.save-btn[disabled] {
  opacity: 0.6;
}
